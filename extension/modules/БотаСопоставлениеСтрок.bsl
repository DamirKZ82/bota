///////////////////////////////////////////////////////////////////////////////
// БотаСопоставлениеСтрок: построчное сравнение поступления и ЭСФ (ТЗ п. 4.3).
//
// Пять уровней сопоставления по убыванию надёжности — от явного соответствия
// номенклатуры до нечёткого совпадения наименований. Каждый уровень проходит
// по строкам, оставшимся несопоставленными после предыдущего: жадный алгоритм
// здесь уместен, потому что уровни упорядочены по достоверности.
//
// Модуль намеренно не знает про регистры: справочник соответствий приходит
// параметром. Так его можно проверять отдельно, на выдуманных строках.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Сопоставляет строки поступления и ЭСФ.
//
// Параметры:
//  СтрокиПоступления - Массив из Структура - см. БотаМетаданныеТиповой.СтрокиДокумента
//  СтрокиЭСФ         - Массив из Структура - то же для ЭСФ
//  Соответствия      - Соответствие - нормализованное наименование → номенклатура;
//                      уровень 1, справочник соответствий контрагента
//  Допуски           - Структура - ДопускНаЕдиницу, ПотолокСтроки
//
// Возвращаемое значение:
//  Массив из Структура:
//   * СтрокаПоступления - Структура, Неопределено
//   * СтрокиЭСФ         - Массив из Структура - несколько при разбивке по партиям
//   * Вид               - Строка - matched | matched_within_tolerance |
//                         matched_with_diff | only_in_receipt | only_in_esf |
//                         one_to_many | many_to_one
//   * Уровень           - Число, Неопределено - 1..5
//   * Уверенность       - Строка - high | medium | low
//   * Разницы           - Структура - Количество, Цена, Сумма, СуммаНДС, Всего
//
Функция Сопоставить(СтрокиПоступления, СтрокиЭСФ, Соответствия, Допуски) Экспорт

	Результат = Новый Массив;

	// Свободные строки: сопоставленные исключаются, чтобы одна строка ЭСФ
	// не попала в две пары.
	СвободныеПоступления = КопияМассива(СтрокиПоступления);
	СвободныеЭСФ = КопияМассива(СтрокиЭСФ);

	// Уровни 1–5 в порядке убывания надёжности (ТЗ п. 4.3).
	СопоставитьПоУровню(Результат, СвободныеПоступления, СвободныеЭСФ, 1, Соответствия, Допуски);
	СопоставитьПоУровню(Результат, СвободныеПоступления, СвободныеЭСФ, 2, Соответствия, Допуски);
	СопоставитьПоУровню(Результат, СвободныеПоступления, СвободныеЭСФ, 3, Соответствия, Допуски);

	// «Одна против нескольких» ищется до уровней 4 и 5: разбивка по партиям
	// встречается чаще, чем совпадение по одной лишь сумме, и объясняет строки
	// точнее.
	СопоставитьОднаКНескольким(Результат, СвободныеПоступления, СвободныеЭСФ, Допуски);

	СопоставитьПоУровню(Результат, СвободныеПоступления, СвободныеЭСФ, 4, Соответствия, Допуски);
	СопоставитьПоУровню(Результат, СвободныеПоступления, СвободныеЭСФ, 5, Соответствия, Допуски);

	// Остаток: строки, которым пары не нашлось (код D12).
	Для Каждого СтрокаПоступления Из СвободныеПоступления Цикл
		Результат.Добавить(ОдностороннееСопоставление(СтрокаПоступления, Неопределено));
	КонецЦикла;

	Для Каждого СтрокаЭСФ Из СвободныеЭСФ Цикл
		Результат.Добавить(ОдностороннееСопоставление(Неопределено, СтрокаЭСФ));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нормализованное наименование для сравнения.
//
// Приводит к виду, в котором «Бумага А4 «Снегурочка», 80 г/м2» и
// «бумага а4 снегурочка 80 г/м2» — одно и то же. Порядок слов сохраняется:
// перестановка слов меняет смысл наименования чаще, чем кажется.
//
// Параметры:
//  Наименование - Строка
//
// Возвращаемое значение:
//  Строка - нормализованное наименование.
//
Функция Нормализовать(Наименование) Экспорт

	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат "";
	КонецЕсли;

	Результат = НРег(СокрЛП(Наименование));

	// Знаки препинания и кавычки: у поставщика и в базе они почти всегда разные.
	ЛишниеСимволы = """«»„“”'`,;:()[]{}<>/\|*_+";
	Для Индекс = 1 По СтрДлина(ЛишниеСимволы) Цикл
		Результат = СтрЗаменить(Результат, Сред(ЛишниеСимволы, Индекс, 1), " ");
	КонецЦикла;

	// Дефис между цифрами значим («3х2.5»), между словами — нет.
	Результат = СтрЗаменить(Результат, " - ", " ");

	// Схлопывание пробелов.
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции

// Похожесть двух наименований, 0..1 (уровень 5).
//
// Коэффициент Дайса на биграммах, а не расстояние Левенштейна: считается
// заметно быстрее, а на наименованиях товаров даёт сопоставимый результат.
// Скорость здесь важна — сравнений может быть сотни на документ.
//
// Параметры:
//  Первое, Второе - Строка - уже нормализованные наименования.
//
// Возвращаемое значение:
//  Число - 0..1.
//
Функция Похожесть(Первое, Второе) Экспорт

	Если Первое = Второе Тогда
		Возврат ?(ПустаяСтрока(Первое), 0, 1);
	КонецЕсли;

	Если ПустаяСтрока(Первое) Или ПустаяСтрока(Второе) Тогда
		Возврат 0;
	КонецЕсли;

	// Отсечка по длине: строки, различающиеся втрое, похожими быть не могут,
	// а биграммы для них считать дорого.
	ДлинаПервого = СтрДлина(Первое);
	ДлинаВторого = СтрДлина(Второе);
	Если ДлинаПервого * 3 < ДлинаВторого Или ДлинаВторого * 3 < ДлинаПервого Тогда
		Возврат 0;
	КонецЕсли;

	БиграммыПервого = Биграммы(Первое);
	БиграммыВторого = Биграммы(Второе);

	Если БиграммыПервого.Количество() = 0 Или БиграммыВторого.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Общие = 0;
	Для Каждого Элемент Из БиграммыПервого Цикл
		Встречается = БиграммыВторого.Получить(Элемент.Ключ);
		Если Встречается <> Неопределено Тогда
			Общие = Общие + Мин(Элемент.Значение, Встречается);
		КонецЕсли;
	КонецЦикла;

	Возврат 2 * Общие / (ВсегоБиграмм(БиграммыПервого) + ВсегоБиграмм(БиграммыВторого));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проход одного уровня сопоставления.
Процедура СопоставитьПоУровню(Результат, СвободныеПоступления, СвободныеЭСФ,
	Уровень, Соответствия, Допуски)

	Индекс = 0;
	Пока Индекс < СвободныеПоступления.Количество() Цикл

		СтрокаПоступления = СвободныеПоступления[Индекс];
		ИндексЭСФ = НайтиПаруНаУровне(СтрокаПоступления, СвободныеЭСФ, Уровень,
			Соответствия, Допуски);

		Если ИндексЭСФ < 0 Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		СтрокаЭСФ = СвободныеЭСФ[ИндексЭСФ];
		Результат.Добавить(ПарноеСопоставление(СтрокаПоступления, СтрокаЭСФ, Уровень, Допуски));

		СвободныеЭСФ.Удалить(ИндексЭСФ);
		СвободныеПоступления.Удалить(Индекс);

	КонецЦикла;

КонецПроцедуры

// Индекс подходящей строки ЭСФ на заданном уровне или -1.
Функция НайтиПаруНаУровне(СтрокаПоступления, СвободныеЭСФ, Уровень, Соответствия, Допуски)

	ЛучшийИндекс = -1;
	ЛучшаяПохожесть = 0;

	Для Индекс = 0 По СвободныеЭСФ.Количество() - 1 Цикл

		СтрокаЭСФ = СвободныеЭСФ[Индекс];

		Если Уровень = 1 Тогда

			// Явное соответствие номенклатуры контрагента.
			Ожидаемая = Соответствия.Получить(Нормализовать(СтрокаЭСФ.Наименование));
			Если Ожидаемая <> Неопределено
				И ЗначениеЗаполнено(СтрокаПоступления.Номенклатура)
				И Ожидаемая = СтрокаПоступления.Номенклатура Тогда
				Возврат Индекс;
			КонецЕсли;

		ИначеЕсли Уровень = 2 Тогда

			// Наименование, количество и цена. Самое надёжное совпадение,
			// какое можно получить без справочника соответствий.
			Если Нормализовать(СтрокаПоступления.Наименование) = Нормализовать(СтрокаЭСФ.Наименование)
				И СтрокаПоступления.Количество = СтрокаЭСФ.Количество
				И СтрокаПоступления.Цена = СтрокаЭСФ.Цена Тогда
				Возврат Индекс;
			КонецЕсли;

		ИначеЕсли Уровень = 3 Тогда

			// Количество, цена и ставка — наименования при этом различаются.
			Если СтрокаПоступления.Количество = СтрокаЭСФ.Количество
				И СтрокаПоступления.Цена = СтрокаЭСФ.Цена
				И СтавкиРавны(СтрокаПоступления, СтрокаЭСФ) Тогда
				Возврат Индекс;
			КонецЕсли;

		ИначеЕсли Уровень = 4 Тогда

			// Сумма строки и ставка: количество и цена разошлись, но итог тот же.
			Если СуммыВДопуске(СтрокаПоступления.Сумма, СтрокаЭСФ.Сумма, СтрокаПоступления, Допуски)
				И СтавкиРавны(СтрокаПоступления, СтрокаЭСФ) Тогда
				Возврат Индекс;
			КонецЕсли;

		Иначе

			// Нечёткое совпадение наименования при сумме в допуске.
			// Берём не первое подходящее, а самое похожее: на этом уровне
			// кандидатов обычно несколько.
			Если Не СуммыВДопуске(СтрокаПоступления.Сумма, СтрокаЭСФ.Сумма,
				СтрокаПоступления, Допуски) Тогда
				Продолжить;
			КонецЕсли;

			ТекущаяПохожесть = Похожесть(
				Нормализовать(СтрокаПоступления.Наименование),
				Нормализовать(СтрокаЭСФ.Наименование));

			Если ТекущаяПохожесть >= 0.6 И ТекущаяПохожесть > ЛучшаяПохожесть Тогда
				ЛучшаяПохожесть = ТекущаяПохожесть;
				ЛучшийИндекс = Индекс;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат ЛучшийИндекс;

КонецФункции

// Одна строка поступления против нескольких строк ЭСФ.
//
// Типовой случай: поставщик разбил позицию по партиям, в поступлении она одна.
// Ищем набор строк ЭСФ с тем же наименованием, сумма которых даёт сумму строки.
//
// Зеркальный случай (many_to_one — несколько строк поступления против одной
// строки ЭСФ) пока не разбирается: такие строки попадут в only_in_receipt и
// only_in_esf. Это видно бухгалтеру и не искажает суммы, но объяснение будет
// грубее. Разбор появится, когда случай встретится на реальных базах.
//
Процедура СопоставитьОднаКНескольким(Результат, СвободныеПоступления, СвободныеЭСФ, Допуски)

	Индекс = 0;
	Пока Индекс < СвободныеПоступления.Количество() Цикл

		СтрокаПоступления = СвободныеПоступления[Индекс];
		Наименование = Нормализовать(СтрокаПоступления.Наименование);

		Подходящие = Новый Массив;
		СуммаПодходящих = 0;
		КоличествоПодходящих = 0;

		Для ИндексЭСФ = 0 По СвободныеЭСФ.Количество() - 1 Цикл
			СтрокаЭСФ = СвободныеЭСФ[ИндексЭСФ];
			Если Нормализовать(СтрокаЭСФ.Наименование) = Наименование Тогда
				Подходящие.Добавить(ИндексЭСФ);
				СуммаПодходящих = СуммаПодходящих + СтрокаЭСФ.Сумма;
				КоличествоПодходящих = КоличествоПодходящих + СтрокаЭСФ.Количество;
			КонецЕсли;
		КонецЦикла;

		// Одна строка против одной — это работа предыдущих уровней, не наша.
		Если Подходящие.Количество() < 2
			Или Не СуммыВДопуске(СтрокаПоступления.Сумма, СуммаПодходящих, СтрокаПоступления, Допуски)
			Или СтрокаПоступления.Количество <> КоличествоПодходящих Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Сопоставление = Новый Структура;
		Сопоставление.Вставить("СтрокаПоступления", СтрокаПоступления);
		Сопоставление.Вставить("СтрокиЭСФ", Новый Массив);
		Сопоставление.Вставить("Вид", "one_to_many");
		Сопоставление.Вставить("Уровень", 2);
		Сопоставление.Вставить("Уверенность", "medium");

		// Сначала собираем строки, потом удаляем — с конца, иначе индексы
		// съезжают по ходу удаления.
		СуммаНДСПодходящих = 0;
		Для Каждого ИндексЭСФ Из Подходящие Цикл
			СтрокаЭСФ = СвободныеЭСФ[ИндексЭСФ];
			Сопоставление.СтрокиЭСФ.Добавить(СтрокаЭСФ);
			СуммаНДСПодходящих = СуммаНДСПодходящих + СтрокаЭСФ.СуммаНДС;
		КонецЦикла;

		Для Шаг = 1 По Подходящие.Количество() Цикл
			СвободныеЭСФ.Удалить(Подходящие[Подходящие.Количество() - Шаг]);
		КонецЦикла;

		Разницы = Новый Структура;
		Разницы.Вставить("Количество", 0);
		Разницы.Вставить("Цена", 0);
		Разницы.Вставить("Сумма", СтрокаПоступления.Сумма - СуммаПодходящих);
		Разницы.Вставить("СуммаНДС", СтрокаПоступления.СуммаНДС - СуммаНДСПодходящих);
		Разницы.Вставить("Всего", 0);
		Сопоставление.Вставить("Разницы", Разницы);

		Результат.Добавить(Сопоставление);
		СвободныеПоступления.Удалить(Индекс);

	КонецЦикла;

КонецПроцедуры

// Сопоставление одной строки с одной.
Функция ПарноеСопоставление(СтрокаПоступления, СтрокаЭСФ, Уровень, Допуски)

	Разницы = Новый Структура;
	Разницы.Вставить("Количество", СтрокаПоступления.Количество - СтрокаЭСФ.Количество);
	Разницы.Вставить("Цена", СтрокаПоступления.Цена - СтрокаЭСФ.Цена);
	Разницы.Вставить("Сумма", СтрокаПоступления.Сумма - СтрокаЭСФ.Сумма);
	Разницы.Вставить("СуммаНДС", СтрокаПоступления.СуммаНДС - СтрокаЭСФ.СуммаНДС);
	Разницы.Вставить("Всего", СтрокаПоступления.Всего - СтрокаЭСФ.Всего);

	СтрокиЭСФ = Новый Массив;
	СтрокиЭСФ.Добавить(СтрокаЭСФ);

	Сопоставление = Новый Структура;
	Сопоставление.Вставить("СтрокаПоступления", СтрокаПоступления);
	Сопоставление.Вставить("СтрокиЭСФ", СтрокиЭСФ);
	Сопоставление.Вставить("Вид", ВидСопоставления(Разницы, СтрокаПоступления, Допуски));
	Сопоставление.Вставить("Уровень", Уровень);
	Сопоставление.Вставить("Уверенность", УверенностьУровня(Уровень));
	Сопоставление.Вставить("Разницы", Разницы);

	Возврат Сопоставление;

КонецФункции

// Строка, которой не нашлось пары (код D12).
Функция ОдностороннееСопоставление(СтрокаПоступления, СтрокаЭСФ)

	СтрокиЭСФ = Новый Массив;
	Если СтрокаЭСФ <> Неопределено Тогда
		СтрокиЭСФ.Добавить(СтрокаЭСФ);
	КонецЕсли;

	Разницы = Новый Структура;
	Разницы.Вставить("Количество", 0);
	Разницы.Вставить("Цена", 0);
	Разницы.Вставить("Сумма", 0);
	Разницы.Вставить("СуммаНДС", 0);
	Разницы.Вставить("Всего", 0);

	Сопоставление = Новый Структура;
	Сопоставление.Вставить("СтрокаПоступления", СтрокаПоступления);
	Сопоставление.Вставить("СтрокиЭСФ", СтрокиЭСФ);
	Сопоставление.Вставить("Вид", ?(СтрокаПоступления = Неопределено, "only_in_esf", "only_in_receipt"));
	Сопоставление.Вставить("Уровень", Неопределено);
	Сопоставление.Вставить("Уверенность", "low");
	Сопоставление.Вставить("Разницы", Разницы);

	Возврат Сопоставление;

КонецФункции

// Совпало, совпало в допуске или разошлось.
Функция ВидСопоставления(Разницы, СтрокаПоступления, Допуски)

	Если Разницы.Сумма = 0 И Разницы.СуммаНДС = 0 И Разницы.Количество = 0 Тогда
		Возврат "matched";
	КонецЕсли;

	// Копейки при совпадающем количестве — это округление, а не расхождение.
	// Разбираться, какое именно, будет БотаПаттерныОкругления.
	Если Разницы.Количество = 0
		И АбсЗначение(Разницы.Сумма) <= ДопускСтроки(СтрокаПоступления, Допуски)
		И АбсЗначение(Разницы.СуммаНДС) <= ДопускСтроки(СтрокаПоступления, Допуски) Тогда
		Возврат "matched_within_tolerance";
	КонецЕсли;

	Возврат "matched_with_diff";

КонецФункции

// Допуск на строку: 0,01 × количество, но не более потолка (ТЗ п. 4.4).
Функция ДопускСтроки(СтрокаПоступления, Допуски)

	НаЕдиницу = ?(Допуски.Свойство("ДопускНаЕдиницу"), Допуски.ДопускНаЕдиницу, 0.01);
	Потолок = ?(Допуски.Свойство("ПотолокСтроки"), Допуски.ПотолокСтроки, 1);

	Количество = АбсЗначение(СтрокаПоступления.Количество);
	Возврат Мин(НаЕдиницу * Макс(Количество, 1), Потолок);

КонецФункции

Функция СуммыВДопуске(Первая, Вторая, СтрокаПоступления, Допуски)

	Возврат АбсЗначение(Первая - Вторая) <= ДопускСтроки(СтрокаПоступления, Допуски);

КонецФункции

Функция СтавкиРавны(СтрокаПоступления, СтрокаЭСФ)

	Возврат СокрЛП(Строка(СтрокаПоступления.СтавкаНДС)) = СокрЛП(Строка(СтрокаЭСФ.СтавкаНДС));

КонецФункции

// Уверенность, соответствующая уровню сопоставления (ТЗ п. 4.3).
Функция УверенностьУровня(Уровень)

	Если Уровень = 1 Или Уровень = 2 Тогда
		Возврат "high";
	ИначеЕсли Уровень = 3 Тогда
		Возврат "medium";
	КонецЕсли;

	Возврат "low";

КонецФункции

// Биграммы строки: соответствие «пара символов → сколько раз встретилась».
Функция Биграммы(Значение)

	Результат = Новый Соответствие;

	Для Индекс = 1 По СтрДлина(Значение) - 1 Цикл
		Пара = Сред(Значение, Индекс, 2);
		Если Пара = "  " Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Пара, ?(Результат.Получить(Пара) = Неопределено, 1,
			Результат.Получить(Пара) + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВсегоБиграмм(Набор)

	Всего = 0;
	Для Каждого Элемент Из Набор Цикл
		Всего = Всего + Элемент.Значение;
	КонецЦикла;

	Возврат Всего;

КонецФункции

Функция КопияМассива(Исходный)

	Результат = Новый Массив;
	Для Каждого Элемент Из Исходный Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АбсЗначение(Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

#КонецОбласти
