///////////////////////////////////////////////////////////////////////////////
// БотаТочкиВхода: код для объектов метаданных, которые нельзя задать модулем.
//
// Здесь собраны тела обработчиков, которые в конфигураторе живут внутри
// HTTP-сервиса, регламентного задания и подписок на события. Скопируйте их
// в соответствующие модули объектов — сами объекты создаются в конфигураторе
// (см. extension/README.md).
//
// Обработчики намеренно тонкие: вся логика в общих модулях, здесь только
// вызов. Так её можно менять, не трогая объекты метаданных, и проверять
// статическим анализом.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// --- Модуль HTTP-сервиса «Бота» ---------------------------------------------
//
// Шаблон: /v1/tools/{tool}, метод POST, обработчик toolsPOST.
//
//   Функция toolsPOST(Запрос)
//       Возврат БотаТочкиВхода.ОбработатьВызовИнструмента(Запрос);
//   КонецФункции

// Точка входа HTTP-сервиса.
Функция ОбработатьВызовИнструмента(Запрос) Экспорт

	Возврат БотаОбменСОркестратором.ОбработатьЗапросИнструмента(Запрос);

КонецФункции

// --- Регламентное задание «БотаОбменСОркестратором» --------------------------
//
//   Процедура ОбменСОркестратором() Экспорт
//       БотаТочкиВхода.ВыполнитьОбмен();
//   КонецПроцедуры
//
// Интервал: 5–15 с при активном диалоге. Задание само подстраивает частоту —
// когда задач нет, оно просто ничего не делает и завершается быстро.

// Обработчик регламентного задания: обратный поллинг.
Процедура ВыполнитьОбмен() Экспорт

	// Несколько задач за один запуск: при активном диалоге агент делает
	// 4–7 вызовов подряд, и обрабатывать их по одной с паузой в 15 секунд
	// значило бы растянуть ответ на минуты.
	МаксимумЗаЗапуск = 10;
	Обработано = 0;

	Пока Обработано < МаксимумЗаЗапуск Цикл

		Попытка
			Если Не БотаОбменСОркестратором.ВыполнитьОдинЦиклПоллинга() Тогда
				Прервать;
			КонецЕсли;
		Исключение
			// Регламентное задание не должно падать: упавшее задание в 1С
			// отключается, и обмен встанет молча.
			ЗаписьЖурналаРегистрации("Бота.Поллинг", УровеньЖурналаРегистрации.Ошибка,
				, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Прервать;
		КонецПопытки;

		Обработано = Обработано + 1;

	КонецЦикла;

КонецПроцедуры

// --- Подписки на события ------------------------------------------------------
//
// Подписка «БотаСбросКэшаПриЗаписиДокумента», событие «ПриЗаписи»,
// источник: ПоступлениеТоваровУслуг, СчетФактураПолученный, ЭСФ.
//
//   Процедура СбросКэшаПриЗаписи(Источник, Отказ) Экспорт
//       БотаТочкиВхода.ПриЗаписиДокумента(Источник, Отказ);
//   КонецПроцедуры

// Сбрасывает кэш расчёта при изменении документа периода.
//
// Без этого бухгалтер правит документ, повторяет сверку и видит прежние
// цифры — worst case для продукта, который должен находить расхождения.
//
Процедура ПриЗаписиДокумента(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Организация = БотаМетаданныеТиповой.ЗначениеРеквизита(Источник,
			БотаМетаданныеТиповой.Имена().РеквизитОрганизация);

		Если ЗначениеЗаполнено(Организация) Тогда
			БотаСверкаПериода.СброситьКэш(Организация, Источник.Дата);
		КонецЕсли;

	Исключение
		// Сброс кэша не должен мешать записи документа: бухгалтер не поймёт,
		// почему поступление не записывается из-за расширения.
		ЗаписьЖурналаРегистрации("Бота.Кэш", УровеньЖурналаРегистрации.Предупреждение,
			, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// --- Форма «Агент»: серверная часть -------------------------------------------
//
// Форма отправляет вопрос, затем раз в секунду опрашивает прогресс
// (ТЗ п.8). Обработчик ожидания на клиенте вызывает ПолучитьПрогресс.

// Отправляет вопрос оркестратору и возвращает идентификатор запроса.
//
// Параметры:
//  Вопрос   - Строка
//  ДиалогId - Строка - пустая строка начинает новый диалог
//
// Возвращаемое значение:
//  Структура - dialog_id, request_id, error.
//
Функция ОтправитьВопрос(Вопрос, ДиалогId = "") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("message", Вопрос);
	Тело.Вставить("user_id", Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор));
	Если ЗначениеЗаполнено(ДиалогId) Тогда
		Тело.Вставить("dialog_id", ДиалогId);
	КонецЕсли;

	Возврат ВызватьОркестратор("POST", "/v1/chat/ask/background", Тело);

КонецФункции

// Текущее состояние запроса: что агент делает прямо сейчас.
//
// Возвращаемое значение:
//  Структура - status, step_label, answer, error.
//
Функция ПолучитьПрогресс(ИдентификаторЗапроса) Экспорт

	Ответ = ВызватьОркестратор("GET",
		"/v1/chat/progress/" + ИдентификаторЗапроса, Неопределено);

	Если Ответ.Свойство("answer") И ЗначениеЗаполнено(Ответ.answer) Тогда
		// Ответ приходит в псевдонимах: подстановку настоящих наименований
		// делает 1С, потому что таблица соответствий живёт здесь (A.0.5).
		Ответ.answer = БотаМаскирование.Раскрыть(Ответ.answer, Ответ.dialog_id);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Применение плана из формы. Единственный путь изменить данные.
Функция ПрименитьПлан(ПланId) Экспорт

	Возврат БотаПланы.Применить(ПланId);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВызватьОркестратор(Метод, Путь, Тело)

	Ошибка = Новый Структура("error", "");

	Адрес = ЗначениеКонстанты("БотаАдресОркестратора");
	Токен = ЗначениеКонстанты("БотаТокенБазы");

	Если ПустаяСтрока(Адрес) Или ПустаяСтрока(Токен) Тогда
		Ошибка.error = "Не заданы адрес оркестратора или токен базы."
			+ " Проверьте настройки расширения.";
		Возврат Ошибка;
	КонецЕсли;

	Попытка

		URI = СтруктураURI(Адрес);
		Соединение = Новый HTTPСоединение(URI.Хост, URI.Порт, , , , 120,
			?(НРег(URI.Схема) = "https", Новый ЗащищенноеСоединениеOpenSSL, Неопределено));

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

		Запрос = Новый HTTPЗапрос(Путь, Заголовки);
		Если Тело <> Неопределено Тогда
			Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), "UTF-8");
		КонецЕсли;

		Ответ = ?(Метод = "GET", Соединение.Получить(Запрос),
			Соединение.ОтправитьДляОбработки(Запрос));

	Исключение
		Ошибка.error = "Оркестратор недоступен. Проверьте связь и адрес сервиса.";
		ЗаписьЖурналаРегистрации("Бота.Диалог", УровеньЖурналаРегистрации.Ошибка,
			, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ошибка;
	КонецПопытки;

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	Если Ответ.КодСостояния >= 400 Тогда
		Ошибка.error = СообщениеОбОшибке(ТекстОтвета, Ответ.КодСостояния);
		Возврат Ошибка;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Ошибка.error = "Оркестратор вернул неожиданный ответ.";
		Возврат Ошибка;
	КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Ошибка.error = "Оркестратор вернул неожиданный ответ.";
		Возврат Ошибка;
	КонецЕсли;

	Результат.Вставить("error", "");

	Возврат Результат;

КонецФункции

// Текст ошибки для показа бухгалтеру.
//
// Оркестратор возвращает понятное сообщение в поле message — берём его.
// Технические подробности пользователю не нужны, они уже в журнале.
//
Функция СообщениеОбОшибке(ТекстОтвета, КодСостояния)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("message") Тогда
			Возврат Данные.message;
		КонецЕсли;
	Исключение
		// Ответ не JSON — покажем общий текст ниже.
	КонецПопытки;

	Возврат СтрШаблон("Оркестратор вернул ошибку %1.", КодСостояния);

КонецФункции

Функция ВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ЗначениеКонстанты(ИмяКонстанты)

	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Константы[ИмяКонстанты].Получить();

	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), "");

КонецФункции

#КонецОбласти
