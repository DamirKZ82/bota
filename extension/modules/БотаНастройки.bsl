///////////////////////////////////////////////////////////////////////////////
// БотаНастройки: допуски и параметры сверки (ТЗ п. 4.4, Приложение А, A.1).
//
// Значения по умолчанию взяты из ТЗ. Они не константы в коде, а именно
// настройки: на реальных базах допуски придётся подбирать, и делать это должен
// бухгалтер, не разработчик.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Действующие настройки сверки.
//
// Возвращаемое значение:
//  Структура:
//   * ДопускНаЕдиницу   - Число - допуск на единицу количества в строке
//   * ПотолокСтроки     - Число - максимальный допуск на строку
//   * ДопускНаСтроку    - Число - допуск на одну строку документа
//   * ПотолокДокумента  - Число - максимальный допуск на документ
//   * ПорогПериода      - Число - порог существенности для итогов периода
//   * ХвостПериодаДней  - Число - срок выписки ЭСФ после оборота
//   * ДнейДопускКандидата - Число - допуск по дате при поиске кандидатов
//   * СуммаДопускаКандидата - Число - допуск по сумме при поиске кандидатов
//   * Маскирование      - Булево - маскировать ли данные в ответах
//
Функция Текущие() Экспорт

	Настройки = ПоУмолчанию();

	// Константы могут отсутствовать, пока расширение не донастроено, —
	// в этом случае работают значения по умолчанию, а не падение.
	ПрочитатьКонстанту(Настройки, "БотаДопускНаЕдиницу", "ДопускНаЕдиницу");
	ПрочитатьКонстанту(Настройки, "БотаПотолокСтроки", "ПотолокСтроки");
	ПрочитатьКонстанту(Настройки, "БотаДопускНаСтроку", "ДопускНаСтроку");
	ПрочитатьКонстанту(Настройки, "БотаПотолокДокумента", "ПотолокДокумента");
	ПрочитатьКонстанту(Настройки, "БотаПорогПериода", "ПорогПериода");
	ПрочитатьКонстанту(Настройки, "БотаХвостПериодаДней", "ХвостПериодаДней");
	ПрочитатьКонстанту(Настройки, "БотаДнейДопускКандидата", "ДнейДопускКандидата");
	ПрочитатьКонстанту(Настройки, "БотаМаскирование", "Маскирование");

	Возврат Настройки;

КонецФункции

// Настройки по умолчанию — значения из ТЗ п. 4.4.
Функция ПоУмолчанию() Экспорт

	Настройки = Новый Структура;

	// Допуск на строку: 0,01 × количество, но не более 1,00 ₸.
	Настройки.Вставить("ДопускНаЕдиницу", 0.01);
	Настройки.Вставить("ПотолокСтроки", 1);

	// Допуск на документ: 0,01 × число строк, но не более 5,00 ₸.
	Настройки.Вставить("ДопускНаСтроку", 0.01);
	Настройки.Вставить("ПотолокДокумента", 5);

	// Порог существенности для итогов периода.
	Настройки.Вставить("ПорогПериода", 1);

	// Срок выписки ЭСФ после даты оборота (ТЗ п. 4.1).
	Настройки.Вставить("ХвостПериодаДней", 20);

	// Поиск кандидатов на связь.
	Настройки.Вставить("ДнейДопускКандидата", 10);
	Настройки.Вставить("СуммаДопускаКандидата", 5);

	Настройки.Вставить("Маскирование", Истина);

	Возврат Настройки;

КонецФункции

// Настройки в формате Приложения А (раздел A.1, поле settings).
//
// Суммы — строками: числа с плавающей точкой в JSON сами создают ту копеечную
// ошибку, которую продукт ищет (A.0.3).
//
Функция ДляОтвета() Экспорт

	Настройки = Текущие();

	Результат = Новый Структура;
	Результат.Вставить("line_tolerance_per_unit", Сумма(Настройки.ДопускНаЕдиницу));
	Результат.Вставить("line_tolerance_max", Сумма(Настройки.ПотолокСтроки));
	Результат.Вставить("doc_tolerance_per_line", Сумма(Настройки.ДопускНаСтроку));
	Результат.Вставить("doc_tolerance_max", Сумма(Настройки.ПотолокДокумента));
	Результат.Вставить("period_tolerance_total", Сумма(Настройки.ПорогПериода));
	Результат.Вставить("esf_tail_days", Настройки.ХвостПериодаДней);
	Результат.Вставить("candidate_days", Настройки.ДнейДопускКандидата);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрочитатьКонстанту(Настройки, ИмяКонстанты, ИмяПоля)

	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значение = Константы[ИмяКонстанты].Получить();

	// Незаполненная константа означает «оставить значение по умолчанию»,
	// а не «считать допуск нулевым»: нулевой допуск превратил бы каждое
	// округление в ошибку.
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Настройки.Вставить(ИмяПоля, Значение);

КонецПроцедуры

Функция Сумма(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0");

КонецФункции

#КонецОбласти
