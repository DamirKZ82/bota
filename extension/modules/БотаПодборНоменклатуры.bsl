///////////////////////////////////////////////////////////////////////////////
// БотаПодборНоменклатуры: черновик поступления по ЭСФ (ТЗ п. 5.2.1, A.9.5).
//
// Задача: превратить строки ЭСФ, где номенклатура записана словами поставщика,
// в строки поступления со ссылками на справочник базы.
//
// Пять источников по убыванию надёжности, и каждый честно помечается в ответе:
//
//   mapping → подтверждённое соответствие контрагента          high
//   history → накопленное автоматически при прошлых сверках    high
//   exact   → точное совпадение нормализованного наименования  high
//   fuzzy   → похожее наименование, показываем альтернативы    medium
//   none    → не нашли, предлагаем завести новую позицию       none
//
// Уверенность — не украшение. Пока в черновике есть строки `needs_attention`,
// `can_apply` остаётся ложным, и создать документ нельзя (A.9.5). Бухгалтер
// выбирает номенклатуру сам, а его выбор запоминается — так агент учится на
// базе клиента.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Черновик поступления по ЭСФ (фаза 1, A.9.5).
//
// Параметры:
//  ЭСФСсылка       - ДокументСсылка.ЭСФ
//  Склад           - СправочникСсылка.Склады, Неопределено
//  Договор         - СправочникСсылка.ДоговорыКонтрагентов, Неопределено
//  Переопределения - Массив из Структура - esf_line, item: ручной выбор бухгалтера
//  СессияId        - Строка
//
// Возвращаемое значение:
//  Структура - план в формате A.9.5.
//
Функция ПланСоздатьПоЭСФ(ЭСФСсылка, Склад = Неопределено, Договор = Неопределено,
	Переопределения = Неопределено, СессияId = "") Экспорт

	Данные = БотаДвижокСверки.ДанныеДокумента(ЭСФСсылка);
	Если Данные = Неопределено Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("NOT_FOUND", "ЭСФ не найдена");
	КонецЕсли;

	Контрагент = Данные.Контрагент;
	Соответствия = ПрочитатьСоответствия(Контрагент);
	ВыборБухгалтера = РазобратьПереопределения(Переопределения);

	Строки = Новый Массив;
	ТребуютВнимания = 0;
	ИтогБезНДС = 0;
	ИтогНДС = 0;

	Для Каждого СтрокаЭСФ Из БотаМетаданныеТиповой.СтрокиДокумента(ЭСФСсылка) Цикл

		Подбор = Подобрать(СтрокаЭСФ, Контрагент, Соответствия,
			ВыборБухгалтера.Получить(СтрокаЭСФ.Номер));

		СтрокаЧерновика = Новый Структура;
		СтрокаЧерновика.Вставить("n", СтрокаЭСФ.Номер);
		СтрокаЧерновика.Вставить("esf_name", СтрокаЭСФ.Наименование);
		СтрокаЧерновика.Вставить("item", Подбор.Позиция);
		СтрокаЧерновика.Вставить("suggest_new_item", Подбор.НоваяПозиция);
		СтрокаЧерновика.Вставить("unit", ?(ЗначениеЗаполнено(СтрокаЭСФ.Единица),
			Строка(СтрокаЭСФ.Единица), Неопределено));
		СтрокаЧерновика.Вставить("qty", БотаИнструменты.Количество(СтрокаЭСФ.Количество));
		СтрокаЧерновика.Вставить("price", БотаИнструменты.Сумма(СтрокаЭСФ.Цена));
		СтрокаЧерновика.Вставить("vat_rate", СтавкаСтрокой(СтрокаЭСФ.СтавкаНДС));
		СтрокаЧерновика.Вставить("account", Подбор.Счёт);
		СтрокаЧерновика.Вставить("needs_attention", Подбор.ТребуетВнимания);

		Если Подбор.ТребуетВнимания Тогда
			ТребуютВнимания = ТребуютВнимания + 1;
		КонецЕсли;

		ИтогБезНДС = ИтогБезНДС + СтрокаЭСФ.Сумма;
		ИтогНДС = ИтогНДС + СтрокаЭСФ.СуммаНДС;

		Строки.Добавить(СтрокаЧерновика);

	КонецЦикла;

	ВыбранныйДоговор = ?(ЗначениеЗаполнено(Договор), ПодборСсылки(Договор, "high"),
		ПодобратьДоговор(Контрагент));
	ВыбранныйСклад = ?(ЗначениеЗаполнено(Склад), ПодборСсылки(Склад, "high"),
		ПодобратьСклад());

	Черновик = Новый Структура;
	Черновик.Вставить("organization", БотаИнструменты.Ссылка(Данные.Организация));
	Черновик.Вставить("counterparty", ПодборСсылки(Контрагент, "high"));
	Черновик.Вставить("contract", ВыбранныйДоговор);
	Черновик.Вставить("warehouse", ВыбранныйСклад);
	Черновик.Вставить("date", Формат(?(ЗначениеЗаполнено(Данные.ДатаОборота),
		Данные.ДатаОборота, Данные.Дата), "ДФ=yyyy-MM-dd"));
	// ЭСФ всегда содержит суммы без налога отдельной колонкой, поэтому в
	// создаваемом документе флаг «сумма включает НДС» снят.
	Черновик.Вставить("vat_included", Ложь);
	Черновик.Вставить("lines", Строки);
	Черновик.Вставить("totals", Новый Структура("net, vat, total",
		БотаИнструменты.Сумма(ИтогБезНДС), БотаИнструменты.Сумма(ИтогНДС),
		БотаИнструменты.Сумма(ИтогБезНДС + ИтогНДС)));
	Черновик.Вставить("attention_count", ТребуютВнимания);

	Проверки = Новый Массив;
	Проверки.Добавить(Новый Структура("check, ok, message", "esf_not_linked",
		Не ЗначениеЗаполнено(Данные.Поступление),
		?(ЗначениеЗаполнено(Данные.Поступление),
			"По этой ЭСФ уже есть поступление в базе", Неопределено)));

	МожноПрименить = ТребуютВнимания = 0 И Не ЗначениеЗаполнено(Данные.Поступление);
	Причина = ?(ТребуютВнимания > 0,
		СтрШаблон("%1 стр. требует выбора номенклатуры", ТребуютВнимания),
		?(ЗначениеЗаполнено(Данные.Поступление),
			"По этой ЭСФ уже есть поступление в базе", Неопределено));

	Возврат СохранитьЧерновик(ЭСФСсылка, Черновик, Проверки, МожноПрименить,
		Причина, СессияId);

КонецФункции

// Запоминает выбор бухгалтера: агент учится на базе клиента (ТЗ п. 5.2.1).
//
// Вызывается после применения плана создания, когда номенклатура строк уже
// подтверждена человеком.
//
Процедура ЗапомнитьСоответствие(Контрагент, НаименованиеИзЭСФ, Номенклатура,
	Подтверждено = Истина) Экспорт

	Если Метаданные.РегистрыСведений.Найти("БотаСоответствияНоменклатуры") = Неопределено
		Или Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	Нормализованное = БотаСопоставлениеСтрок.Нормализовать(НаименованиеИзЭСФ);
	Если ПустаяСтрока(Нормализованное) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.БотаСоответствияНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Контрагент = Контрагент;
	Запись.НаименованиеНормализованное = Лев(Нормализованное, 200);
	Запись.Прочитать();

	// Подтверждённое соответствие не понижаем автоматическим: выбор человека
	// весомее догадки движка.
	Если Запись.Выбран() И Запись.Подтверждено И Не Подтверждено Тогда
		Возврат;
	КонецЕсли;

	Запись.Контрагент = Контрагент;
	Запись.НаименованиеНормализованное = Лев(Нормализованное, 200);
	Запись.Номенклатура = Номенклатура;
	Запись.Подтверждено = Подтверждено;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подбор номенклатуры для одной строки ЭСФ.
Функция Подобрать(СтрокаЭСФ, Контрагент, Соответствия, ВыборБухгалтера)

	// Явный выбор человека выше любого автоматического подбора.
	Если ЗначениеЗаполнено(ВыборБухгалтера) Тогда
		Возврат Результат(ВыборБухгалтера, "high", "mapping", Новый Массив, Ложь);
	КонецЕсли;

	Нормализованное = БотаСопоставлениеСтрок.Нормализовать(СтрокаЭСФ.Наименование);

	// Уровень 1–2: соответствия контрагента. Подтверждённое — mapping,
	// накопленное автоматически — history.
	Запись = Соответствия.Получить(Нормализованное);
	Если Запись <> Неопределено Тогда
		Возврат Результат(Запись.Номенклатура, "high",
			?(Запись.Подтверждено, "mapping", "history"), Новый Массив, Ложь);
	КонецЕсли;

	// Уровень 3: номенклатура уже указана в самой ЭСФ.
	Если ЗначениеЗаполнено(СтрокаЭСФ.Номенклатура) Тогда
		Возврат Результат(СтрокаЭСФ.Номенклатура, "high", "exact", Новый Массив, Ложь);
	КонецЕсли;

	// Уровень 3–4: поиск по справочнику.
	Кандидаты = НайтиПоСправочнику(Нормализованное);

	Если Кандидаты.Количество() > 0 И Кандидаты[0].Похожесть >= 0.99 Тогда
		Возврат Результат(Кандидаты[0].Ссылка, "high", "exact", Новый Массив, Ложь);
	КонецЕсли;

	Если Кандидаты.Количество() > 0 И Кандидаты[0].Похожесть >= 0.7 Тогда
		// Показываем до трёх альтернатив: бухгалтер выберет сам, если движок
		// ошибся. Строка при этом не блокирует применение — подбор уверенный.
		Возврат Результат(Кандидаты[0].Ссылка, "medium", "fuzzy",
			Альтернативы(Кандидаты), Ложь);
	КонецЕсли;

	// Уровень 5: не нашли. Предлагаем завести позицию и требуем внимания.
	Возврат Результат(Неопределено, "none", "none", Альтернативы(Кандидаты), Истина,
		НоваяПозиция(СтрокаЭСФ));

КонецФункции

Функция Результат(Ссылка, Уверенность, Источник, Альтернативы, ТребуетВнимания,
	НоваяПозиция = Неопределено)

	Позиция = Новый Структура;
	Позиция.Вставить("ref", ?(ЗначениеЗаполнено(Ссылка),
		БотаИнструменты.Ссылка(Ссылка), Неопределено));
	Позиция.Вставить("confidence", Уверенность);
	Позиция.Вставить("source", Источник);
	Позиция.Вставить("alternatives", Альтернативы);

	Возврат Новый Структура("Позиция, НоваяПозиция, Счёт, ТребуетВнимания",
		Позиция, НоваяПозиция, СчётУчёта(Ссылка), ТребуетВнимания);

КонецФункции

// Поиск похожей номенклатуры в справочнике.
//
// Сначала грубый отбор запросом по первому значимому слову, затем точное
// сравнение биграммами в коде: нормализацию средствами запроса не сделать,
// а тащить весь справочник в память нельзя.
//
Функция НайтиПоСправочнику(Нормализованное)

	Результат = Новый Массив;
	Если ПустаяСтрока(Нормализованное) Тогда
		Возврат Результат;
	КонецЕсли;

	Слова = СтрРазделить(Нормализованное, " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Самое длинное слово различает позиции лучше первого: «бумага» есть у
	// сотни номенклатур, «снегурочка» — у одной.
	Ключевое = "";
	Для Каждого Слово Из Слова Цикл
		Если СтрДлина(Слово) > СтрДлина(Ключевое) Тогда
			Ключевое = Слово;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Ключевое) < 3 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.%1 КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Наименование ПОДОБНО &Образец
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа",
		БотаМетаданныеТиповой.Имена().СправочникНоменклатура);
	Запрос.УстановитьПараметр("Образец", "%" + Ключевое + "%");

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Похожесть", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Ссылка");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Похожесть = БотаСопоставлениеСтрок.Похожесть(Нормализованное,
			БотаСопоставлениеСтрок.Нормализовать(Выборка.Наименование));

		Если Похожесть > 0 Тогда
			Строка = Таблица.Добавить();
			Строка.Похожесть = Похожесть;
			Строка.Ссылка = Выборка.Ссылка;
		КонецЕсли;

	КонецЦикла;

	Таблица.Сортировать("Похожесть Убыв");

	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Новый Структура("Ссылка, Похожесть", Строка.Ссылка, Строка.Похожесть));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// До трёх альтернатив для показа бухгалтеру (A.9.5).
Функция Альтернативы(Кандидаты)

	Результат = Новый Массив;

	Для Индекс = 0 По Мин(2, Кандидаты.Количество() - 1) Цикл
		Результат.Добавить(БотаИнструменты.Ссылка(Кандидаты[Индекс].Ссылка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Предложение завести новую позицию с предзаполненными полями.
Функция НоваяПозиция(СтрокаЭСФ)

	Возврат Новый Структура("name, unit, vat_rate",
		СтрокаЭСФ.Наименование,
		?(ЗначениеЗаполнено(СтрокаЭСФ.Единица), Строка(СтрокаЭСФ.Единица), Неопределено),
		СтавкаСтрокой(СтрокаЭСФ.СтавкаНДС));

КонецФункции

// Счёт учёта по настройкам типовой.
//
// Настройки счетов учёта номенклатуры устроены по-разному в разных релизах,
// поэтому счёт подбирается «мягко»: не нашли — оставляем пустым и помечаем
// низкой уверенностью, а не подставляем наугад. Неверный счёт учёта хуже
// пустого: он молча уедет в проводки.
//
Функция СчётУчёта(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("code, confidence", "1330", "medium");

КонецФункции

Функция ПодобратьДоговор(Контрагент)

	Если Не ЗначениеЗаполнено(Контрагент)
		Или Метаданные.Справочники.Найти(
			БотаМетаданныеТиповой.Имена().СправочникДоговоры) = Неопределено Тогда
		Возврат ПодборСсылки(Неопределено, "none");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И НЕ Договоры.ПометкаУдаления",
		БотаМетаданныеТиповой.Имена().СправочникДоговоры);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Договоры = Запрос.Выполнить().Выгрузить();

	Если Договоры.Количество() = 0 Тогда
		Возврат ПодборСсылки(Неопределено, "none");
	КонецЕсли;

	// Единственный договор — уверенно. Несколько — выбор за бухгалтером,
	// поэтому уверенность средняя и показываем альтернативы.
	Уверенность = ?(Договоры.Количество() = 1, "high", "medium");
	Подбор = ПодборСсылки(Договоры[0].Ссылка, Уверенность);

	Если Договоры.Количество() > 1 Тогда
		Для Индекс = 1 По Мин(3, Договоры.Количество() - 1) Цикл
			Подбор.alternatives.Добавить(БотаИнструменты.Ссылка(Договоры[Индекс].Ссылка));
		КонецЦикла;
	КонецЕсли;

	Возврат Подбор;

КонецФункции

Функция ПодобратьСклад()

	ИмяСправочника = БотаМетаданныеТиповой.Имена().СправочникСклады;
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат ПодборСсылки(Неопределено, "none");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Склады
		|ГДЕ
		|	НЕ Склады.ПометкаУдаления
		|	И НЕ Склады.ЭтоГруппа",
		ИмяСправочника);

	Склады = Запрос.Выполнить().Выгрузить();

	Если Склады.Количество() = 0 Тогда
		Возврат ПодборСсылки(Неопределено, "none");
	КонецЕсли;

	Возврат ПодборСсылки(Склады[0].Ссылка,
		?(Склады.Количество() = 1, "high", "medium"));

КонецФункции

Функция ПодборСсылки(Ссылка, Уверенность)

	Возврат Новый Структура("ref, confidence, alternatives",
		?(ЗначениеЗаполнено(Ссылка), БотаИнструменты.Ссылка(Ссылка), Неопределено),
		Уверенность, Новый Массив);

КонецФункции

Функция ПрочитатьСоответствия(Контрагент)

	Соответствия = Новый Соответствие;

	Если Метаданные.РегистрыСведений.Найти("БотаСоответствияНоменклатуры") = Неопределено
		Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Соответствия;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствия.НаименованиеНормализованное КАК Наименование,
		|	Соответствия.Номенклатура КАК Номенклатура,
		|	Соответствия.Подтверждено КАК Подтверждено
		|ИЗ
		|	РегистрСведений.БотаСоответствияНоменклатуры КАК Соответствия
		|ГДЕ
		|	Соответствия.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Соответствия.Вставить(Выборка.Наименование,
			Новый Структура("Номенклатура, Подтверждено",
				Выборка.Номенклатура, Выборка.Подтверждено));
	КонецЦикла;

	Возврат Соответствия;

КонецФункции

Функция РазобратьПереопределения(Переопределения)

	Результат = Новый Соответствие;

	Если Переопределения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИмяСправочника = БотаМетаданныеТиповой.Имена().СправочникНоменклатура;

	Для Каждого Переопределение Из Переопределения Цикл

		Если Не Переопределение.Свойство("esf_line") Или Не Переопределение.Свойство("item") Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Идентификатор = Новый УникальныйИдентификатор(Строка(Переопределение.item));
			Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Идентификатор);
		Исключение
			ВызватьИсключение БотаИнструменты.БотаОшибка("BAD_ARGS",
				СтрШаблон("В переопределении строки %1 указан неверный идентификатор номенклатуры",
					Переопределение.esf_line));
		КонецПопытки;

		Результат.Вставить(Число(Переопределение.esf_line), Ссылка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СохранитьЧерновик(ЭСФСсылка, Черновик, Проверки, МожноПрименить, Причина, СессияId)

	Если Метаданные.РегистрыСведений.Найти("БотаПланы") = Неопределено Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("INTERNAL",
			"Не создан регистр сведений «БотаПланы»: планы негде хранить");
	КонецЕсли;

	СрокДействия = ТекущаяДатаСеанса() + 1800;
	ПланId = Строка(Новый УникальныйИдентификатор());

	Внутренний = Новый Структура;
	Внутренний.Вставить("plan_id", ПланId);
	Внутренний.Вставить("action", "create_receipt_from_esf");
	Внутренний.Вставить("expires_at", Формат(СрокДействия, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Внутренний.Вставить("checks", Проверки);
	Внутренний.Вставить("can_apply", МожноПрименить);
	Внутренний.Вставить("block_reason", Причина);
	Внутренний.Вставить("draft", Черновик);
	Внутренний.Вставить("session_id", СессияId);
	Внутренний.Вставить("ЭСФ", ЭСФСсылка);

	Запись = РегистрыСведений.БотаПланы.СоздатьМенеджерЗаписи();
	Запись.ПланId = ПланId;
	Запись.Действие = "create_receipt_from_esf";
	Запись.СрокДействия = СрокДействия;
	Запись.Применён = Ложь;
	Запись.ДанныеПлана = Новый ХранилищеЗначения(Внутренний, Новый СжатиеДанных(9));
	Запись.Записать();

	// Наружу — без служебной ссылки на ЭСФ: в контракте A.9.5 её нет.
	Ответ = Новый Структура;
	Для Каждого Элемент Из Внутренний Цикл
		Если Элемент.Ключ <> "ЭСФ" Тогда
			Ответ.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Функция СтавкаСтрокой(Ставка)

	Если ТипЗнч(Ставка) = Тип("Число") Тогда
		Возврат Формат(Ставка, "ЧДЦ=0; ЧГ=0");
	КонецЕсли;

	Представление = СокрЛП(Строка(Ставка));
	Если ПустаяСтрока(Представление) Тогда
		Возврат "0";
	КонецЕсли;

	Если СтрНайти(НРег(Представление), "без") > 0 Тогда
		Возврат "exempt";
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Цифры), "0", Цифры);

КонецФункции

#КонецОбласти
