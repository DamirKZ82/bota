///////////////////////////////////////////////////////////////////////////////
// БотаЖурнал: журнал действий агента (ТЗ п. 8, инструмент get_journal A.10).
//
// Записывается всё, что изменило данные: применённый план, созданный документ,
// поставленная пометка. Требование ТЗ — «кто, когда, что, по какому расхождению»
// плюс то, чем это откатить.
//
// Журнал ведёт 1С, а не оркестратор. Причина не техническая: изменения делает
// база, и запись о них должна пережить смену оркестратора, потерю связи и
// вообще отказ от внешнего сервиса. Бухгалтер обязан видеть, что натворил
// агент, даже если агента больше нет.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Записывает применённое изменение.
//
// Параметры:
//  ПланId        - Строка - идентификатор применённого плана
//  Действие      - Строка - set_link, adjust_lines, create_receipt_from_esf…
//  СессияId      - Строка - диалог, в котором план предложен
//  Документы     - Массив из ДокументСсылка - что изменилось или создано
//  СсылкаОтката  - ДокументСсылка, Неопределено - чем откатить
//  РасхождениеId - Строка - по какому расхождению
//
Процедура ЗаписатьПрименение(ПланId, Действие, СессияId, Документы,
	СсылкаОтката = Неопределено, РасхождениеId = "") Экспорт

	Если Метаданные.РегистрыСведений.Найти("БотаЖурналДействий") = Неопределено Тогда
		// Регистра нет — пишем хотя бы в журнал регистрации: потерять след
		// изменения данных нельзя ни при каких обстоятельствах.
		ЗаписьЖурналаРегистрации("Бота.Изменения", УровеньЖурналаРегистрации.Информация,
			, , СтрШаблон("План %1 (%2) применён пользователем %3",
				ПланId, Действие, Строка(ПользователиИнформационнойБазы.ТекущийПользователь())));
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.БотаЖурналДействий.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ПланId = ПланId;
	Запись.Действие = Действие;
	Запись.СессияId = СессияId;
	Запись.РасхождениеId = РасхождениеId;
	Запись.Пользователь = ТекущийПользователь();
	Запись.Документы = СсылкиСтрокой(Документы);
	Запись.СсылкаОтката = СсылкаОтката;
	Запись.Записать();

КонецПроцедуры

// Журнал за период (инструмент get_journal, A.10).
//
// Параметры:
//  ДатаНачала    - Дата
//  ДатаОкончания - Дата
//  Пользователь  - СправочникСсылка.Пользователи, Неопределено - отбор
//  Страница      - Число
//  РазмерСтраницы - Число
//
// Возвращаемое значение:
//  Структура - items, page, page_size, total, has_more.
//
Функция ЗаПериод(ДатаНачала, ДатаОкончания, Пользователь = Неопределено,
	Страница = 1, РазмерСтраницы = 50) Экспорт

	Пустой = Новый Структура("items, page, page_size, total, has_more",
		Новый Массив, Страница, РазмерСтраницы, 0, Ложь);

	Если Метаданные.РегистрыСведений.Найти("БотаЖурналДействий") = Неопределено Тогда
		Возврат Пустой;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Журнал.Период КАК Период,
		|	Журнал.ПланId КАК ПланId,
		|	Журнал.Действие КАК Действие,
		|	Журнал.СессияId КАК СессияId,
		|	Журнал.Пользователь КАК Пользователь,
		|	Журнал.Документы КАК Документы,
		|	Журнал.СсылкаОтката КАК СсылкаОтката
		|ИЗ
		|	РегистрСведений.БотаЖурналДействий КАК Журнал
		|ГДЕ
		|	Журнал.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (НЕ &ОтборПоПользователю ИЛИ Журнал.Пользователь = &Пользователь)
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("ОтборПоПользователю", ЗначениеЗаполнено(Пользователь));

	Все = Запрос.Выполнить().Выгрузить();

	Элементы = Новый Массив;
	Пропустить = (Страница - 1) * РазмерСтраницы;

	Для Индекс = Пропустить По Мин(Пропустить + РазмерСтраницы, Все.Количество()) - 1 Цикл

		Строка = Все[Индекс];

		Запись = Новый Структура;
		Запись.Вставить("plan_id", Строка.ПланId);
		Запись.Вставить("session_id", Строка.СессияId);
		Запись.Вставить("action", Строка.Действие);
		Запись.Вставить("applied_at", Формат(Строка.Период, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Запись.Вставить("user", Строка(Строка.Пользователь));
		Запись.Вставить("objects", СсылкиИзСтроки(Строка.Документы));
		Запись.Вставить("rollback_ref", ?(ЗначениеЗаполнено(Строка.СсылкаОтката),
			БотаИнструменты.Ссылка(Строка.СсылкаОтката), Неопределено));

		Элементы.Добавить(Запись);

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("page", Страница);
	Результат.Вставить("page_size", РазмерСтраницы);
	Результат.Вставить("total", Все.Количество());
	Результат.Вставить("has_more", Пропустить + Элементы.Количество() < Все.Количество());

	Возврат Результат;

КонецФункции

// Документы, созданные агентом в рамках одного диалога.
//
// Нужно для отката пачки: бухгалтер должен иметь возможность найти всё, что
// агент создал за сеанс, одним списком (ТЗ п. 5.2).
//
Функция ДокументыСессии(СессияId) Экспорт

	Результат = Новый Массив;

	Если Метаданные.РегистрыСведений.Найти("БотаЖурналДействий") = Неопределено
		Или ПустаяСтрока(СессияId) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Журнал.Документы КАК Документы
		|ИЗ
		|	РегистрСведений.БотаЖурналДействий КАК Журнал
		|ГДЕ
		|	Журнал.СессияId = &СессияId";
	Запрос.УстановитьПараметр("СессияId", СессияId);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Ссылка Из СсылкиИзСтроки(Выборка.Документы) Цикл
			Результат.Добавить(Ссылка);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ссылки на документы строкой для хранения в регистре.
//
// Хранится навигационная ссылка, а не GUID: по ней документ открывается прямо
// из журнала, даже если вид документа со временем изменится.
//
Функция СсылкиСтрокой(Документы)

	Части = Новый Массив;

	Для Каждого Ссылка Из Документы Цикл
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Части.Добавить(СтрШаблон("%1|%2|%3",
				Ссылка.Метаданные().ПолноеИмя(),
				Строка(Ссылка.УникальныйИдентификатор()),
				Строка(Ссылка)));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция СсылкиИзСтроки(Значение)

	Результат = Новый Массив;

	Если ПустаяСтрока(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Строка Из СтрРазделить(Значение, Символы.ПС, Ложь) Цикл

		Части = СтрРазделить(Строка, "|", Истина);
		Если Части.Количество() < 3 Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("type", Части[0]);
		Запись.Вставить("uuid", Части[1]);
		Запись.Вставить("presentation", Части[2]);
		Запись.Вставить("nav", СтрШаблон("e1cib/data/%1?ref=%2",
			СтрЗаменить(Части[0], "Документ.", "Документ."), Части[1]));

		Результат.Добавить(Запись);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТекущийПользователь()

	Если Метаданные.Справочники.Найти("Пользователи") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование = &Имя";
	Запрос.УстановитьПараметр("Имя", Имя);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

#КонецОбласти
