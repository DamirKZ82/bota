///////////////////////////////////////////////////////////////////////////////
// БотаПаттерныОкругления: определение источника разницы, R1–R6 (ТЗ п. 4.4).
//
// Ради этого модуля продукт и затевался. Найти, что суммы не сходятся, умеют и
// существующие обработки; ценность в том, чтобы объяснить, почему именно, —
// от этого зависит, что предлагать бухгалтеру.
//
// Здесь же формируются тексты объяснений. Они уходят в поле diagnosis.explanation
// (Приложение А, A.4) и показываются бухгалтеру почти дословно: агенту запрещено
// сочинять свою версию причины, он лишь пересказывает эту.
//
// Порядок проверки — от самой определённой причины к самой общей. Первый
// сработавший паттерн выигрывает: R2 проверяется раньше R1, потому что при
// разной трактовке флага НДС построчные суммы тоже не сойдутся, и R1 дал бы
// формально верное, но бесполезное объяснение.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Определяет источник расхождения сумм в паре.
//
// Параметры:
//  Поступление    - Структура - данные документа из БотаДвижокСверки
//  ЭСФ            - Структура - то же для ЭСФ
//  Сопоставления  - Массив из Структура - см. БотаСопоставлениеСтрок.Сопоставить
//  СтрокиПоступления - Массив из Структура
//  СтрокиЭСФ      - Массив из Структура
//  Допуски        - Структура - допуски из настроек
//
// Возвращаемое значение:
//  Структура:
//   * Паттерн     - Строка, Неопределено - R1..R6; Неопределено, если сумм не расходится
//   * Объяснение  - Строка - готовый текст для бухгалтера
//   * Уверенность - Строка - high | medium | low
//
Функция Определить(Поступление, ЭСФ, Сопоставления, СтрокиПоступления, СтрокиЭСФ, Допуски) Экспорт

	РазницаБезНДС = Поступление.СуммаБезНДС - ЭСФ.СуммаБезНДС;
	РазницаНДС = Поступление.СуммаНДС - ЭСФ.СуммаНДС;

	Если РазницаБезНДС = 0 И РазницаНДС = 0 Тогда
		Возврат Результат(Неопределено, "Суммы документов совпадают полностью.", "high");
	КонецЕсли;

	// R2 — разная трактовка одной и той же цены. Проверяется первым: при нём
	// расходятся сразу и база, и налог, а прочие паттерны объяснили бы только
	// налог.
	Паттерн = ПроверитьR2(Поступление, ЭСФ, Допуски);
	Если Паттерн <> Неопределено Тогда
		Возврат Паттерн;
	КонецЕсли;

	// R5 — валютные документы: разный курс или его дата.
	Паттерн = ПроверитьR5(Поступление, ЭСФ);
	Если Паттерн <> Неопределено Тогда
		Возврат Паттерн;
	КонецЕсли;

	// R1 — построчное округление НДС против округления от итога.
	Паттерн = ПроверитьR1(Поступление, ЭСФ, СтрокиПоступления, СтрокиЭСФ);
	Если Паттерн <> Неопределено Тогда
		Возврат Паттерн;
	КонецЕсли;

	// R3 — цена в ЭСФ точнее двух знаков.
	Паттерн = ПроверитьR3(Сопоставления);
	Если Паттерн <> Неопределено Тогда
		Возврат Паттерн;
	КонецЕсли;

	// R4 — остаток округления, перенесённый на одну строку.
	Паттерн = ПроверитьR4(Сопоставления);
	Если Паттерн <> Неопределено Тогда
		Возврат Паттерн;
	КонецЕсли;

	// R6 — ни один паттерн не подошёл. Это честный ответ: лучше сказать
	// «нужен ручной разбор», чем выдать правдоподобное, но неверное объяснение.
	Возврат Результат("R6",
		СтрШаблон(
			"Расхождение не объясняется ни одним известным паттерном округления."
			+ " Сумма без НДС расходится на %1 ₸, сумма НДС — на %2 ₸."
			+ " Нужен ручной разбор.",
			Формат(РазницаБезНДС, "ЧДЦ=2; ЧРГ=' '"),
			Формат(РазницаНДС, "ЧДЦ=2; ЧРГ=' '")),
		"low");

КонецФункции

// Число знаков после запятой в числе.
//
// Нужно для R3: цена с четырьмя знаками в ЭСФ против двух в базе — типовой
// источник копеечной разницы.
//
Функция ЗнаковПослеЗапятой(Число) Экспорт

	Представление = Формат(Число, "ЧДЦ=6; ЧРД=.; ЧГ=0");
	Позиция = СтрНайти(Представление, ".");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ДробнаяЧасть = Сред(Представление, Позиция + 1);

	// Незначащие нули не считаем: 1200.00 — это два знака, а не шесть.
	Пока СтрДлина(ДробнаяЧасть) > 0 И Прав(ДробнаяЧасть, 1) = "0" Цикл
		ДробнаяЧасть = Лев(ДробнаяЧасть, СтрДлина(ДробнаяЧасть) - 1);
	КонецЦикла;

	Возврат СтрДлина(ДробнаяЧасть);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// R2: НДС «в том числе» против «сверху».
//
// Признак: одна и та же цифра в одном документе означает сумму с налогом,
// а в другом — без него. Проверяется прямым сравнением: сумма с НДС одного
// документа совпадает с суммой без НДС другого.
//
Функция ПроверитьR2(Поступление, ЭСФ, Допуски)

	ДопускДокумента = ДопускДокумента(Поступление, Допуски);

	// Случай 1: в поступлении цена включает НДС, в ЭСФ — нет.
	Если АбсЗначение(Поступление.СуммаСНДС - ЭСФ.СуммаБезНДС) <= ДопускДокумента
		И Поступление.СуммаБезНДС <> ЭСФ.СуммаБезНДС Тогда

		Возврат Результат("R2",
			СтрШаблон(
				"В поступлении включён флаг «Сумма включает НДС»: сумма %1 ₸"
				+ " разложена на %2 ₸ без налога и %3 ₸ НДС. Поставщик же выписал"
				+ " ЭСФ, начислив НДС сверху: %4 ₸ без налога и %5 ₸ НДС."
				+ " Цена в документах одна и та же, различается способ расчёта.",
				Сумма(Поступление.СуммаСНДС), Сумма(Поступление.СуммаБезНДС),
				Сумма(Поступление.СуммаНДС), Сумма(ЭСФ.СуммаБезНДС), Сумма(ЭСФ.СуммаНДС)),
			"high");

	КонецЕсли;

	// Случай 2: зеркальный — НДС сверху в поступлении, «в том числе» в ЭСФ.
	Если АбсЗначение(ЭСФ.СуммаСНДС - Поступление.СуммаБезНДС) <= ДопускДокумента
		И Поступление.СуммаБезНДС <> ЭСФ.СуммаБезНДС Тогда

		Возврат Результат("R2",
			СтрШаблон(
				"В поступлении НДС начислен сверху (%1 ₸ без налога, %2 ₸ НДС),"
				+ " а в ЭСФ та же сумма %3 ₸ указана как включающая налог"
				+ " (%4 ₸ без НДС, %5 ₸ НДС).",
				Сумма(Поступление.СуммаБезНДС), Сумма(Поступление.СуммаНДС),
				Сумма(ЭСФ.СуммаСНДС), Сумма(ЭСФ.СуммаБезНДС), Сумма(ЭСФ.СуммаНДС)),
			"high");

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// R1: построчное округление НДС против округления от итога.
//
// Признак: сумма построчного НДС отличается от НДС, посчитанного от итоговой
// базы, и именно этой разницей объясняется расхождение с ЭСФ.
//
Функция ПроверитьR1(Поступление, ЭСФ, СтрокиПоступления, СтрокиЭСФ)

	Ставка = ЕдинаяСтавка(СтрокиПоступления);
	Если Ставка = Неопределено Или Ставка = 0 Тогда
		// При разных ставках в документе «НДС от итога» не определён:
		// сравнивать нечего, паттерн не применим.
		Возврат Неопределено;
	КонецЕсли;

	НДСОтИтога = Окр(Поступление.СуммаБезНДС * Ставка / 100, 2);
	НДСПострочно = Поступление.СуммаНДС;

	// Разница между способами счёта должна совпасть с разницей с ЭСФ:
	// иначе причина в чём-то другом.
	РазницаСпособов = НДСОтИтога - НДСПострочно;
	РазницаСЭСФ = ЭСФ.СуммаНДС - НДСПострочно;

	Если РазницаСпособов = 0 Или РазницаСпособов <> РазницаСЭСФ Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Разница обязана укладываться в накопленное округление по строкам:
	// по копейке на строку, не больше.
	Если АбсЗначение(РазницаСпособов) > 0.01 * Макс(Поступление.ЧислоСтрок, 1) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат("R1",
		СтрШаблон(
			"В поступлении НДС посчитан построчно и округлён в каждой строке —"
			+ " в сумме %1 ₸. В ЭСФ налог рассчитан от итога: %2 ₸ × %3 %% = %4 ₸."
			+ " Разница %5 ₸ — это накопленное округление, а не ошибка.",
			Сумма(НДСПострочно), Сумма(Поступление.СуммаБезНДС), Ставка,
			Сумма(ЭСФ.СуммаНДС), Сумма(АбсЗначение(РазницаСпособов))),
		"high");

КонецФункции

// R3: цена в ЭСФ точнее, чем в базе.
Функция ПроверитьR3(Сопоставления)

	Для Каждого Сопоставление Из Сопоставления Цикл

		Если Сопоставление.СтрокаПоступления = Неопределено
			Или Сопоставление.СтрокиЭСФ.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПоступления = Сопоставление.СтрокаПоступления;
		СтрокаЭСФ = Сопоставление.СтрокиЭСФ[0];

		ЗнаковВЭСФ = ЗнаковПослеЗапятой(СтрокаЭСФ.Цена);
		ЗнаковВБазе = ЗнаковПослеЗапятой(СтрокаПоступления.Цена);

		Если ЗнаковВЭСФ <= 2 Или ЗнаковВЭСФ <= ЗнаковВБазе Тогда
			Продолжить;
		КонецЕсли;

		// Цена в базе должна быть округлением цены из ЭСФ, иначе это просто
		// разные цены, а не потеря точности.
		Если Окр(СтрокаЭСФ.Цена, ЗнаковВБазе) <> СтрокаПоступления.Цена Тогда
			Продолжить;
		КонецЕсли;

		Возврат Результат("R3",
			СтрШаблон(
				"В строке %1 «%2» цена в ЭСФ указана с точностью %3 знаков"
				+ " (%4 ₸), а в базе округлена до %5 знаков (%6 ₸)."
				+ " На количестве %7 это даёт разницу %8 ₸.",
				СтрокаПоступления.Номер, СтрокаПоступления.Наименование,
				ЗнаковВЭСФ, Формат(СтрокаЭСФ.Цена, "ЧДЦ=6; ЧРГ=' '"),
				ЗнаковВБазе, Сумма(СтрокаПоступления.Цена),
				Формат(СтрокаПоступления.Количество, "ЧДЦ=3; ЧРГ=' '"),
				Сумма(АбсЗначение(Сопоставление.Разницы.Сумма))),
			"high");

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// R4: остаток округления, перенесённый на одну строку.
//
// Признак: все строки сошлись, кроме ровно одной, и та разошлась на копейки.
// Так ведут себя программы, которые распределяют разницу округления итога
// на последнюю строку документа.
//
Функция ПроверитьR4(Сопоставления)

	Расходящиеся = Новый Массив;
	Всего = 0;

	Для Каждого Сопоставление Из Сопоставления Цикл

		Если Сопоставление.СтрокаПоступления = Неопределено Тогда
			// Строка только в ЭСФ — это другой разговор, не про округление.
			Возврат Неопределено;
		КонецЕсли;

		Всего = Всего + 1;
		Разницы = Сопоставление.Разницы;

		Если Разницы.Сумма <> 0 Или Разницы.СуммаНДС <> 0 Тогда
			Расходящиеся.Добавить(Сопоставление);
		КонецЕсли;

	КонецЦикла;

	Если Расходящиеся.Количество() <> 1 Или Всего < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Единственное = Расходящиеся[0];
	Отклонение = Макс(
		АбсЗначение(Единственное.Разницы.Сумма),
		АбсЗначение(Единственное.Разницы.СуммаНДС));

	Если Отклонение = 0 Или Отклонение > 0.05 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат("R4",
		СтрШаблон(
			"Из %1 строк документа совпали все, кроме строки %2 «%3»:"
			+ " она расходится на %4 ₸. Похоже на остаток округления,"
			+ " перенесённый на одну строку.",
			Всего, Единственное.СтрокаПоступления.Номер,
			Единственное.СтрокаПоступления.Наименование, Сумма(Отклонение)),
		"medium");

КонецФункции

// R5: пересчёт валюты.
Функция ПроверитьR5(Поступление, ЭСФ)

	// Валютные реквизиты есть не во всех релизах: если их нет, паттерн
	// просто не проверяется — это лучше, чем падать.
	Имена = БотаМетаданныеТиповой.Имена();

	ВалютаПоступления = БотаМетаданныеТиповой.ЗначениеРеквизита(
		Поступление.Ссылка, Имена.РеквизитВалюта);
	Если Не ЗначениеЗаполнено(ВалютаПоступления) Тогда
		Возврат Неопределено;
	КонецЕсли;

	КурсПоступления = БотаМетаданныеТиповой.ЗначениеРеквизита(
		Поступление.Ссылка, Имена.РеквизитКурс);
	КурсЭСФ = БотаМетаданныеТиповой.ЗначениеРеквизита(ЭСФ.Ссылка, Имена.РеквизитКурс);

	Если Не ЗначениеЗаполнено(КурсПоступления) Или Не ЗначениеЗаполнено(КурсЭСФ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если КурсПоступления = КурсЭСФ Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат("R5",
		СтрШаблон(
			"Документы в валюте «%1» пересчитаны по разным курсам:"
			+ " в поступлении %2, в ЭСФ %3. Проверьте дату курса.",
			Строка(ВалютаПоступления),
			Формат(КурсПоступления, "ЧДЦ=4"), Формат(КурсЭСФ, "ЧДЦ=4")),
		"high");

КонецФункции

// Единая ставка НДС документа или Неопределено, если ставок несколько.
Функция ЕдинаяСтавка(Строки)

	Ставка = Неопределено;

	Для Каждого Строка Из Строки Цикл

		Текущая = ЧисловаяСтавка(Строка.СтавкаНДС);
		Если Текущая = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Ставка = Неопределено Тогда
			Ставка = Текущая;
		ИначеЕсли Ставка <> Текущая Тогда
			Возврат Неопределено;
		КонецЕсли;

	КонецЦикла;

	Возврат Ставка;

КонецФункции

// Ставка НДС числом.
//
// В типовой ставка — перечисление («НДС16», «БезНДС»), поэтому разбирается
// представление: так функция переживает и смену ставки, и смену типа реквизита.
//
Функция ЧисловаяСтавка(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Представление = НРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Представление) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если СтрНайти(Представление, "без") > 0 Тогда
		Возврат 0;
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Цифры), Неопределено, Число(Цифры));

КонецФункции

// Допуск на документ: 0,01 × число строк, но не более потолка (ТЗ п. 4.4).
Функция ДопускДокумента(Поступление, Допуски)

	НаСтроку = ?(Допуски.Свойство("ДопускНаСтроку"), Допуски.ДопускНаСтроку, 0.01);
	Потолок = ?(Допуски.Свойство("ПотолокДокумента"), Допуски.ПотолокДокумента, 5);

	Возврат Мин(НаСтроку * Макс(Поступление.ЧислоСтрок, 1), Потолок);

КонецФункции

Функция Результат(Паттерн, Объяснение, Уверенность)

	Возврат Новый Структура("Паттерн, Объяснение, Уверенность",
		Паттерн, Объяснение, Уверенность);

КонецФункции

// Сумма для вставки в текст объяснения: как в 1С, с разделителем разрядов.
Функция Сумма(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРГ=' '");

КонецФункции

Функция АбсЗначение(Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

