///////////////////////////////////////////////////////////////////////////////
// БотаОтчётСверки: данные для отчёта «Сверка поступлений и ЭСФ» (ТЗ п. 7).
//
// Отчёт на СКД поверх того же движка, что и агент, — для тех, кому нужна
// просто таблица без диалога. Это **этап 1 и самостоятельная поставка**:
// он полезен сам по себе, и именно на нём проверяется главное — совпадает ли
// классификация расхождений с тем, что бухгалтер нашёл бы руками.
//
// Пока отчёт не сошёлся с ручной сверкой за реальный квартал, подключать агента
// рано: он будет уверенно и убедительно пересказывать неверные данные, а это
// хуже, чем отсутствие агента.
//
// Схема компоновки строится на внешнем наборе данных: движок отдаёт готовую
// таблицу, СКД её группирует и оформляет. Так расчёт остаётся в одном месте
// и не расползается по запросам схемы.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Таблица расхождений для внешнего набора данных СКД.
//
// Параметры:
//  Организация   - СправочникСсылка.Организации
//  ДатаНачала    - Дата
//  ДатаОкончания - Дата
//  Контрагент    - СправочникСсылка.Контрагенты, Неопределено
//  ТолькоСущественные - Булево - скрыть расхождения в допуске (D14)
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ОписаниеКолонок().
//
Функция ТаблицаРасхождений(Организация, ДатаНачала, ДатаОкончания,
	Контрагент = Неопределено, ТолькоСущественные = Ложь) Экспорт

	Сводка = БотаСверкаПериода.Выполнить(Организация, ДатаНачала, ДатаОкончания, Контрагент);
	Таблица = ПустаяТаблица();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Расхождения.ДанныеКарточки КАК ДанныеКарточки
		|ИЗ
		|	РегистрСведений.БотаРасхождения КАК Расхождения
		|ГДЕ
		|	Расхождения.ИдРасчёта = &ИдРасчёта";
	Запрос.УстановитьПараметр("ИдРасчёта", Сводка.calc_id);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Карточка = Выборка.ДанныеКарточки.Получить();
		Если Карточка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ТолькоСущественные И Карточка.Код = "D14" Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьСтроку(Таблица.Добавить(), Карточка);

	КонецЦикла;

	// Сортировка по критичности, затем по влиянию на НДС: бухгалтер должен
	// увидеть дорогое сверху, а не в конце третьей страницы.
	Таблица.Сортировать("ВесКритичности Убыв, ВлияниеНДС Убыв");

	Возврат Таблица;

КонецФункции

// Итоги округлений за период — то, ради чего продукт задуман (ТЗ п. 4.4).
//
// Отдельная таблица, потому что в отчёте это отдельный блок: «вот сумма,
// которая объясняет хвост в декларации 300.00».
//
Функция ТаблицаОкруглений(Организация, ДатаНачала, ДатаОкончания,
	Контрагент = Неопределено) Экспорт

	Сводка = БотаСверкаПериода.Выполнить(Организация, ДатаНачала, ДатаОкончания, Контрагент);

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Паттерн", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("РазницаНДС", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(15, 2)));

	Для Каждого Строка Из Сводка.rounding.by_pattern Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Паттерн = Строка.pattern;
		НоваяСтрока.Источник = ОписаниеПаттерна(Строка.pattern);
		НоваяСтрока.Количество = Строка.count;
		НоваяСтрока.РазницаНДС = Число(Строка.diff_vat);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Сводка периода для шапки отчёта.
Функция СводкаПериода(Организация, ДатаНачала, ДатаОкончания,
	Контрагент = Неопределено) Экспорт

	Сводка = БотаСверкаПериода.Выполнить(Организация, ДатаНачала, ДатаОкончания, Контрагент);

	Результат = Новый Структура;
	Результат.Вставить("Поступлений", Сводка.scope.receipts_total);
	Результат.Вставить("ЭСФ", Сводка.scope.esf_total);
	Результат.Вставить("СвязаныЯвно", Сводка.scope.pairs_linked);
	Результат.Вставить("СвязьПредположена", Сводка.scope.pairs_suggested);
	Результат.Вставить("ПоступленийБезЭСФ", Сводка.scope.receipts_without_esf);
	Результат.Вставить("ЭСФБезПоступлений", Сводка.scope.esf_without_receipt);
	Результат.Вставить("НепроведённыхПоступлений", Сводка.scope.receipts_unposted);
	Результат.Вставить("НДСПоступлений", Число(Сводка.vat_totals.receipts_vat));
	Результат.Вставить("НДСПоЭСФ", Число(Сводка.vat_totals.esf_vat));
	Результат.Вставить("РазницаНДС", Число(Сводка.vat_totals.diff));
	Результат.Вставить("НакопленноеОкругление", Число(Сводка.rounding.total_diff_vat));
	Результат.Вставить("ИзКэша", Сводка.from_cache);

	Возврат Результат;

КонецФункции

// Описание колонок для настройки схемы компоновки.
//
// Возвращаемое значение:
//  Соответствие - имя колонки → представление для пользователя.
//
Функция ОписаниеКолонок() Экспорт

	Колонки = Новый Соответствие;

	Колонки.Вставить("Код", "Код");
	Колонки.Вставить("Расхождение", "Расхождение");
	Колонки.Вставить("Критичность", "Критичность");
	Колонки.Вставить("Паттерн", "Паттерн округления");
	Колонки.Вставить("Контрагент", "Контрагент");
	Колонки.Вставить("Поступление", "Поступление");
	Колонки.Вставить("ЭСФ", "ЭСФ");
	Колонки.Вставить("ДатаПоступления", "Дата поступления");
	Колонки.Вставить("ДатаОборота", "Дата оборота");
	Колонки.Вставить("СуммаБезНДСПоступления", "Без НДС (база)");
	Колонки.Вставить("СуммаБезНДСЭСФ", "Без НДС (ЭСФ)");
	Колонки.Вставить("НДСПоступления", "НДС (база)");
	Колонки.Вставить("НДСЭСФ", "НДС (ЭСФ)");
	Колонки.Вставить("РазницаНДС", "Разница НДС");
	Колонки.Вставить("ВлияниеНДС", "Влияние на зачёт");
	Колонки.Вставить("Объяснение", "Причина");
	Колонки.Вставить("Статус", "Статус");

	Возврат Колонки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустаяТаблица()

	Таблица = Новый ТаблицаЗначений;

	ТипСтроки = Новый ОписаниеТипов("Строка");
	ТипДаты = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ТипЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0));

	Таблица.Колонки.Добавить("Ид", ТипСтроки);
	Таблица.Колонки.Добавить("Код", ТипСтроки);
	Таблица.Колонки.Добавить("Расхождение", ТипСтроки);
	Таблица.Колонки.Добавить("Критичность", ТипСтроки);
	Таблица.Колонки.Добавить("ВесКритичности", ТипЧисла);
	Таблица.Колонки.Добавить("Паттерн", ТипСтроки);
	Таблица.Колонки.Добавить("Контрагент");
	Таблица.Колонки.Добавить("Поступление");
	Таблица.Колонки.Добавить("ЭСФ");
	Таблица.Колонки.Добавить("ДатаПоступления", ТипДаты);
	Таблица.Колонки.Добавить("ДатаОборота", ТипДаты);
	Таблица.Колонки.Добавить("СуммаБезНДСПоступления", ТипСуммы);
	Таблица.Колонки.Добавить("СуммаБезНДСЭСФ", ТипСуммы);
	Таблица.Колонки.Добавить("НДСПоступления", ТипСуммы);
	Таблица.Колонки.Добавить("НДСЭСФ", ТипСуммы);
	Таблица.Колонки.Добавить("РазницаНДС", ТипСуммы);
	Таблица.Колонки.Добавить("ВлияниеНДС", ТипСуммы);
	Таблица.Колонки.Добавить("Объяснение", ТипСтроки);
	Таблица.Колонки.Добавить("Статус", ТипСтроки);

	Возврат Таблица;

КонецФункции

Процедура ЗаполнитьСтроку(Строка, Карточка)

	Строка.Ид = Карточка.Ид;
	Строка.Код = Карточка.Код;
	Строка.Расхождение = ОписаниеКода(Карточка.Код);
	Строка.Критичность = ПредставлениеКритичности(Карточка.Критичность);
	Строка.ВесКритичности = ВесКритичности(Карточка.Критичность);
	Строка.Паттерн = ?(Карточка.Паттерн = Неопределено, "", Карточка.Паттерн);
	Строка.Объяснение = Карточка.Объяснение;
	Строка.Статус = ПредставлениеСтатуса(Карточка.Статус);
	Строка.ВлияниеНДС = Карточка.ВлияниеНДС;

	Если Карточка.Поступление <> Неопределено Тогда
		Строка.Поступление = Карточка.Поступление.Ссылка;
		Строка.Контрагент = Карточка.Поступление.Контрагент;
		Строка.ДатаПоступления = НачалоДня(Карточка.Поступление.Дата);
		Строка.СуммаБезНДСПоступления = Карточка.Поступление.СуммаБезНДС;
		Строка.НДСПоступления = Карточка.Поступление.СуммаНДС;
	КонецЕсли;

	Если Карточка.ЭСФ <> Неопределено Тогда
		Строка.ЭСФ = Карточка.ЭСФ.Ссылка;
		Если Не ЗначениеЗаполнено(Строка.Контрагент) Тогда
			Строка.Контрагент = Карточка.ЭСФ.Контрагент;
		КонецЕсли;
		Строка.ДатаОборота = НачалоДня(?(ЗначениеЗаполнено(Карточка.ЭСФ.ДатаОборота),
			Карточка.ЭСФ.ДатаОборота, Карточка.ЭСФ.Дата));
		Строка.СуммаБезНДСЭСФ = Карточка.ЭСФ.СуммаБезНДС;
		Строка.НДСЭСФ = Карточка.ЭСФ.СуммаНДС;
	КонецЕсли;

	Строка.РазницаНДС = Строка.НДСЭСФ - Строка.НДСПоступления;

КонецПроцедуры

// Описание кода расхождения (ТЗ п. 4.5).
//
// Тексты те же, что уходят агенту: бухгалтер видит одинаковые формулировки
// в отчёте и в диалоге, иначе решит, что это разные вещи.
//
Функция ОписаниеКода(Код)

	Если Код = "D01" Тогда
		Возврат "Поступление без ЭСФ (срок выписки не истёк)";
	ИначеЕсли Код = "D02" Тогда
		Возврат "Поступление без ЭСФ (срок истёк)";
	ИначеЕсли Код = "D03" Тогда
		Возврат "ЭСФ без поступления";
	ИначеЕсли Код = "D04" Тогда
		Возврат "Найдена предполагаемая связь, не установлена";
	ИначеЕсли Код = "D05" Тогда
		Возврат "Разная ставка НДС";
	ИначеЕсли Код = "D06" Тогда
		Возврат "Расхождение суммы НДС выше допуска";
	ИначеЕсли Код = "D07" Тогда
		Возврат "Расхождение суммы без НДС выше допуска";
	ИначеЕсли Код = "D08" Тогда
		Возврат "Разные периоды НДС (дата оборота в другом квартале)";
	ИначеЕсли Код = "D09" Тогда
		Возврат "ЭСФ аннулирована или отозвана, поступление активно";
	ИначеЕсли Код = "D10" Тогда
		Возврат "Исправленная ЭСФ — поступление по старой";
	ИначеЕсли Код = "D11" Тогда
		Возврат "Расхождение по строкам при совпадении итогов";
	ИначеЕсли Код = "D12" Тогда
		Возврат "Строка только в поступлении или только в ЭСФ";
	ИначеЕсли Код = "D13" Тогда
		Возврат "Расхождение единиц измерения";
	ИначеЕсли Код = "D14" Тогда
		Возврат "Копеечное расхождение в допуске";
	ИначеЕсли Код = "D15" Тогда
		Возврат "Контрагент не плательщик НДС на дату оборота";
	ИначеЕсли Код = "D16" Тогда
		Возврат "Поступление не проведено";
	КонецЕсли;

	Возврат Код;

КонецФункции

Функция ОписаниеПаттерна(Паттерн)

	Если Паттерн = "R1" Тогда
		Возврат "Построчное округление НДС против округления от итога";
	ИначеЕсли Паттерн = "R2" Тогда
		Возврат "НДС «в том числе» против «сверху»";
	ИначеЕсли Паттерн = "R3" Тогда
		Возврат "Округление цены";
	ИначеЕсли Паттерн = "R4" Тогда
		Возврат "Остаток округления на одной строке";
	ИначеЕсли Паттерн = "R5" Тогда
		Возврат "Пересчёт валюты";
	ИначеЕсли Паттерн = "R6" Тогда
		Возврат "Необъяснимая разница, нужен ручной разбор";
	КонецЕсли;

	Возврат Паттерн;

КонецФункции

Функция ПредставлениеКритичности(Критичность)

	Если Критичность = "high" Тогда
		Возврат "Высокая";
	ИначеЕсли Критичность = "medium" Тогда
		Возврат "Средняя";
	ИначеЕсли Критичность = "low" Тогда
		Возврат "Низкая";
	КонецЕсли;

	Возврат "Инфо";

КонецФункции

Функция ПредставлениеСтатуса(Статус)

	Если Статус = "reviewed" Тогда
		Возврат "Рассмотрено";
	ИначеЕсли Статус = "fixed" Тогда
		Возврат "Исправлено";
	КонецЕсли;

	Возврат "Открыто";

КонецФункции

Функция ВесКритичности(Критичность)

	Если Критичность = "high" Тогда
		Возврат 3;
	ИначеЕсли Критичность = "medium" Тогда
		Возврат 2;
	ИначеЕсли Критичность = "low" Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти
