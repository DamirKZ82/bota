///////////////////////////////////////////////////////////////////////////////
// БотаМетаданныеТиповой: единственное место, где расширение знает имена
// объектов типовой конфигурации.
//
// Имена выверены по метаданным реальной базы «Бухгалтерия для Казахстана»
// (стандартный интерфейс OData, 21.08.2026). Проверить на своей базе:
// БотаМетаданныеТиповой.ПроверитьСовместимость() вернёт список несовпадений.
//
// Главное, что выяснилось при сверке и чего нет в ТЗ: **связь трёхзвенная**.
//
//   ПоступлениеТоваровУслуг ← ДокументОснование ← СчетФактураПолученный
//   СчетФактураПолученный   ← СчетФактура       ← ЭСФ
//
// Документ «ЭСФ» — это выгрузка из ИС ЭСФ (регистрационный номер, статус,
// ЭЦП, дата оборота), а «СчетФактураПолученный» — учётный счёт-фактура.
// Сверять надо с ЭСФ, а связь с поступлением искать через счёт-фактуру.
//
// Второе: у ЭСФ и поступления **разные имена полей строк**. В ЭСФ наименование
// поставщика лежит в «ТоварНаименование», сумма без налога — в «СуммаБезНалогов»,
// ставка числом — в «СтавкаНДСЧисло». Поэтому наборы имён разведены.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имена объектов конфигурации, с которыми работает расширение.
//
// ЭТО ЕДИНСТВЕННОЕ МЕСТО, которое нужно править при несовпадении имён.
//
// Возвращаемое значение:
//  Структура - имена объектов, реквизитов и табличных частей.
//
Функция Имена() Экспорт

	Имена = Новый Структура;

	// --- Документы ---
	Имена.Вставить("ДокументПоступление", "ПоступлениеТоваровУслуг");
	Имена.Вставить("ДокументСчетФактура", "СчетФактураПолученный");
	Имена.Вставить("ДокументЭСФ", "ЭСФ");
	Имена.Вставить("ДокументКорректировка", "КорректировкаПоступления");

	// В MVP не участвуют (ТЗ, открытый вопрос 6), но имена держим здесь же.
	Имена.Вставить("ДокументДопРасходы", "ПоступлениеДопРасходов");
	Имена.Вставить("ДокументАвансовыйОтчет", "АвансовыйОтчет");

	// --- Табличные части ---
	// «ОС» и «НМА» намеренно не берём: у них другой состав полей и другая
	// логика сверки, в MVP они не участвуют.
	ЧастиПоступления = Новый Массив;
	ЧастиПоступления.Добавить("Товары");
	ЧастиПоступления.Добавить("Услуги");
	Имена.Вставить("ТабличныеЧастиПоступления", ЧастиПоступления);

	ЧастиСчетаФактуры = Новый Массив;
	ЧастиСчетаФактуры.Добавить("Товары");
	ЧастиСчетаФактуры.Добавить("Услуги");
	Имена.Вставить("ТабличныеЧастиСчетаФактуры", ЧастиСчетаФактуры);

	ЧастиЭСФ = Новый Массив;
	ЧастиЭСФ.Добавить("Товары");
	Имена.Вставить("ТабличныеЧастиЭСФ", ЧастиЭСФ);

	// --- Шапка поступления ---
	Имена.Вставить("РеквизитОрганизация", "Организация");
	Имена.Вставить("РеквизитКонтрагент", "Контрагент");
	Имена.Вставить("РеквизитДоговор", "ДоговорКонтрагента");
	Имена.Вставить("РеквизитСклад", "Склад");
	Имена.Вставить("РеквизитВалюта", "ВалютаДокумента");
	Имена.Вставить("РеквизитКурс", "КурсВзаиморасчетов");
	Имена.Вставить("РеквизитСуммаДокумента", "СуммаДокумента");
	// Источник паттерна R2. Не путать с «НДСВключенВСтоимость» — тот про
	// включение налога в стоимость запасов, а не про способ расчёта.
	Имена.Вставить("РеквизитСуммаВключаетНДС", "СуммаВключаетНДС");
	Имена.Вставить("РеквизитУчитыватьНДС", "УчитыватьНДС");

	// --- Строки поступления и счёта-фактуры ---
	// Поля «Всего» в типовой нет: итог строки считается сложением уже
	// посчитанных типовой значений, своей арифметики не изобретаем.
	Имена.Вставить("СтрокаНоменклатура", "Номенклатура");
	Имена.Вставить("СтрокаКоличество", "Количество");
	Имена.Вставить("СтрокаЦена", "Цена");
	Имена.Вставить("СтрокаСумма", "Сумма");
	Имена.Вставить("СтрокаСтавкаНДС", "СтавкаНДС");
	Имена.Вставить("СтрокаСуммаНДС", "СуммаНДС");
	Имена.Вставить("СтрокаЕдиницаИзмерения", "ЕдиницаИзмерения");

	// --- Строки ЭСФ: имена другие ---
	Имена.Вставить("ЭСФСтрокаНаименование", "ТоварНаименование");
	Имена.Вставить("ЭСФСтрокаНоменклатура", "Товар");
	Имена.Вставить("ЭСФСтрокаЕдиница", "ЕдиницаИзмеренияНаименование");
	Имена.Вставить("ЭСФСтрокаКоличество", "Количество");
	Имена.Вставить("ЭСФСтрокаЦена", "Цена");
	Имена.Вставить("ЭСФСтрокаСуммаБезНДС", "СуммаБезНалогов");
	Имена.Вставить("ЭСФСтрокаСтавка", "СтавкаНДСЧисло");
	Имена.Вставить("ЭСФСтрокаСуммаНДС", "СуммаНДС");
	Имена.Вставить("ЭСФСтрокаВсего", "Сумма");

	// --- Шапка ЭСФ ---
	Имена.Вставить("ЭСФДатаОборота", "ДатаОборота");
	Имена.Вставить("ЭСФРегНомер", "РегистрационныйНомер");
	Имена.Вставить("ЭСФСтатус", "Статус");
	Имена.Вставить("ЭСФСостояние", "Состояние");
	Имена.Вставить("ЭСФВид", "Вид");
	Имена.Вставить("ЭСФНаправление", "Направление");
	Имена.Вставить("ЭСФСвязанныйЭСФ", "СвязанныйЭСФ");
	// Связь ЭСФ с учётным счётом-фактурой — среднее звено цепочки.
	Имена.Вставить("ЭСФСчетФактура", "СчетФактура");

	// --- Шапка счёта-фактуры ---
	Имена.Вставить("СФДокументОснование", "ДокументОснование");
	Имена.Вставить("СФТаблицаОснований", "ДокументыОснования");
	Имена.Вставить("СФДатаОборота", "ДатаСовершенияОборотаПоРеализации");
	Имена.Вставить("СФВид", "ВидСчетаФактуры");
	Имена.Вставить("СФОсновнойСчетФактура", "ОсновнойСчетФактура");

	// --- Справочники ---
	Имена.Вставить("СправочникОрганизации", "Организации");
	Имена.Вставить("СправочникКонтрагенты", "Контрагенты");
	Имена.Вставить("СправочникНоменклатура", "Номенклатура");
	Имена.Вставить("СправочникДоговоры", "ДоговорыКонтрагентов");
	Имена.Вставить("СправочникСклады", "Склады");

	Имена.Вставить("РеквизитБИН", "БИН");
	Имена.Вставить("РеквизитБИНАльт", "ИНН");

	// Счёт учёта НДС к возмещению (инструмент get_vat_turnover, A.8).
	Имена.Вставить("СчетНДСКВозмещению", "1420");

	Возврат Имена;

КонецФункции

// Проверяет, что имена из Имена() существуют в текущей конфигурации.
//
// Запускать после установки расширения и после каждого обновления типовой.
//
// Возвращаемое значение:
//  Массив из Строка - описания несовпадений, по одному на проблему.
//
Функция ПроверитьСовместимость() Экспорт

	Проблемы = Новый Массив;
	Имена = Имена();

	ПроверитьДокумент(Проблемы, Имена.ДокументПоступление,
		"Организация,Контрагент,СуммаВключаетНДС", Имена.ТабличныеЧастиПоступления);

	ПроверитьДокумент(Проблемы, Имена.ДокументСчетФактура,
		Имена.СФДокументОснование, Имена.ТабличныеЧастиСчетаФактуры);

	ПроверитьДокумент(Проблемы, Имена.ДокументЭСФ,
		Имена.ЭСФДатаОборота + "," + Имена.ЭСФСтатус + "," + Имена.ЭСФСчетФактура,
		Имена.ТабличныеЧастиЭСФ);

	// Строки ЭСФ: без наименования поставщика сопоставление уровня 2 работать
	// не будет, а без сумм — вся сверка.
	МетаданныеЭСФ = Метаданные.Документы.Найти(Имена.ДокументЭСФ);
	Если МетаданныеЭСФ <> Неопределено Тогда
		ЧастьТовары = МетаданныеЭСФ.ТабличныеЧасти.Найти("Товары");
		Если ЧастьТовары <> Неопределено Тогда
			ПроверитьРеквизитыКоллекции(Проблемы, ЧастьТовары.Реквизиты,
				Имена.ЭСФСтрокаНаименование + "," + Имена.ЭСФСтрокаСуммаБезНДС
					+ "," + Имена.ЭСФСтрокаСуммаНДС,
				СтрШаблон("табличная часть «Товары» документа «%1»", Имена.ДокументЭСФ));
		КонецЕсли;
	КонецЕсли;

	Для Каждого ИмяСправочника Из СписокСправочников(Имена) Цикл
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("Не найден справочник «%1»", ИмяСправочника));
		КонецЕсли;
	КонецЦикла;

	Возврат Проблемы;

КонецФункции

// Строки табличных частей документа, приведённые к единому виду.
//
// Движку сверки всё равно, откуда взялась позиция — из «Товаров» поступления
// или из «Товаров» ЭСФ с их особыми именами полей. Он сравнивает однотипные
// структуры.
//
// Параметры:
//  Ссылка - ДокументСсылка - поступление, счёт-фактура или ЭСФ.
//
// Возвращаемое значение:
//  Массив из Структура - Номер, Номенклатура, Наименование, Единица,
//   Количество, Цена, Сумма, СтавкаНДС, СуммаНДС, Всего.
//
Функция СтрокиДокумента(Ссылка) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Имена = Имена();
	ЭтоДокументЭСФ = ЭтоЭСФ(Ссылка);

	Если ЭтоДокументЭСФ Тогда
		ИменаЧастей = Имена.ТабличныеЧастиЭСФ;
	ИначеЕсли ЭтоСчетФактура(Ссылка) Тогда
		ИменаЧастей = Имена.ТабличныеЧастиСчетаФактуры;
	Иначе
		ИменаЧастей = Имена.ТабличныеЧастиПоступления;
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	СквознойНомер = 0;
	Для Каждого ИмяЧасти Из ИменаЧастей Цикл

		ТабличнаяЧасть = ПолучитьТабличнуюЧасть(Объект, ИмяЧасти);
		Если ТабличнаяЧасть = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			СквознойНомер = СквознойНомер + 1;
			Если ЭтоДокументЭСФ Тогда
				Результат.Добавить(ПривестиСтрокуЭСФ(СтрокаТЧ, СквознойНомер, Имена));
			Иначе
				Результат.Добавить(ПривестиСтрокуУчёта(СтрокаТЧ, СквознойНомер, Имена));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поступление, к которому относится ЭСФ.
//
// Проходит цепочку ЭСФ → счёт-фактура → поступление. Прямой связи между ЭСФ и
// поступлением в типовой нет, и попытка искать её напрямую не находит ничего.
//
// Параметры:
//  ЭСФ - ДокументСсылка.ЭСФ
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - поступление.
//
Функция ПоступлениеПоЭСФ(ЭСФ) Экспорт

	СчетФактура = СчетФактураПоЭСФ(ЭСФ);
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПоступлениеПоСчетуФактуре(СчетФактура);

КонецФункции

// Учётный счёт-фактура, к которому привязана ЭСФ.
Функция СчетФактураПоЭСФ(ЭСФ) Экспорт

	Значение = ЗначениеРеквизита(ЭСФ, Имена().ЭСФСчетФактура);

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Неопределено);

КонецФункции

// Поступление, на основании которого выписан счёт-фактура.
//
// Основание хранится и реквизитом, и табличной частью: в части релизов
// счёт-фактура выписывается по нескольким документам сразу.
//
Функция ПоступлениеПоСчетуФактуре(СчетФактура) Экспорт

	Имена = Имена();

	Значение = ЗначениеРеквизита(СчетФактура, Имена.СФДокументОснование);
	Если ЗначениеЗаполнено(Значение) И ЭтоПоступление(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	// Табличная часть оснований: берём первое поступление.
	Основания = ТабличнаяЧастьДокумента(СчетФактура, Имена.СФТаблицаОснований);
	Если Основания <> Неопределено Тогда
		Для Каждого Строка Из Основания Цикл
			Основание = ЗначениеПоля(Строка, Имена.СФДокументОснование);
			Если ЗначениеЗаполнено(Основание) И ЭтоПоступление(Основание) Тогда
				Возврат Основание;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// БИН контрагента или организации.
Функция БИН(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Имена = Имена();

	Значение = ЗначениеРеквизита(Ссылка, Имена.РеквизитБИН);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	// В части конфигураций поле называется ИНН и хранит БИН.
	Значение = ЗначениеРеквизита(Ссылка, Имена.РеквизитБИНАльт);
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Значение), "");

КонецФункции

Функция ЭтоЭСФ(Ссылка) Экспорт

	Возврат ЭтоДокументВида(Ссылка, Имена().ДокументЭСФ);

КонецФункции

Функция ЭтоСчетФактура(Ссылка) Экспорт

	Возврат ЭтоДокументВида(Ссылка, Имена().ДокументСчетФактура);

КонецФункции

Функция ЭтоПоступление(Ссылка) Экспорт

	Возврат ЭтоДокументВида(Ссылка, Имена().ДокументПоступление);

КонецФункции

// Подставляет имена объектов в шаблон запроса по именованным ключам.
//
// СтрШаблон ограничен десятью подстановками (%1…%10) на любой версии
// платформы, а в запросе к ЭСФ имён больше. К тому же тринадцать позиционных
// параметров нечитаемы: при правке легко перепутать порядок и получить
// синтаксически верный запрос не к тем полям.
//
// Здесь ключи именованные: «%ДокументЭСФ%», «%ДатаОборота%».
//
// Параметры:
//  Шаблон      - Строка - текст с ключами вида %Имя%
//  Подстановки - Структура - имя ключа → значение
//
// Возвращаемое значение:
//  Строка - текст с подставленными именами.
//
Функция ПодставитьИмена(Шаблон, Подстановки) Экспорт

	Результат = Шаблон;

	Для Каждого Элемент Из Подстановки Цикл
		Результат = СтрЗаменить(Результат, "%" + Элемент.Ключ + "%", Элемент.Значение);
	КонецЦикла;

	// Незаменённый ключ — почти наверняка опечатка в имени: запрос уйдёт в
	// СУБД с «%ДатаОбарота%» и упадёт с невнятной ошибкой. Ловим сразу.
	Позиция = СтрНайти(Результат, "%");
	Если Позиция > 0 Тогда
		Хвост = Сред(Результат, Позиция);
		Конец = СтрНайти(Хвост, "%", НаправлениеПоиска.СНачала, 2);
		Если Конец > 0 Тогда
			ВызватьИсключение СтрШаблон(
				"Расширение «Агент»: в шаблоне запроса не заменён ключ «%1»."
				+ " Проверьте состав подстановок",
				Лев(Хвост, Конец));
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значение реквизита по имени, устойчивое к его отсутствию.
//
// Обычное обращение через точку падает, если реквизита нет в этом релизе.
// Здесь отсутствие — это Неопределено, а не исключение: расширение должно
// работать и на соседнем релизе, пусть с меньшим набором данных.
//
Функция ЗначениеРеквизита(Ссылка, ИмяРеквизита) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Или ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Неопределено;
	Попытка
		Значение = Ссылка[ИмяРеквизита];
	Исключение
		Значение = Неопределено;
	КонецПопытки;

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка поступления или учётного счёта-фактуры.
Функция ПривестиСтрокуУчёта(СтрокаТЧ, Номер, Имена)

	Номенклатура = ЗначениеПоля(СтрокаТЧ, Имена.СтрокаНоменклатура);
	Сумма = ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.СтрокаСумма));
	СуммаНДС = ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.СтрокаСуммаНДС));

	Строка = Новый Структура;
	Строка.Вставить("Номер", Номер);
	Строка.Вставить("Номенклатура", Номенклатура);
	Строка.Вставить("Наименование",
		?(ЗначениеЗаполнено(Номенклатура), СокрЛП(Строка(Номенклатура)), ""));
	Строка.Вставить("Единица", ЗначениеПоля(СтрокаТЧ, Имена.СтрокаЕдиницаИзмерения));
	Строка.Вставить("Количество", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.СтрокаКоличество)));
	Строка.Вставить("Цена", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.СтрокаЦена)));
	Строка.Вставить("Сумма", Сумма);
	Строка.Вставить("СтавкаНДС", ЗначениеПоля(СтрокаТЧ, Имена.СтрокаСтавкаНДС));
	Строка.Вставить("СуммаНДС", СуммаНДС);
	// Поля «Всего» в типовой нет — складываем уже посчитанные значения.
	Строка.Вставить("Всего", Сумма + СуммаНДС);

	Возврат Строка;

КонецФункции

// Строка ЭСФ: другие имена полей и наименование от поставщика.
Функция ПривестиСтрокуЭСФ(СтрокаТЧ, Номер, Имена)

	Номенклатура = ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаНоменклатура);
	СуммаБезНДС = ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаСуммаБезНДС));
	СуммаНДС = ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаСуммаНДС));
	Всего = ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаВсего);

	// Наименование в ЭСФ — то, как его написал поставщик. Именно оно
	// сопоставляется с номенклатурой базы, а не представление ссылки.
	Наименование = ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаНаименование);
	Если Не ЗначениеЗаполнено(Наименование) И ЗначениеЗаполнено(Номенклатура) Тогда
		Наименование = Строка(Номенклатура);
	КонецЕсли;

	Строка = Новый Структура;
	Строка.Вставить("Номер", Номер);
	Строка.Вставить("Номенклатура", Номенклатура);
	Строка.Вставить("Наименование", СокрЛП(Строка(Наименование)));
	Строка.Вставить("Единица", ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаЕдиница));
	Строка.Вставить("Количество", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаКоличество)));
	Строка.Вставить("Цена", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаЦена)));
	Строка.Вставить("Сумма", СуммаБезНДС);
	Строка.Вставить("СтавкаНДС", ЗначениеПоля(СтрокаТЧ, Имена.ЭСФСтрокаСтавка));
	Строка.Вставить("СуммаНДС", СуммаНДС);
	Строка.Вставить("Всего", ?(ЗначениеЗаполнено(Всего), ЧислоИлиНоль(Всего),
		СуммаБезНДС + СуммаНДС));

	Возврат Строка;

КонецФункции

Функция ЭтоДокументВида(Ссылка, ИмяДокумента)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Метаданные.Документы.Найти(ИмяДокумента) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Ссылка) = Тип("ДокументСсылка." + ИмяДокумента)
		Или ТипЗнч(Ссылка) = Тип("ДокументОбъект." + ИмяДокумента);

КонецФункции

Функция ТабличнаяЧастьДокумента(Ссылка, ИмяЧасти)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	Возврат ?(Объект = Неопределено, Неопределено, ПолучитьТабличнуюЧасть(Объект, ИмяЧасти));

КонецФункции

Функция ПолучитьТабличнуюЧасть(Объект, ИмяЧасти)

	ТабличнаяЧасть = Неопределено;
	Попытка
		ТабличнаяЧасть = Объект[ИмяЧасти];
	Исключение
		ТабличнаяЧасть = Неопределено;
	КонецПопытки;

	Возврат ТабличнаяЧасть;

КонецФункции

Функция ЗначениеПоля(СтрокаТЧ, ИмяПоля)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Неопределено;
	Попытка
		Значение = СтрокаТЧ[ИмяПоля];
	Исключение
		// Поля нет в этом релизе — движок обойдётся без него.
		Значение = Неопределено;
	КонецПопытки;

	Возврат Значение;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

Процедура ПроверитьДокумент(Проблемы, ИмяДокумента, ИменаРеквизитов, ИменаЧастей)

	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Проблемы.Добавить(СтрШаблон("Не найден документ «%1»", ИмяДокумента));
		Возврат;
	КонецЕсли;

	ПроверитьРеквизитыКоллекции(Проблемы, МетаданныеДокумента.Реквизиты, ИменаРеквизитов,
		СтрШаблон("документ «%1»", ИмяДокумента));

	НайденаЧасть = Ложь;
	Для Каждого ИмяЧасти Из ИменаЧастей Цикл
		Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяЧасти) <> Неопределено Тогда
			НайденаЧасть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не НайденаЧасть Тогда
		Проблемы.Добавить(СтрШаблон(
			"У документа «%1» не найдена ни одна из табличных частей: %2",
			ИмяДокумента, СтрСоединить(ИменаЧастей, ", ")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРеквизитыКоллекции(Проблемы, Коллекция, ИменаРеквизитов, ГдеИскали)

	Для Каждого ИмяРеквизита Из СтрРазделить(ИменаРеквизитов, ",", Ложь) Цикл

		ИмяБезПробелов = СокрЛП(ИмяРеквизита);
		Если ПустаяСтрока(ИмяБезПробелов) Тогда
			Продолжить;
		КонецЕсли;

		Если Коллекция.Найти(ИмяБезПробелов) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("Не найден реквизит «%1»: %2",
				ИмяБезПробелов, ГдеИскали));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция СписокСправочников(Имена)

	Справочники = Новый Массив;
	Справочники.Добавить(Имена.СправочникОрганизации);
	Справочники.Добавить(Имена.СправочникКонтрагенты);
	Справочники.Добавить(Имена.СправочникНоменклатура);

	Возврат Справочники;

КонецФункции

#КонецОбласти
