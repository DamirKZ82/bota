///////////////////////////////////////////////////////////////////////////////
// БотаМетаданныеТиповой: единственное место, где расширение знает имена
// объектов типовой конфигурации.
//
// Зачем модуль нужен. Имена реквизитов и табличных частей отличаются между
// релизами «Бухгалтерии для Казахстана» и уточняются по метаданным конкретной
// базы (Приложение А, п. A.14). Если разбросать их по коду, при первом же
// несовпадении придётся править движок, инструменты и сервис. Здесь они собраны
// в одном месте: правится одна функция.
//
// Как проверить себя. Выполните БотаМетаданныеТиповой.ПроверитьСовместимость()
// в консоли — вернётся список того, что не найдено в текущей конфигурации.
// Пустой список означает, что имена сошлись.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имена объектов конфигурации, с которыми работает расширение.
//
// ЭТО ЕДИНСТВЕННОЕ МЕСТО, которое нужно править при несовпадении имён.
// Значения ниже — предположения, основанные на типовой БК 3.0; сверьте их
// с метаданными своей базы.
//
// Возвращаемое значение:
//  Структура - имена объектов, реквизитов и табличных частей.
//
Функция Имена() Экспорт

	Имена = Новый Структура;

	// Документы, участвующие в сверке.
	Имена.Вставить("ДокументПоступление", "ПоступлениеТМЗиУслуг");
	Имена.Вставить("ДокументЭСФ", "СчетФактураПолученный");
	Имена.Вставить("ДокументКорректировка", "КорректировкаПоступления");

	// Документы, которые могут понадобиться позже (ТЗ, открытый вопрос 6).
	// В MVP не участвуют, но имена держим здесь же.
	Имена.Вставить("ДокументДопРасходы", "ПоступлениеДопРасходов");
	Имена.Вставить("ДокументАвансовыйОтчет", "АвансовыйОтчет");

	// Табличные части поступления. Проверяются в указанном порядке,
	// отсутствующие пропускаются: в разных релизах состав отличается.
	ЧастиПоступления = Новый Массив;
	ЧастиПоступления.Добавить("Товары");
	ЧастиПоступления.Добавить("Услуги");
	Имена.Вставить("ТабличныеЧастиПоступления", ЧастиПоступления);

	// Табличные части ЭСФ.
	ЧастиЭСФ = Новый Массив;
	ЧастиЭСФ.Добавить("Товары");
	ЧастиЭСФ.Добавить("Услуги");
	Имена.Вставить("ТабличныеЧастиЭСФ", ЧастиЭСФ);

	// Реквизиты шапки поступления.
	Имена.Вставить("РеквизитОрганизация", "Организация");
	Имена.Вставить("РеквизитКонтрагент", "Контрагент");
	Имена.Вставить("РеквизитДоговор", "ДоговорКонтрагента");
	Имена.Вставить("РеквизитСклад", "Склад");
	Имена.Вставить("РеквизитВалюта", "ВалютаДокумента");
	Имена.Вставить("РеквизитКурс", "КурсВзаиморасчетов");
	// Флаг «Сумма включает НДС» — источник паттерна R2, ключевой реквизит.
	Имена.Вставить("РеквизитСуммаВключаетНДС", "СуммаВключаетНДС");
	Имена.Вставить("РеквизитУчитыватьНДС", "УчитыватьНДС");

	// Реквизиты строк табличных частей.
	Имена.Вставить("СтрокаНоменклатура", "Номенклатура");
	Имена.Вставить("СтрокаКоличество", "Количество");
	Имена.Вставить("СтрокаЦена", "Цена");
	Имена.Вставить("СтрокаСумма", "Сумма");
	Имена.Вставить("СтрокаСтавкаНДС", "СтавкаНДС");
	Имена.Вставить("СтрокаСуммаНДС", "СуммаНДС");
	Имена.Вставить("СтрокаВсего", "Всего");
	Имена.Вставить("СтрокаЕдиницаИзмерения", "ЕдиницаИзмерения");

	// Реквизиты ЭСФ.
	// ДатаОборота определяет период НДС — на ней держится код D08.
	Имена.Вставить("ЭСФДатаОборота", "ДатаСовершенияОборота");
	Имена.Вставить("ЭСФДатаВыписки", "ДатаВыписки");
	Имена.Вставить("ЭСФРегНомер", "РегистрационныйНомер");
	Имена.Вставить("ЭСФСтатус", "Статус");
	Имена.Вставить("ЭСФВид", "ВидСчетаФактуры");
	Имена.Вставить("ЭСФИсправляемый", "ИсправляемыйСчетФактура");
	// Связь ЭСФ с поступлением. В разных релизах реквизит называется
	// по-разному — проверяются оба варианта, см. СвязанноеПоступление().
	Имена.Вставить("ЭСФДокументОснование", "ДокументОснование");
	Имена.Вставить("ЭСФДокументОснованиеАльт", "ОснованиеДокумент");

	// Реквизиты поступления, где хранятся номер и дата ЭСФ (ТЗ п. 4.2).
	Имена.Вставить("ПоступлениеНомерСФ", "НомерСчетаФактуры");
	Имена.Вставить("ПоступлениеДатаСФ", "ДатаСчетаФактуры");

	// Справочники.
	Имена.Вставить("СправочникОрганизации", "Организации");
	Имена.Вставить("СправочникКонтрагенты", "Контрагенты");
	Имена.Вставить("СправочникНоменклатура", "Номенклатура");
	Имена.Вставить("СправочникДоговоры", "ДоговорыКонтрагентов");
	Имена.Вставить("СправочникСклады", "Склады");

	// БИН контрагента и организации.
	Имена.Вставить("РеквизитБИН", "БИН");
	Имена.Вставить("РеквизитБИНАльт", "ИНН");

	// Счёт учёта НДС к возмещению — по нему сверяется зачёт (инструмент
	// get_vat_turnover, A.8).
	Имена.Вставить("СчетНДСКВозмещению", "1420");

	Возврат Имена;

КонецФункции

// Проверяет, что имена из Имена() существуют в текущей конфигурации.
//
// Запускать после установки расширения и после каждого обновления типовой.
// Пустой результат означает, что расширение видит все нужные объекты.
//
// Возвращаемое значение:
//  Массив из Строка - описания несовпадений, по одному на проблему.
//
Функция ПроверитьСовместимость() Экспорт

	Проблемы = Новый Массив;
	ИменаОбъектов = Имена();

	// Документы.
	ОбязательныеДокументы = Новый Массив;
	ОбязательныеДокументы.Добавить(ИменаОбъектов.ДокументПоступление);
	ОбязательныеДокументы.Добавить(ИменаОбъектов.ДокументЭСФ);

	Для Каждого ИмяДокумента Из ОбязательныеДокументы Цикл
		МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаданныеДокумента = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("Не найден документ «%1»", ИмяДокумента));
		КонецЕсли;
	КонецЦикла;

	// Реквизиты поступления.
	МетаданныеПоступления = Метаданные.Документы.Найти(ИменаОбъектов.ДокументПоступление);
	Если МетаданныеПоступления <> Неопределено Тогда

		ПроверитьРеквизиты(Проблемы, МетаданныеПоступления, СтрРазделить(
			ИменаОбъектов.РеквизитОрганизация + ","
			+ ИменаОбъектов.РеквизитКонтрагент + ","
			+ ИменаОбъектов.РеквизитСуммаВключаетНДС, ","));

		НайденаЧасть = Ложь;
		Для Каждого ИмяЧасти Из ИменаОбъектов.ТабличныеЧастиПоступления Цикл
			Если МетаданныеПоступления.ТабличныеЧасти.Найти(ИмяЧасти) <> Неопределено Тогда
				НайденаЧасть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не НайденаЧасть Тогда
			Проблемы.Добавить(СтрШаблон(
				"У документа «%1» не найдена ни одна из табличных частей: %2",
				ИменаОбъектов.ДокументПоступление,
				СтрСоединить(ИменаОбъектов.ТабличныеЧастиПоступления, ", ")));
		КонецЕсли;

	КонецЕсли;

	// Реквизиты ЭСФ. Дата оборота обязательна: без неё нельзя определить
	// период НДС, а значит и код D08.
	МетаданныеЭСФ = Метаданные.Документы.Найти(ИменаОбъектов.ДокументЭСФ);
	Если МетаданныеЭСФ <> Неопределено Тогда

		Если МетаданныеЭСФ.Реквизиты.Найти(ИменаОбъектов.ЭСФДатаОборота) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон(
				"У документа «%1» не найден реквизит даты оборота «%2» —"
				+ " без него не определить период НДС",
				ИменаОбъектов.ДокументЭСФ, ИменаОбъектов.ЭСФДатаОборота));
		КонецЕсли;

		ЕстьОснование = МетаданныеЭСФ.Реквизиты.Найти(ИменаОбъектов.ЭСФДокументОснование) <> Неопределено
			Или МетаданныеЭСФ.Реквизиты.Найти(ИменаОбъектов.ЭСФДокументОснованиеАльт) <> Неопределено;
		Если Не ЕстьОснование Тогда
			Проблемы.Добавить(СтрШаблон(
				"У документа «%1» не найден реквизит связи с поступлением"
				+ " (пробовали «%2» и «%3»)",
				ИменаОбъектов.ДокументЭСФ,
				ИменаОбъектов.ЭСФДокументОснование,
				ИменаОбъектов.ЭСФДокументОснованиеАльт));
		КонецЕсли;

	КонецЕсли;

	// Справочники.
	Если Метаданные.Справочники.Найти(ИменаОбъектов.СправочникКонтрагенты) = Неопределено Тогда
		Проблемы.Добавить(СтрШаблон("Не найден справочник «%1»",
			ИменаОбъектов.СправочникКонтрагенты));
	КонецЕсли;

	Возврат Проблемы;

КонецФункции

// Строки табличных частей документа, приведённые к единому виду.
//
// Движку сверки всё равно, лежат позиции в «Товарах» или в «Услугах»:
// он сравнивает однотипные строки. Здесь части склеиваются, а нумерация
// становится сквозной.
//
// Параметры:
//  ОбъектДокумента - ДокументОбъект, ДокументСсылка - поступление или ЭСФ.
//
// Возвращаемое значение:
//  Массив из Структура - строки с полями Номер, Номенклатура, Наименование,
//   Единица, Количество, Цена, Сумма, СтавкаНДС, СуммаНДС, Всего.
//
Функция СтрокиДокумента(ОбъектДокумента) Экспорт

	ИменаОбъектов = Имена();
	Результат = Новый Массив;

	Если ЭтоЭСФ(ОбъектДокумента) Тогда
		ИменаЧастей = ИменаОбъектов.ТабличныеЧастиЭСФ;
	Иначе
		ИменаЧастей = ИменаОбъектов.ТабличныеЧастиПоступления;
	КонецЕсли;

	СквознойНомер = 0;
	Для Каждого ИмяЧасти Из ИменаЧастей Цикл

		ТабличнаяЧасть = ПолучитьТабличнуюЧасть(ОбъектДокумента, ИмяЧасти);
		Если ТабличнаяЧасть = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			СквознойНомер = СквознойНомер + 1;
			Результат.Добавить(ПривестиСтроку(СтрокаТЧ, СквознойНомер, ИменаОбъектов));
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поступление, с которым связана ЭСФ, или пустая ссылка.
//
// Параметры:
//  ЭСФ - ДокументСсылка - электронный счёт-фактура.
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - связанное поступление.
//
Функция СвязанноеПоступление(ЭСФ) Экспорт

	ИменаОбъектов = Имена();

	Значение = ЗначениеРеквизита(ЭСФ, ИменаОбъектов.ЭСФДокументОснование);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	// В части релизов реквизит называется иначе — пробуем второй вариант.
	Значение = ЗначениеРеквизита(ЭСФ, ИменаОбъектов.ЭСФДокументОснованиеАльт);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// БИН контрагента или организации.
//
// Параметры:
//  Ссылка - СправочникСсылка - контрагент или организация.
//
// Возвращаемое значение:
//  Строка - БИН; пустая строка, если реквизит не заполнен или не найден.
//
Функция БИН(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	ИменаОбъектов = Имена();

	Значение = ЗначениеРеквизита(Ссылка, ИменаОбъектов.РеквизитБИН);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	// В части конфигураций поле называется ИНН и хранит БИН.
	Значение = ЗначениеРеквизита(Ссылка, ИменаОбъектов.РеквизитБИНАльт);
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Значение), "");

КонецФункции

// Признак того, что ссылка указывает на ЭСФ.
Функция ЭтоЭСФ(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяДокумента = Имена().ДокументЭСФ;
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Ссылка) = Тип("ДокументСсылка." + ИмяДокумента)
		Или ТипЗнч(Ссылка) = Тип("ДокументОбъект." + ИмяДокумента);

КонецФункции

// Признак того, что ссылка указывает на поступление.
Функция ЭтоПоступление(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяДокумента = Имена().ДокументПоступление;
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТипЗнч(Ссылка) = Тип("ДокументСсылка." + ИмяДокумента)
		Или ТипЗнч(Ссылка) = Тип("ДокументОбъект." + ИмяДокумента);

КонецФункции

// Значение реквизита по имени, устойчивое к его отсутствию.
//
// Обычное обращение через точку падает, если реквизита нет в этом релизе.
// Здесь отсутствие — это Неопределено, а не исключение: расширение должно
// продолжать работать на соседнем релизе, пусть и с меньшим набором данных.
//
// Параметры:
//  Ссылка       - ДокументСсылка, СправочникСсылка - объект.
//  ИмяРеквизита - Строка - имя реквизита.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение реквизита.
//
Функция ЗначениеРеквизита(Ссылка, ИмяРеквизита) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Или ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаданныеОбъекта = Ссылка.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		// Стандартные реквизиты (Дата, Номер, Организация в части конфигураций)
		// в коллекции Реквизиты не лежат — пробуем получить напрямую.
		Возврат ЗначениеСтандартногоРеквизита(Ссылка, ИмяРеквизита);
	КонецЕсли;

	Возврат Ссылка[ИмяРеквизита];

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит строку табличной части к единому виду для движка сверки.
Функция ПривестиСтроку(СтрокаТЧ, Номер, ИменаОбъектов)

	Номенклатура = ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаНоменклатура);

	Строка = Новый Структура;
	Строка.Вставить("Номер", Номер);
	Строка.Вставить("Номенклатура", Номенклатура);
	Строка.Вставить("Наименование", ПредставлениеНоменклатуры(СтрокаТЧ, Номенклатура));
	Строка.Вставить("Единица", ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаЕдиницаИзмерения));
	Строка.Вставить("Количество", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаКоличество)));
	Строка.Вставить("Цена", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаЦена)));
	Строка.Вставить("Сумма", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаСумма)));
	Строка.Вставить("СтавкаНДС", ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаСтавкаНДС));
	Строка.Вставить("СуммаНДС", ЧислоИлиНоль(ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаСуммаНДС)));

	Всего = ЗначениеПоля(СтрокаТЧ, ИменаОбъектов.СтрокаВсего);
	Если Всего = Неопределено Тогда
		// Реквизита «Всего» может не быть: считаем сами, но только сложением
		// уже посчитанных типовой значений — своей арифметики не изобретаем.
		Всего = Строка.Сумма + Строка.СуммаНДС;
	КонецЕсли;
	Строка.Вставить("Всего", ЧислоИлиНоль(Всего));

	Возврат Строка;

КонецФункции

// Наименование позиции так, как его видит бухгалтер.
Функция ПредставлениеНоменклатуры(СтрокаТЧ, Номенклатура)

	// В ЭСФ наименование поставщика часто хранится отдельным полем и
	// отличается от справочного — для сопоставления важнее именно оно.
	Наименование = ЗначениеПоля(СтрокаТЧ, "НаименованиеТовара");
	Если ЗначениеЗаполнено(Наименование) Тогда
		Возврат СокрЛП(Наименование);
	КонецЕсли;

	Наименование = ЗначениеПоля(СтрокаТЧ, "Наименование");
	Если ЗначениеЗаполнено(Наименование) Тогда
		Возврат СокрЛП(Наименование);
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Номенклатура), СокрЛП(Строка(Номенклатура)), "");

КонецФункции

// Значение поля строки табличной части, устойчивое к его отсутствию.
Функция ЗначениеПоля(СтрокаТЧ, ИмяПоля)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Неопределено;
	Попытка
		Значение = СтрокаТЧ[ИмяПоля];
	Исключение
		// Поля нет в этом релизе — это не ошибка, движок обойдётся без него.
		Значение = Неопределено;
	КонецПопытки;

	Возврат Значение;

КонецФункции

Функция ПолучитьТабличнуюЧасть(ОбъектДокумента, ИмяЧасти)

	ТабличнаяЧасть = Неопределено;
	Попытка
		ТабличнаяЧасть = ОбъектДокумента[ИмяЧасти];
	Исключение
		ТабличнаяЧасть = Неопределено;
	КонецПопытки;

	Возврат ТабличнаяЧасть;

КонецФункции

Функция ЗначениеСтандартногоРеквизита(Ссылка, ИмяРеквизита)

	Значение = Неопределено;
	Попытка
		Значение = Ссылка[ИмяРеквизита];
	Исключение
		Значение = Неопределено;
	КонецПопытки;

	Возврат Значение;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

Процедура ПроверитьРеквизиты(Проблемы, МетаданныеОбъекта, ИменаРеквизитов)

	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если ПустаяСтрока(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Если МетаданныеОбъекта.Реквизиты.Найти(СокрЛП(ИмяРеквизита)) = Неопределено Тогда
			Проблемы.Добавить(СтрШаблон("У документа «%1» не найден реквизит «%2»",
				МетаданныеОбъекта.Имя, СокрЛП(ИмяРеквизита)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
