// A.9.7. mark_reviewed — учётные данные не меняет, но пишется в журнал.
Функция ПометитьРассмотренным(Аргументы)

	РасхождениеId = СтрокаИзАргументов(Аргументы, "discrepancy_id");
	Комментарий = СтрокаИзАргументов(Аргументы, "comment");
	Статус = СтрокаИзАргументов(Аргументы, "status", "reviewed");

	Если Метаданные.РегистрыСведений.Найти("БотаПометки") = Неопределено Тогда
		ВызватьИсключение БотаОшибка("INTERNAL",
			"Не создан регистр сведений «БотаПометки»: пометку негде хранить");
	КонецЕсли;

	Запись = РегистрыСведений.БотаПометки.СоздатьМенеджерЗаписи();
	Запись.ИдРасхождения = РасхождениеId;
	Запись.Статус = Статус;
	Запись.Комментарий = Лев(Комментарий, 500);
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Записать();

	Возврат Новый Структура("discrepancy_id, status", РасхождениеId, Статус);

КонецФункции

// A.9.5. plan_create_receipt_from_esf — фаза 1.
Функция ПланЧерновикаПоЭСФ(Аргументы, Контекст)

	ЭСФ = ОбязательныйДокумент(Аргументы, "esf_uuid", "ЭСФ");

	Склад = СсылкаНеобязательная(Аргументы, "warehouse",
