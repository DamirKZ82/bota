// A.9.2. plan_adjust_lines — фаза 1.
Функция ПланПравкиСтрок(Аргументы, Контекст)

	РасхождениеId = СтрокаИзАргументов(Аргументы, "discrepancy_id");
	Пара = ПараПоРасхождению(РасхождениеId);

	Стратегия = СтрокаИзАргументов(Аргументы, "strategy", "esf_as_master");
	Переопределения = ?(Аргументы.Свойство("lines"), Аргументы.lines, Неопределено);

	// custom без явных значений — ошибка вызывающей стороны: молча применить
	// эталон ЭСФ вместо запрошенных значений нельзя.
	Если Стратегия = "custom"
		И (Переопределения = Неопределено Или Переопределения.Количество() = 0) Тогда
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			"Для стратегии custom нужно передать значения строк в параметре lines");
	КонецЕсли;

	Возврат БотаПланы.ПланПравкаСтрок(Пара.Поступление, Пара.ЭСФ, Стратегия,
		Переопределения, РасхождениеId, Контекст.session_id);

КонецФункции

