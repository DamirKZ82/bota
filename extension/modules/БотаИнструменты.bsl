// Доступна ли роль текущему пользователю.
//
// Функция названа ЕстьРоль, а не РольДоступна: последнее — имя глобальной
// функции платформы, и одноимённая функция модуля перекрыла бы её, превратив
// вызов внутри себя в бесконечную рекурсию.
//
Функция ЕстьРоль(ИмяРоли)

	Если Метаданные.Роли.Найти(ИмяРоли) = Неопределено Тогда
		// Роли ещё не созданы — на этапе отладки это норма.
		Возврат Истина;
	КонецЕсли;

	Возврат РольДоступна(Метаданные.Роли[ИмяРоли]);

КонецФункции

Функция ЧислоСоответствий(Контрагент)

	Если Метаданные.РегистрыСведений.Найти("БотаСоответствияНоменклатуры") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ
		|	РегистрСведений.БотаСоответствияНоменклатуры КАК Соответствия
		|ГДЕ
		|	Соответствия.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Всего, 0);

КонецФункции

Функция СтатусДляОтвета(Статус)

	Представление = НРег(СокрЛП(Строка(Статус)));

	Если СтрНайти(Представление, "аннулир") > 0 Тогда
		Возврат "cancelled";
	ИначеЕсли СтрНайти(Представление, "отозв") > 0 Тогда
		Возврат "revoked";
	ИначеЕсли ПустаяСтрока(Представление) Тогда
		Возврат "delivered";
	КонецЕсли;

	Возврат "delivered";

КонецФункции

Функция СтавкаДляОтвета(Ставка)

	Представление = СокрЛП(Строка(Ставка));
	Если ПустаяСтрока(Представление) Тогда
		Возврат "0";
	КонецЕсли;

	Если СтрНайти(НРег(Представление), "без") > 0 Тогда
		Возврат "exempt";
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Цифры), "0", Цифры);

