// A.9.6. plan_create_receipts_bulk — пачка черновиков по списку ЭСФ.
Функция ПланЧерновиковПачкой(Аргументы, Контекст)

	Если Не Аргументы.Свойство("esf_uuids") Или Аргументы.esf_uuids.Количество() = 0 Тогда
		ВызватьИсключение БотаОшибка("BAD_ARGS", "Не указан список ЭСФ в «esf_uuids»");
	КонецЕсли;

	// Ограничение на размер пачки: каждый черновик — это разбор строк и поиск
	// по справочнику, и на сотнях ЭСФ вызов не уложится в таймаут.
	Если Аргументы.esf_uuids.Количество() > 50 Тогда
		ВызватьИсключение БотаОшибка("LIMIT_EXCEEDED",
			"За один раз можно подготовить не более 50 черновиков."
			+ " Разбейте список на части");
	КонецЕсли;

	Склад = СсылкаНеобязательная(Аргументы, "warehouse",
		БотаМетаданныеТиповой.Имена().СправочникСклады);

	Элементы = Новый Массив;
	ВсегоВнимания = 0;

	Для Каждого Идентификатор Из Аргументы.esf_uuids Цикл

		ЭСФ = НайтиДокумент(Строка(Идентификатор));
		Если ЭСФ = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		План = БотаПодборНоменклатуры.ПланСоздатьПоЭСФ(
			ЭСФ, Склад, Неопределено, Неопределено, Контекст.session_id);

		Элемент = Новый Структура;
		Элемент.Вставить("esf", Ссылка(ЭСФ));
		Элемент.Вставить("plan_id", План.plan_id);
		Элемент.Вставить("attention_count", План.draft.attention_count);
		Элемент.Вставить("can_apply", План.can_apply);
		Элемент.Вставить("block_reason", План.block_reason);

		ВсегоВнимания = ВсегоВнимания + План.draft.attention_count;
		Элементы.Добавить(Элемент);

	КонецЦикла;

	Возврат Новый Структура("items, total_attention", Элементы, ВсегоВнимания);

КонецФункции

Функция СсылкаНеобязательная(Аргументы, Имя, ИмяСправочника)

	Если Не Аргументы.Свойство(Имя) Или Не ЗначениеЗаполнено(Аргументы[Имя]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СсылкаПоUUID(Аргументы, Имя, ИмяСправочника, "Справочники");

КонецФункции

// Пара документов по идентификатору расхождения.
Функция ПараПоРасхождению(РасхождениеId)

	Карточка = ПрочитатьКарточку(РасхождениеId);

	Если Карточка.Поступление = Неопределено Или Карточка.ЭСФ = Неопределено Тогда
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			"Расхождение не содержит пары «поступление ↔ ЭСФ»: править нечего");
	КонецЕсли;

	Возврат Новый Структура("Поступление, ЭСФ",
		Карточка.Поступление.Ссылка, Карточка.ЭСФ.Ссылка);

КонецФункции

Функция ПрочитатьКарточку(РасхождениеId)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Расхождения.ДанныеКарточки КАК ДанныеКарточки
		|ИЗ
		|	РегистрСведений.БотаРасхождения КАК Расхождения
		|ГДЕ
		|	Расхождения.ИдРасхождения = &ИдРасхождения";
	Запрос.УстановитьПараметр("ИдРасхождения", РасхождениеId);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND",
			СтрШаблон("Расхождение %1 не найдено. Возможно, период пересчитан", РасхождениеId));
	КонецЕсли;

	Возврат Выборка.ДанныеКарточки.Получить();

КонецФункции

Функция ОбязательныйДокумент(Аргументы, ИмяПараметра, Описание)

	Ссылка = НайтиДокумент(СтрокаИзАргументов(Аргументы, ИмяПараметра));
	Если Ссылка = Неопределено Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND", СтрШаблон("%1 не найдено", Описание));
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

Функция НеобязательнаяСтрока(Аргументы, Имя)

	Возврат ?(Аргументы.Свойство(Имя) И ЗначениеЗаполнено(Аргументы[Имя]),
		СокрЛП(Строка(Аргументы[Имя])), "");

КонецФункции

// -- сборка ответов ---------------------------------------------------------

Функция КраткаяКарточка(Карточка)

	Результат = Новый Структура;
	Результат.Вставить("id", Карточка.Ид);
	Результат.Вставить("code", Карточка.Код);
	Результат.Вставить("severity", Карточка.Критичность);
	Результат.Вставить("status", Карточка.Статус);
	Результат.Вставить("pattern", Карточка.Паттерн);

	Контрагент = Неопределено;
	Если Карточка.Поступление <> Неопределено Тогда
		Контрагент = Карточка.Поступление.Контрагент;
	ИначеЕсли Карточка.ЭСФ <> Неопределено Тогда
		Контрагент = Карточка.ЭСФ.Контрагент;
	КонецЕсли;

	Результат.Вставить("counterparty", ?(Контрагент = Неопределено, Неопределено,
		Новый Структура("ref, bin", Ссылка(Контрагент),
			БотаМетаданныеТиповой.БИН(Контрагент))));

	Результат.Вставить("receipt", ?(Карточка.Поступление = Неопределено, Неопределено,
		КраткоПоступление(Карточка.Поступление)));
	Результат.Вставить("esf", ?(Карточка.ЭСФ = Неопределено, Неопределено,
		КраткоЭСФ(Карточка.ЭСФ)));
	Результат.Вставить("diff", Разницы(Карточка));
	Результат.Вставить("short", КраткоеОписание(Карточка));

	Возврат Результат;

КонецФункции

Функция ПолнаяКарточка(Карточка)

	Пара = Новый Структура;
	Пара.Вставить("receipt", ?(Карточка.Поступление = Неопределено, Неопределено,
		СторонаПоступления(Карточка.Поступление)));
	Пара.Вставить("esf", ?(Карточка.ЭСФ = Неопределено, Неопределено,
		СторонаЭСФ(Карточка.ЭСФ)));
	Пара.Вставить("link", ?(Карточка.Свойство("ВидСвязи"), Карточка.ВидСвязи, "none"));

	Результат = Новый Структура;
	Результат.Вставить("id", Карточка.Ид);
	Результат.Вставить("code", Карточка.Код);
	Результат.Вставить("severity", Карточка.Критичность);
	Результат.Вставить("status", Карточка.Статус);
	Результат.Вставить("reviewed", ?(ПустаяСтрока(Карточка.Комментарий), Неопределено,
		Карточка.Комментарий));
	Результат.Вставить("pair", Пара);
	Результат.Вставить("header_diff", СравнениеШапок(Карточка));
	Результат.Вставить("lines", СравнениеСтрок(Карточка));
	Результат.Вставить("diagnosis", Диагноз(Карточка));
	Результат.Вставить("suggested_actions", ПредлагаемыеДействия(Карточка));

	Возврат Результат;

КонецФункции

Функция СравнениеШапок(Карточка)

	Результат = Новый Массив;

	Если Карточка.Поступление = Неопределено Или Карточка.ЭСФ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Поступление = Карточка.Поступление;
	ЭСФ = Карточка.ЭСФ;
	Настройки = БотаНастройки.Текущие();
	Допуск = Мин(Настройки.ДопускНаСтроку * Макс(Поступление.ЧислоСтрок, 1),
		Настройки.ПотолокДокумента);

	Результат.Добавить(СтрокаСравнения("net", Поступление.СуммаБезНДС, ЭСФ.СуммаБезНДС, Допуск));
	Результат.Добавить(СтрокаСравнения("vat", Поступление.СуммаНДС, ЭСФ.СуммаНДС, Допуск));
	Результат.Добавить(СтрокаСравнения("total", Поступление.СуммаСНДС, ЭСФ.СуммаСНДС, Допуск));

	ДатаОборота = ?(ЗначениеЗаполнено(ЭСФ.ДатаОборота), ЭСФ.ДатаОборота, ЭСФ.Дата);
	РазницаДней = Цел((НачалоДня(Поступление.Дата) - НачалоДня(ДатаОборота)) / 86400);

	Сравнение = Новый Структура;
	Сравнение.Вставить("field", "date_turnover");
	Сравнение.Вставить("receipt", Формат(Поступление.Дата, "ДФ=yyyy-MM-dd"));
	Сравнение.Вставить("esf", Формат(ДатаОборота, "ДФ=yyyy-MM-dd"));
	Сравнение.Вставить("diff", РазницаДней);
	Сравнение.Вставить("within_tolerance", РазницаДней = 0);
	Результат.Добавить(Сравнение);

	Возврат Результат;

КонецФункции

Функция СтрокаСравнения(Поле, ЗначениеПоступления, ЗначениеЭСФ, Допуск)

	Разница = ЗначениеПоступления - ЗначениеЭСФ;

	Сравнение = Новый Структура;
	Сравнение.Вставить("field", Поле);
	Сравнение.Вставить("receipt", Сумма(ЗначениеПоступления));
	Сравнение.Вставить("esf", Сумма(ЗначениеЭСФ));
	Сравнение.Вставить("diff", Сумма(Разница));
	Сравнение.Вставить("within_tolerance", ?(Разница < 0, -Разница, Разница) <= Допуск);

	Возврат Сравнение;

КонецФункции

Функция СравнениеСтрок(Карточка)

	Результат = Новый Массив;

	Если Не Карточка.Свойство("Сопоставления") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Сопоставление Из Карточка.Сопоставления Цикл

		Строка = Новый Структура;
		Строка.Вставить("match", Сопоставление.Вид);
		Строка.Вставить("match_level", Сопоставление.Уровень);
		Строка.Вставить("confidence", Сопоставление.Уверенность);
		Строка.Вставить("receipt_line", ?(Сопоставление.СтрокаПоступления = Неопределено,
			Неопределено, СтрокаДляОтвета(Сопоставление.СтрокаПоступления)));
		Строка.Вставить("esf_line", ?(Сопоставление.СтрокиЭСФ.Количество() = 0,
			Неопределено, СтрокаДляОтвета(Сопоставление.СтрокиЭСФ[0])));
		Строка.Вставить("diff", РазницыСтроки(Сопоставление.Разницы));
		Строка.Вставить("pattern", ?(Сопоставление.Свойство("Паттерн"),
			Сопоставление.Паттерн, Неопределено));

		Результат.Добавить(Строка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Диагноз(Карточка)

	Если Не Карточка.Свойство("Диагноз") Или Карточка.Диагноз = Неопределено Тогда
		Возврат Новый Структура("pattern, explanation, confidence",
			Карточка.Паттерн, Карточка.Объяснение, "medium");
	КонецЕсли;

	Возврат Новый Структура("pattern, explanation, confidence",
		Карточка.Диагноз.Паттерн, Карточка.Объяснение, Карточка.Диагноз.Уверенность);

КонецФункции

// Действия, которые имеет смысл предложить по этому коду.
//
// Список формируется здесь, а не моделью: агент лишь показывает его
// пользователю. Так набор действий остаётся предсказуемым.
//
Функция ПредлагаемыеДействия(Карточка)

	Действия = Новый Массив;
	Код = Карточка.Код;

	Если Код = "D04" Тогда
		Действия.Добавить(Действие("set_link", "Установить связь с ЭСФ", "low"));
	ИначеЕсли Код = "D03" Тогда
		Действия.Добавить(Действие("create_receipt_from_esf",
			"Создать поступление по ЭСФ", "medium"));
	ИначеЕсли Код = "D06" Или Код = "D07" Тогда
		Если Карточка.Паттерн = "R2" Тогда
			Действия.Добавить(Действие("set_vat_mode",
				"Переключить «Сумма включает НДС» и пересчитать", "low"));
		КонецЕсли;
		Действия.Добавить(Действие("adjust_lines", "Привести суммы к значениям ЭСФ", "low"));
	ИначеЕсли Код = "D14" Тогда
		Действия.Добавить(Действие("mark_reviewed", "Принять как есть", "none"));
	КонецЕсли;

	Возврат Действия;

КонецФункции

