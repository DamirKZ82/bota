Функция Разницы(Карточка)

	Если Карточка.Поступление = Неопределено Или Карточка.ЭСФ = Неопределено Тогда
		// Односторонние расхождения: вся сумма документа и есть разница.
		Данные = ?(Карточка.Поступление = Неопределено, Карточка.ЭСФ, Карточка.Поступление);
		Знак = ?(Карточка.Поступление = Неопределено, -1, 1);
		Возврат Новый Структура("net, vat, total",
			Сумма(Знак * Данные.СуммаБезНДС), Сумма(Знак * Данные.СуммаНДС),
			Сумма(Знак * Данные.СуммаСНДС));
	КонецЕсли;

	Возврат Новый Структура("net, vat, total",
		Сумма(Карточка.Поступление.СуммаБезНДС - Карточка.ЭСФ.СуммаБезНДС),
		Сумма(Карточка.Поступление.СуммаНДС - Карточка.ЭСФ.СуммаНДС),
		Сумма(Карточка.Поступление.СуммаСНДС - Карточка.ЭСФ.СуммаСНДС));

КонецФункции

