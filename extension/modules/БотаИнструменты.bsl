		Сумма(Разницы.СуммаНДС), Сумма(Разницы.Всего));

КонецФункции

// Резюме расхождения одной строкой (поле short в A.3).
//
// Берётся первое предложение объяснения: движок формулирует его так, чтобы
// первая фраза была самодостаточной.
//
Функция КраткоеОписание(Карточка)

	Объяснение = Карточка.Объяснение;
	Точка = СтрНайти(Объяснение, ". ");

	Возврат ?(Точка > 0, Лев(Объяснение, Точка - 1), Объяснение);

КонецФункции

Функция СтрокиДляОтвета(Ссылка)

	Результат = Новый Массив;

	Для Каждого Строка Из БотаМетаданныеТиповой.СтрокиДокумента(Ссылка) Цикл
		Результат.Добавить(СтрокаДляОтвета(Строка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаДляОтвета(Строка)

	Результат = Новый Структура;
	Результат.Вставить("n", Строка.Номер);
	Результат.Вставить("item", ?(ЗначениеЗаполнено(Строка.Номенклатура),
		Ссылка(Строка.Номенклатура), Неопределено));
	Результат.Вставить("name", Строка.Наименование);
	Результат.Вставить("unit", ?(ЗначениеЗаполнено(Строка.Единица),
		Строка(Строка.Единица), Неопределено));
	Результат.Вставить("qty", Количество(Строка.Количество));
	Результат.Вставить("price", Сумма(Строка.Цена));
	Результат.Вставить("net", Сумма(Строка.Сумма));
	Результат.Вставить("vat_rate", СтавкаДляОтвета(Строка.СтавкаНДС));
	Результат.Вставить("vat", Сумма(Строка.СуммаНДС));
	Результат.Вставить("total", Сумма(Строка.Всего));

	Возврат Результат;

КонецФункции

// -- разбор аргументов ------------------------------------------------------

Функция СтрокаИзАргументов(Аргументы, Имя, ПоУмолчанию = Неопределено)

	Если Не Аргументы.Свойство(Имя) Или Не ЗначениеЗаполнено(Аргументы[Имя]) Тогда
		Если ПоУмолчанию <> Неопределено Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			СтрШаблон("Не указан обязательный параметр «%1»", Имя));
	КонецЕсли;

	Возврат СокрЛП(Строка(Аргументы[Имя]));

КонецФункции

Функция ЧислоИзАргументов(Аргументы, Имя, ПоУмолчанию)

	Если Не Аргументы.Свойство(Имя) Или Не ЗначениеЗаполнено(Аргументы[Имя]) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Попытка
		Возврат Число(Аргументы[Имя]);
	Исключение
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			СтрШаблон("Параметр «%1» должен быть числом", Имя));
	КонецПопытки;

КонецФункции

Функция ДатаИзАргументов(Аргументы, Имя)

	Значение = СтрокаИзАргументов(Аргументы, Имя);

	// Формат ISO 8601 без времени (A.0.3): «2026-06-30».
	Части = СтрРазделить(Лев(Значение, 10), "-");
	Если Части.Количество() <> 3 Тогда
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			СтрШаблон("Параметр «%1» должен быть датой в формате ГГГГ-ММ-ДД", Имя));
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
	Исключение
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			СтрШаблон("Не удалось разобрать дату «%1» в параметре «%2»", Значение, Имя));
	КонецПопытки;

КонецФункции

Функция МассивИзАргументов(Аргументы, Имя)

	Результат = Новый Массив;

	Если Не Аргументы.Свойство(Имя) Или Аргументы[Имя] = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Аргументы[Имя]) = Тип("Массив") Тогда
		Для Каждого Элемент Из Аргументы[Имя] Цикл
			Результат.Добавить(СокрЛП(Строка(Элемент)));
		КонецЦикла;
	Иначе
		Результат.Добавить(СокрЛП(Строка(Аргументы[Имя])));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СсылкаПоUUID(Аргументы, Имя, ИмяОбъекта, ВидОбъекта)

	Значение = СтрокаИзАргументов(Аргументы, Имя);

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Значение);
	Исключение
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			СтрШаблон("Параметр «%1» должен быть GUID, получено «%2»", Имя, Значение));
	КонецПопытки;

	Если ВидОбъекта = "Справочники" Тогда
		Ссылка = Справочники[ИмяОбъекта].ПолучитьСсылку(Идентификатор);
	Иначе
		Ссылка = Документы[ИмяОбъекта].ПолучитьСсылку(Идентификатор);
	КонецЕсли;

	Если Ссылка.Пустая() Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND",
			СтрШаблон("Объект %1 не найден в базе", Значение));
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Документ по GUID: тип определяется перебором известных видов.
Функция НайтиДокумент(УникальныйИдентификатор)

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(УникальныйИдентификатор);
	Исключение
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			СтрШаблон("«%1» не является GUID", УникальныйИдентификатор));
	КонецПопытки;

	Имена = БотаМетаданныеТиповой.Имена();
	ВидыДокументов = Новый Массив;
	ВидыДокументов.Добавить(Имена.ДокументПоступление);
	ВидыДокументов.Добавить(Имена.ДокументЭСФ);

	Для Каждого ИмяВида Из ВидыДокументов Цикл

		Если Метаданные.Документы.Найти(ИмяВида) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Ссылка = Документы[ИмяВида].ПолучитьСсылку(Идентификатор);
		Если Не Ссылка.Пустая() Тогда
			Возврат Ссылка;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиКонтрагента(Аргументы)

	ИмяСправочника = БотаМетаданныеТиповой.Имена().СправочникКонтрагенты;

	Если Аргументы.Свойство("uuid") И ЗначениеЗаполнено(Аргументы.uuid) Тогда
		Возврат СсылкаПоUUID(Аргументы, "uuid", ИмяСправочника, "Справочники");
	КонецЕсли;

	БИН = СтрокаИзАргументов(Аргументы, "bin");

	Имена = БотаМетаданныеТиповой.Имена();
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяРеквизита = ?(МетаданныеСправочника.Реквизиты.Найти(Имена.РеквизитБИН) <> Неопределено,
		Имена.РеквизитБИН, Имена.РеквизитБИНАльт);

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Контрагенты
		|ГДЕ
		|	Контрагенты.%2 = &БИН
		|	И НЕ Контрагенты.ПометкаУдаления",
		ИмяСправочника, ИмяРеквизита);
	Запрос.УстановитьПараметр("БИН", БИН);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

