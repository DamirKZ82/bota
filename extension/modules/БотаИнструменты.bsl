///////////////////////////////////////////////////////////////////////////////
// БотаИнструменты: реализация инструментов Приложения А (A.1–A.10).
//
// Каждая функция возвращает структуру ровно в том виде, в каком её ждёт
// оркестратор: ключи латиницей, суммы строками, ссылки объектом {type, uuid,
// presentation, nav}. Проверить соответствие можно приёмочным скриптом
// оркестратора — он валидирует ответы теми же контрактами, что и мок.
//
// Суммы строками — не каприз: число с плавающей точкой в JSON само создаёт ту
// копеечную ошибку, которую продукт ищет (A.0.3).
//
// Инструментов apply_* здесь нет и быть не может: применение изменений
// инициирует пользователь из формы, а вызов по HTTP отвергается (A.9).
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Диспетчер: вызывает инструмент по имени.
//
// Параметры:
//  ИмяИнструмента - Строка - имя из Приложения А, латиницей
//  Аргументы      - Структура - разобранный JSON поля args
//  Контекст       - Структура - user_id, session_id, locale, masking
//
// Возвращаемое значение:
//  Структура - result для конверта ToolResponse.
//
Функция Выполнить(ИмяИнструмента, Аргументы, Контекст) Экспорт

	Если ИмяИнструмента = "get_context" Тогда
		Возврат ПолучитьКонтекст();
	ИначеЕсли ИмяИнструмента = "reconcile_period" Тогда
		Возврат СверитьПериод(Аргументы);
	ИначеЕсли ИмяИнструмента = "list_discrepancies" Тогда
		Возврат СписокРасхождений(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_discrepancy" Тогда
		Возврат КарточкаРасхождения(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_document" Тогда
		Возврат Документ(Аргументы);
	ИначеЕсли ИмяИнструмента = "find_esf_candidates" Тогда
		Возврат КандидатыЭСФ(Аргументы);
	ИначеЕсли ИмяИнструмента = "find_receipt_candidates" Тогда
		Возврат КандидатыПоступления(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_counterparty" Тогда
		Возврат КарточкаКонтрагента(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_settings" Тогда
		Возврат Новый Структура("settings", БотаНастройки.ДляОтвета());
	ИначеЕсли ИмяИнструмента = "open_object" Тогда
		Возврат НавигационнаяСсылка(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_journal" Тогда
		Возврат ЖурналДействий(Аргументы);
	ИначеЕсли ИмяИнструмента = "plan_set_link" Тогда
		Возврат ПланСвязи(Аргументы, Контекст);
	ИначеЕсли ИмяИнструмента = "plan_adjust_lines" Тогда
		Возврат ПланПравкиСтрок(Аргументы, Контекст);
	ИначеЕсли ИмяИнструмента = "plan_set_vat_mode" Тогда
		Возврат ПланРежимаНДС(Аргументы, Контекст);
	ИначеЕсли ИмяИнструмента = "mark_reviewed" Тогда
		Возврат ПометитьРассмотренным(Аргументы);
	ИначеЕсли ИмяИнструмента = "plan_create_receipt_from_esf" Тогда
		Возврат ПланЧерновикаПоЭСФ(Аргументы, Контекст);
	ИначеЕсли ИмяИнструмента = "plan_create_receipts_bulk" Тогда
		Возврат ПланЧерновиковПачкой(Аргументы, Контекст);
	КонецЕсли;

	// Неизвестное имя — это ошибка вызывающей стороны, а не сбой базы.
	ВызватьИсключение БотаОшибка("NOT_FOUND",
		СтрШаблон("Инструмент «%1» не поддерживается этой версией расширения",
			ИмяИнструмента));

КонецФункции

// Ссылка на объект в формате Приложения А (A.0.3).
//
// Единый вид везде, где нужен переход в базу. Поле nav в модель не уходит,
// поэтому не маскируется.
//
Функция Ссылка(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МетаданныеОбъекта = Объект.Метаданные();
	ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();

	Результат = Новый Структура;
	Результат.Вставить("type", ПолноеИмя);
	Результат.Вставить("uuid", Строка(Объект.УникальныйИдентификатор()));
	Результат.Вставить("presentation", Строка(Объект));
	Результат.Вставить("nav", ПолучитьНавигационнуюСсылку(Объект));

	Возврат Результат;

КонецФункции

// Сумма строкой с двумя знаками: «1234.56».
Функция Сумма(Значение) Экспорт

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0");

КонецФункции

// Количество строкой с тремя знаками: «12.500».
Функция Количество(Значение) Экспорт

	Возврат Формат(Значение, "ЧДЦ=3; ЧРД=.; ЧГ=0");

КонецФункции

// Исключение с кодом ошибки Приложения А (A.0.2).
//
// Код важнее текста: по нему агент решает, что делать дальше — исправить
// параметры, предложить корректировку или сообщить о нехватке прав.
//
Функция БотаОшибка(Код, Сообщение) Экспорт

	Возврат СтрШаблон("BOTA|%1|%2", Код, Сообщение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// A.1. get_context
Функция ПолучитьКонтекст()

	Организации = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления",
		БотаМетаданныеТиповой.Имена().СправочникОрганизации);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Организация = Новый Структура;
		Организация.Вставить("ref", Ссылка(Выборка.Ссылка));
		Организация.Вставить("bin", БотаМетаданныеТиповой.БИН(Выборка.Ссылка));
		Организация.Вставить("vat_payer", ПлательщикНДС(Выборка.Ссылка));
		Организация.Вставить("forbid_date", ДатаЗапретаИзменения(Выборка.Ссылка));

		Организации.Добавить(Организация);

	КонецЦикла;

	База = Новый Структура;
	База.Вставить("name", ИмяБазы());
	База.Вставить("config", Метаданные.Синоним);
	База.Вставить("config_version", Метаданные.Версия);
	База.Вставить("platform", СтрокаВерсииПлатформы());
	База.Вставить("currency", "KZT");
	База.Вставить("extension_version", ВерсияРасширения());

	Результат = Новый Структура;
	Результат.Вставить("base", База);
	Результат.Вставить("organizations", Организации);
	Результат.Вставить("current_period", ТекущийПериод());
	Результат.Вставить("settings", БотаНастройки.ДляОтвета());
	Результат.Вставить("permissions", Права());

	Возврат Результат;

КонецФункции

// A.2. reconcile_period
Функция СверитьПериод(Аргументы)

	Организация = СсылкаПоUUID(Аргументы, "organization",
		БотаМетаданныеТиповой.Имена().СправочникОрганизации, "Справочники");

	ДатаНачала = ДатаИзАргументов(Аргументы, "from");
	ДатаОкончания = ДатаИзАргументов(Аргументы, "to");

	Если ДатаНачала > ДатаОкончания Тогда
		ВызватьИсключение БотаОшибка("BAD_ARGS",
			"Дата начала периода больше даты окончания");
	КонецЕсли;

	Контрагент = Неопределено;
	Если Аргументы.Свойство("counterparty") И ЗначениеЗаполнено(Аргументы.counterparty) Тогда
		Контрагент = СсылкаПоUUID(Аргументы, "counterparty",
			БотаМетаданныеТиповой.Имена().СправочникКонтрагенты, "Справочники");
	КонецЕсли;

	Пересчитать = Ложь;
	Если Аргументы.Свойство("force_recalc") Тогда
		Пересчитать = Аргументы.force_recalc = Истина;
	КонецЕсли;

	Сводка = БотаСверкаПериода.Выполнить(
		Организация, ДатаНачала, ДатаОкончания, Контрагент, Пересчитать);

	// duration_ms — внутренняя метрика расчёта, в контракте A.2 её нет:
	// длительность вызова оркестратор измеряет сам.
	Ответ = Новый Структура;
	Для Каждого Элемент Из Сводка Цикл
		Если Элемент.Ключ <> "duration_ms" Тогда
			Ответ.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Ответ;

КонецФункции

// A.3. list_discrepancies
Функция СписокРасхождений(Аргументы)

	ИдРасчёта = СтрокаИзАргументов(Аргументы, "calc_id");
	Страница = ЧислоИзАргументов(Аргументы, "page", 1);
	РазмерСтраницы = Мин(ЧислоИзАргументов(Аргументы, "page_size", 50), 200);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Расхождения.ИдРасхождения КАК ИдРасхождения,
		|	Расхождения.Код КАК Код,
		|	Расхождения.Критичность КАК Критичность,
		|	Расхождения.Паттерн КАК Паттерн,
		|	Расхождения.ВлияниеНДС КАК ВлияниеНДС,
		|	Расхождения.ДанныеКарточки КАК ДанныеКарточки
		|ИЗ
		|	РегистрСведений.БотаРасхождения КАК Расхождения
		|ГДЕ
		|	Расхождения.ИдРасчёта = &ИдРасчёта
		|	И (НЕ &ОтборПоКодам ИЛИ Расхождения.Код В (&Коды))
		|	И (НЕ &ОтборПоКритичности ИЛИ Расхождения.Критичность В (&Критичности))
		|	И (НЕ &ОтборПоПаттерну ИЛИ Расхождения.Паттерн В (&Паттерны))
		|	И (НЕ &ОтборПоКонтрагенту ИЛИ Расхождения.Контрагент = &Контрагент)
		|УПОРЯДОЧИТЬ ПО
		|	Расхождения.ВлияниеНДС УБЫВ";

	Коды = МассивИзАргументов(Аргументы, "codes");
	Критичности = МассивИзАргументов(Аргументы, "severity");
	Паттерны = МассивИзАргументов(Аргументы, "pattern");

	Запрос.УстановитьПараметр("ИдРасчёта", ИдРасчёта);
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("ОтборПоКодам", Коды.Количество() > 0);
	Запрос.УстановитьПараметр("Критичности", Критичности);
	Запрос.УстановитьПараметр("ОтборПоКритичности", Критичности.Количество() > 0);
	Запрос.УстановитьПараметр("Паттерны", Паттерны);
	Запрос.УстановитьПараметр("ОтборПоПаттерну", Паттерны.Количество() > 0);

	Контрагент = Неопределено;
	Если Аргументы.Свойство("counterparty") И ЗначениеЗаполнено(Аргументы.counterparty) Тогда
		Контрагент = СсылкаПоUUID(Аргументы, "counterparty",
			БотаМетаданныеТиповой.Имена().СправочникКонтрагенты, "Справочники");
	КонецЕсли;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ОтборПоКонтрагенту", ЗначениеЗаполнено(Контрагент));

	Все = Запрос.Выполнить().Выгрузить();

	// Статус хранится отдельно от расчёта, поэтому фильтр по нему применяется
	// уже к выборке: пометки могли появиться после расчёта.
	Статусы = МассивИзАргументов(Аргументы, "status");

	Элементы = Новый Массив;
	Пропущено = (Страница - 1) * РазмерСтраницы;
	Отобрано = 0;
	Всего = 0;

	Для Каждого Строка Из Все Цикл

		Карточка = Строка.ДанныеКарточки.Получить();
		Если Карточка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Статусы.Количество() > 0 И Статусы.Найти(Карточка.Статус) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Всего = Всего + 1;
		Если Всего <= Пропущено Или Отобрано >= РазмерСтраницы Тогда
			Продолжить;
		КонецЕсли;

		Элементы.Добавить(КраткаяКарточка(Карточка));
		Отобрано = Отобрано + 1;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("page", Страница);
	Результат.Вставить("page_size", РазмерСтраницы);
	Результат.Вставить("total", Всего);
	Результат.Вставить("has_more", Пропущено + Отобрано < Всего);

	Возврат Результат;

КонецФункции

// A.4. get_discrepancy
Функция КарточкаРасхождения(Аргументы)

	ИдРасхождения = СтрокаИзАргументов(Аргументы, "id");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Расхождения.ДанныеКарточки КАК ДанныеКарточки
		|ИЗ
		|	РегистрСведений.БотаРасхождения КАК Расхождения
		|ГДЕ
		|	Расхождения.ИдРасхождения = &ИдРасхождения";
	Запрос.УстановитьПараметр("ИдРасхождения", ИдРасхождения);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND",
			СтрШаблон("Расхождение %1 не найдено. Возможно, период пересчитан —"
				+ " выполните сверку заново", ИдРасхождения));
	КонецЕсли;

	Карточка = Выборка.ДанныеКарточки.Получить();
	Возврат ПолнаяКарточка(Карточка);

КонецФункции

// A.5. get_document
Функция Документ(Аргументы)

	УникальныйИдентификатор = СтрокаИзАргументов(Аргументы, "uuid");
	Ссылка = НайтиДокумент(УникальныйИдентификатор);

	Если Ссылка = Неопределено Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND",
			СтрШаблон("Документ %1 не найден", УникальныйИдентификатор));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("receipt", Неопределено);
	Результат.Вставить("esf", Неопределено);
	Результат.Вставить("links", Новый Массив);

	Данные = БотаДвижокСверки.ДанныеДокумента(Ссылка);
	Строки = СтрокиДляОтвета(Ссылка);

	Если БотаМетаданныеТиповой.ЭтоЭСФ(Ссылка) Тогда

		Результат.esf = Новый Структура("head, lines", ШапкаЭСФ(Данные), Строки);

		Поступление = БотаМетаданныеТиповой.ПоступлениеПоЭСФ(Ссылка);
		Если ЗначениеЗаполнено(Поступление) Тогда
			Результат.links.Добавить(
				Новый Структура("ref, kind", Ссылка(Поступление), "receipt"));
		КонецЕсли;

	Иначе

		Результат.receipt = Новый Структура("head, lines", ШапкаПоступления(Данные), Строки);

	КонецЕсли;

	Возврат Результат;

КонецФункции

// A.6. find_esf_candidates
Функция КандидатыЭСФ(Аргументы)

	Поступление = НайтиДокумент(СтрокаИзАргументов(Аргументы, "receipt_uuid"));
	Если Поступление = Неопределено Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND", "Поступление не найдено");
	КонецЕсли;

	Настройки = БотаНастройки.Текущие();
	Дней = ЧислоИзАргументов(Аргументы, "days", Настройки.ДнейДопускКандидата);
	ДопускСуммы = Число(СтрокаИзАргументов(Аргументы, "amount_tolerance",
		Формат(Настройки.СуммаДопускаКандидата, "ЧДЦ=2; ЧРД=.; ЧГ=0")));
	Предел = ЧислоИзАргументов(Аргументы, "limit", 5);

	Кандидаты = БотаДвижокСверки.НайтиКандидатовЭСФ(Поступление, Дней, ДопускСуммы, Предел);

	Элементы = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл

		Элемент = Новый Структура;
		Элемент.Вставить("esf", КраткоЭСФ(Кандидат.Данные));
		Элемент.Вставить("score", Окр(Кандидат.Оценка, 2));
		Элемент.Вставить("reasons", Кандидат.Причины);
		Элемент.Вставить("already_linked_to",
			?(ЗначениеЗаполнено(Кандидат.УжеСвязанаС), Ссылка(Кандидат.УжеСвязанаС), Неопределено));

		Элементы.Добавить(Элемент);

	КонецЦикла;

	Возврат Новый Структура("items", Элементы);

КонецФункции

// A.6. find_receipt_candidates — зеркало.
Функция КандидатыПоступления(Аргументы)

	// Поиск идёт тем же движком, но от ЭСФ. Пока зеркальная функция в движке
	// не написана, честно сообщаем об этом кодом ошибки, а не пустым списком:
	// пустой список агент прочитает как «кандидатов нет».
	ВызватьИсключение БотаОшибка("NOT_SUPPORTED_RELEASE",
		"Поиск поступлений по ЭСФ появится в следующей версии расширения");

КонецФункции

// A.7. get_counterparty
Функция КарточкаКонтрагента(Аргументы)

	Контрагент = НайтиКонтрагента(Аргументы);
	Если Контрагент = Неопределено Тогда
		ВызватьИсключение БотаОшибка("NOT_FOUND", "Контрагент не найден");
	КонецЕсли;

	НаДату = ТекущаяДатаСеанса();
	Если Аргументы.Свойство("on_date") И ЗначениеЗаполнено(Аргументы.on_date) Тогда
		НаДату = ДатаИзАргументов(Аргументы, "on_date");
	КонецЕсли;

	Плательщик = ПлательщикНДС(Контрагент, НаДату);

	Результат = Новый Структура;
	Результат.Вставить("ref", Ссылка(Контрагент));
	Результат.Вставить("bin", БотаМетаданныеТиповой.БИН(Контрагент));
	Результат.Вставить("name", Строка(Контрагент));
	Результат.Вставить("vat_payer", Плательщик);
	Результат.Вставить("vat_certificate", Неопределено);
	Результат.Вставить("vat_status_on_date", ?(Плательщик, "payer", "not_payer"));
	Результат.Вставить("main_contract", Неопределено);
	Результат.Вставить("contracts_count", 0);
	Результат.Вставить("receipts_in_period", 0);
	Результат.Вставить("esf_in_period", 0);
	Результат.Вставить("item_mapping_count", ЧислоСоответствий(Контрагент));

	Возврат Результат;

КонецФункции

