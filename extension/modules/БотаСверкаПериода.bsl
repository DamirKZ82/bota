///////////////////////////////////////////////////////////////////////////////
// БотаСверкаПериода: полный расчёт сверки за период (Приложение А, A.2).
//
// Соединяет остальные модули в один проход: пары → строки → паттерны → коды →
// сводка. Результат кладётся в кэш и в регистр расхождений, чтобы карточки
// потом отдавались без пересчёта.
//
// Здесь же считается то, ради чего продукт задуман, — накопленная разница
// округлений за период. Именно она объясняет хвост в декларации 300.00.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет сверку периода и сохраняет результат.
//
// Параметры:
//  Организация   - СправочникСсылка.Организации
//  ДатаНачала    - Дата
//  ДатаОкончания - Дата
//  Контрагент    - СправочникСсылка.Контрагенты, Неопределено
//  ПересчитатьПринудительно - Булево - не брать результат из кэша
//
// Возвращаемое значение:
//  Структура - сводка расчёта, см. СтруктураСводки().
//
Функция Выполнить(Организация, ДатаНачала, ДатаОкончания, Контрагент = Неопределено,
	ПересчитатьПринудительно = Ложь) Экспорт

	Если Не ПересчитатьПринудительно Тогда
		ИзКэша = ПрочитатьИзКэша(Организация, ДатаНачала, ДатаОкончания);
		Если ИзКэша <> Неопределено Тогда
			ИзКэша.Вставить("from_cache", Истина);
			Возврат ИзКэша;
		КонецЕсли;
	КонецЕсли;

	НачалоРасчёта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Настройки = БотаНастройки.Текущие();

	Пары = БотаДвижокСверки.СформироватьПары(
		Организация, ДатаНачала, ДатаОкончания, Контрагент, Настройки);

	ИдРасчёта = Новый УникальныйИдентификатор();
	ПредставлениеПериода = ПредставлениеПериода(ДатаНачала, ДатаОкончания);
	ИдБазы = ИдентификаторБазы();

	Расхождения = Новый Массив;

	// Пары: построчное сравнение и классификация.
	Для Каждого Пара Из Пары.Пары Цикл
		ОбработатьПару(Расхождения, Пара, Настройки, ИдБазы, ПредставлениеПериода);
	КонецЦикла;

	// Поступления без ЭСФ: D01 или D02 — решает срок выписки.
	Для Каждого ДанныеПоступления Из Пары.ПоступленияБезЭСФ Цикл
		Расхождение = БотаКлассификатор.ПоступлениеБезЭСФ(ДанныеПоступления, Настройки);
		ДобавитьРасхождение(Расхождения, Расхождение, ИдБазы, ПредставлениеПериода);
	КонецЦикла;

	// ЭСФ без поступления — D03.
	Для Каждого ДанныеЭСФ Из Пары.ЭСФБезПоступления Цикл
		Расхождение = БотаКлассификатор.ЭСФБезПоступления(ДанныеЭСФ);
		ДобавитьРасхождение(Расхождения, Расхождение, ИдБазы, ПредставлениеПериода);
	КонецЦикла;

	// Непроведённые поступления — D16.
	Для Каждого ДанныеПоступления Из Пары.НепроведенныеПоступления Цикл
		Расхождение = БотаКлассификатор.ПоступлениеНеПроведено(ДанныеПоступления);
		ДобавитьРасхождение(Расхождения, Расхождение, ИдБазы, ПредставлениеПериода);
	КонецЦикла;

	Сводка = СобратьСводку(ИдРасчёта, Пары, Расхождения, Настройки);
	Сводка.Вставить("duration_ms",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРасчёта);

	СохранитьРасхождения(ИдРасчёта, Расхождения);
	ЗаписатьВКэш(ИдРасчёта, Организация, ДатаНачала, ДатаОкончания, Сводка);

	Возврат Сводка;

КонецФункции

// Сбрасывает кэш расчётов, затрагивающих указанную дату.
//
// Вызывается из подписки на запись поступления и ЭСФ: расчёт, сделанный до
// правки документа, показывает уже неверную картину, а бухгалтер об этом не
// узнает — он видит те же цифры.
//
Процедура СброситьКэш(Организация, Дата) Экспорт

	Если Метаданные.РегистрыСведений.Найти("БотаКэшРасчёта") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Кэш.ИдРасчёта КАК ИдРасчёта,
		|	Кэш.Организация КАК Организация,
		|	Кэш.ДатаНачала КАК ДатаНачала,
		|	Кэш.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.БотаКэшРасчёта КАК Кэш
		|ГДЕ
		|	Кэш.Организация = &Организация
		|	И Кэш.ДатаНачала <= &Дата
		|	И Кэш.ДатаОкончания >= &Дата";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НаборЗаписей = РегистрыСведений.БотаКэшРасчёта.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдРасчёта.Установить(Выборка.ИдРасчёта);
		НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
		НаборЗаписей.Отбор.ДатаНачала.Установить(Выборка.ДатаНачала);
		НаборЗаписей.Отбор.ДатаОкончания.Установить(Выборка.ДатаОкончания);
		НаборЗаписей.Записать();

		ОчиститьРасхождения(Выборка.ИдРасчёта);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработка одной пары: строки, паттерн, коды.
Процедура ОбработатьПару(Расхождения, Пара, Настройки, ИдБазы, ПредставлениеПериода)

	СтрокиПоступления = БотаМетаданныеТиповой.СтрокиДокумента(Пара.Поступление.Ссылка);
	СтрокиЭСФ = БотаМетаданныеТиповой.СтрокиДокумента(Пара.ЭСФ.Ссылка);

	Соответствия = СоответствияКонтрагента(Пара.Поступление.Контрагент);

	Результат = БотаКлассификатор.КлассифицироватьПару(
		Пара, СтрокиПоступления, СтрокиЭСФ, Соответствия, Настройки);

	Для Каждого Расхождение Из Результат.Расхождения Цикл

		// Карточка нужна целиком: инструмент get_discrepancy отдаёт её без
		// повторного расчёта периода.
		Расхождение.Вставить("Сопоставления", Результат.Сопоставления);
		Расхождение.Вставить("Диагноз", Результат.Диагноз);
		Расхождение.Вставить("ВидСвязи", Пара.ВидСвязи);

		ДобавитьРасхождение(Расхождения, Расхождение, ИдБазы, ПредставлениеПериода);

	КонецЦикла;

КонецПроцедуры

// Присваивает расхождению устойчивый идентификатор и кладёт в список.
Процедура ДобавитьРасхождение(Расхождения, Расхождение, ИдБазы, ПредставлениеПериода)

	Поступление = ?(Расхождение.Поступление = Неопределено, Неопределено,
		Расхождение.Поступление.Ссылка);
	ЭСФ = ?(Расхождение.ЭСФ = Неопределено, Неопределено, Расхождение.ЭСФ.Ссылка);

	Расхождение.Вставить("Ид", БотаКлассификатор.ИдентификаторРасхождения(
		ИдБазы, ПредставлениеПериода, Поступление, ЭСФ, Расхождение.Код));

	// Пометка «рассмотрено» переживает пересчёт: она хранится отдельно и
	// подтягивается по идентификатору.
	Пометка = ПрочитатьПометку(Расхождение.Ид);
	Расхождение.Вставить("Статус", ?(Пометка = Неопределено, "open", Пометка.Статус));
	Расхождение.Вставить("Комментарий", ?(Пометка = Неопределено, "", Пометка.Комментарий));

	Расхождения.Добавить(Расхождение);

КонецПроцедуры

// Сводка расчёта в формате Приложения А (A.2).
Функция СобратьСводку(ИдРасчёта, Пары, Расхождения, Настройки)

	ПоКодам = Новый Соответствие;
	ПоПаттернам = Новый Соответствие;

	РазницаНДСОкругления = 0;
	РазницаБезНДСОкругления = 0;

	Для Каждого Расхождение Из Расхождения Цикл

		Учесть(ПоКодам, Расхождение.Код, Расхождение.ВлияниеНДС, Расхождение.Критичность);

		Если ЗначениеЗаполнено(Расхождение.Паттерн) Тогда
			Учесть(ПоПаттернам, Расхождение.Паттерн, Расхождение.ВлияниеНДС, "");
		КонецЕсли;

		// Накопленное округление считается только по D14: расхождения выше
		// допуска — это ошибки, а не округление, и смешивать их нельзя.
		Если Расхождение.Код = "D14" И Расхождение.Поступление <> Неопределено
			И Расхождение.ЭСФ <> Неопределено Тогда
			РазницаНДСОкругления = РазницаНДСОкругления
				+ (Расхождение.ЭСФ.СуммаНДС - Расхождение.Поступление.СуммаНДС);
			РазницаБезНДСОкругления = РазницаБезНДСОкругления
				+ (Расхождение.ЭСФ.СуммаБезНДС - Расхождение.Поступление.СуммаБезНДС);
		КонецЕсли;

	КонецЦикла;

	Сводка = Новый Структура;
	Сводка.Вставить("calc_id", Строка(ИдРасчёта));
	Сводка.Вставить("calculated_at", ТекущаяДатаСеанса());
	Сводка.Вставить("from_cache", Ложь);
	Сводка.Вставить("scope", СоставРасчёта(Пары));
	Сводка.Вставить("summary_by_code", РазвернутьСводку(ПоКодам, "code"));
	Сводка.Вставить("rounding", Новый Структура(
		"total_diff_vat, total_diff_net, by_pattern",
		Сумма(РазницаНДСОкругления), Сумма(РазницаБезНДСОкругления),
		РазвернутьСводку(ПоПаттернам, "pattern")));
	Сводка.Вставить("vat_totals", ИтогиНДС(Пары));
	Сводка.Вставить("top_discrepancies", СамыеКритичные(Расхождения));

	Возврат Сводка;

КонецФункции

Функция СоставРасчёта(Пары)

	СвязаныЯвно = 0;
	Предположено = 0;

	Для Каждого Пара Из Пары.Пары Цикл
		Если Пара.ВидСвязи = "explicit" Тогда
			СвязаныЯвно = СвязаныЯвно + 1;
		Иначе
			Предположено = Предположено + 1;
		КонецЕсли;
	КонецЦикла;

	Состав = Новый Структура;
	Состав.Вставить("receipts_total",
		Пары.Пары.Количество() + Пары.ПоступленияБезЭСФ.Количество()
		+ Пары.НепроведенныеПоступления.Количество());
	Состав.Вставить("receipts_unposted", Пары.НепроведенныеПоступления.Количество());
	Состав.Вставить("esf_total", Пары.Пары.Количество() + Пары.ЭСФБезПоступления.Количество());
	Состав.Вставить("pairs_linked", СвязаныЯвно);
	Состав.Вставить("pairs_suggested", Предположено);
	Состав.Вставить("receipts_without_esf", Пары.ПоступленияБезЭСФ.Количество());
	Состав.Вставить("esf_without_receipt", Пары.ЭСФБезПоступления.Количество());

	Возврат Состав;

КонецФункции

// Итоги НДС по поступлениям и по ЭСФ.
//
// Оборот по счёту 1420 здесь не считается: это отдельный запрос к учёту,
// его делает инструмент get_vat_turnover (A.8).
//
Функция ИтогиНДС(Пары)

	НДСПоступлений = 0;
	НДСЭСФ = 0;

	Для Каждого Пара Из Пары.Пары Цикл
		НДСПоступлений = НДСПоступлений + Пара.Поступление.СуммаНДС;
		НДСЭСФ = НДСЭСФ + Пара.ЭСФ.СуммаНДС;
	КонецЦикла;

	Для Каждого ДанныеПоступления Из Пары.ПоступленияБезЭСФ Цикл
		НДСПоступлений = НДСПоступлений + ДанныеПоступления.СуммаНДС;
	КонецЦикла;

	Для Каждого ДанныеЭСФ Из Пары.ЭСФБезПоступления Цикл
		НДСЭСФ = НДСЭСФ + ДанныеЭСФ.СуммаНДС;
	КонецЦикла;

	Итоги = Новый Структура;
	Итоги.Вставить("receipts_vat", Сумма(НДСПоступлений));
	Итоги.Вставить("esf_vat", Сумма(НДСЭСФ));
	Итоги.Вставить("diff", Сумма(НДСЭСФ - НДСПоступлений));
	Итоги.Вставить("ledger_vat_1420", Сумма(НДСПоступлений));

	Возврат Итоги;

КонецФункции

// До десяти самых существенных расхождений (A.2, top_discrepancies).
Функция СамыеКритичные(Расхождения)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Влияние", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка"));

	Для Каждого Расхождение Из Расхождения Цикл
		Строка = Таблица.Добавить();
		Строка.Вес = ВесКритичности(Расхождение.Критичность);
		Строка.Влияние = Расхождение.ВлияниеНДС;
		Строка.Ид = Расхождение.Ид;
	КонецЦикла;

	Таблица.Сортировать("Вес Убыв, Влияние Убыв");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Результат.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Строка.Ид);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВесКритичности(Критичность)

	Если Критичность = "high" Тогда
		Возврат 3;
	ИначеЕсли Критичность = "medium" Тогда
		Возврат 2;
	ИначеЕсли Критичность = "low" Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 0;

КонецФункции

Процедура Учесть(Накопитель, Ключ, Влияние, Критичность)

	Запись = Накопитель.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Запись = Новый Структура("Количество, Влияние, Критичность", 0, 0, Критичность);
		Накопитель.Вставить(Ключ, Запись);
	КонецЕсли;

	Запись.Количество = Запись.Количество + 1;
	Запись.Влияние = Запись.Влияние + Влияние;

КонецПроцедуры

Функция РазвернутьСводку(Накопитель, ИмяКлюча)

	Результат = Новый Массив;

	Для Каждого Элемент Из Накопитель Цикл

		Строка = Новый Структура;
		Строка.Вставить(ИмяКлюча, Элемент.Ключ);
		Если ИмяКлюча = "code" Тогда
			Строка.Вставить("severity", Элемент.Значение.Критичность);
			Строка.Вставить("count", Элемент.Значение.Количество);
			Строка.Вставить("amount_vat", Сумма(Элемент.Значение.Влияние));
		Иначе
			Строка.Вставить("count", Элемент.Значение.Количество);
			Строка.Вставить("diff_vat", Сумма(Элемент.Значение.Влияние));
		КонецЕсли;

		Результат.Добавить(Строка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Соответствия номенклатуры контрагента для уровня 1 сопоставления.
Функция СоответствияКонтрагента(Контрагент)

	Соответствия = Новый Соответствие;

	Если Метаданные.РегистрыСведений.Найти("БотаСоответствияНоменклатуры") = Неопределено
		Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Соответствия;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствия.НаименованиеНормализованное КАК Наименование,
		|	Соответствия.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.БотаСоответствияНоменклатуры КАК Соответствия
		|ГДЕ
		|	Соответствия.Контрагент = &Контрагент
		|	И Соответствия.Подтверждено";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Соответствия.Вставить(Выборка.Наименование, Выборка.Номенклатура);
	КонецЦикла;

	Возврат Соответствия;

КонецФункции

Функция ПрочитатьПометку(ИдРасхождения)

	Если Метаданные.РегистрыСведений.Найти("БотаПометки") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отбор = Новый Структура("ИдРасхождения", ИдРасхождения);
	Записи = РегистрыСведений.БотаПометки.Получить(Отбор);

	Возврат ?(ЗначениеЗаполнено(Записи.Статус), Записи, Неопределено);

КонецФункции

Процедура СохранитьРасхождения(ИдРасчёта, Расхождения)

	Если Метаданные.РегистрыСведений.Найти("БотаРасхождения") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.БотаРасхождения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдРасчёта.Установить(Строка(ИдРасчёта));

	Для Каждого Расхождение Из Расхождения Цикл

		Запись = НаборЗаписей.Добавить();
		Запись.ИдРасчёта = Строка(ИдРасчёта);
		Запись.ИдРасхождения = Расхождение.Ид;
		Запись.Код = Расхождение.Код;
		Запись.Критичность = Расхождение.Критичность;
		Запись.Паттерн = ?(Расхождение.Паттерн = Неопределено, "", Расхождение.Паттерн);
		Запись.ВлияниеНДС = Расхождение.ВлияниеНДС;

		Если Расхождение.Поступление <> Неопределено Тогда
			Запись.Поступление = Расхождение.Поступление.Ссылка;
			Запись.Контрагент = Расхождение.Поступление.Контрагент;
		КонецЕсли;
		Если Расхождение.ЭСФ <> Неопределено Тогда
			Запись.ЭСФ = Расхождение.ЭСФ.Ссылка;
			Если Не ЗначениеЗаполнено(Запись.Контрагент) Тогда
				Запись.Контрагент = Расхождение.ЭСФ.Контрагент;
			КонецЕсли;
		КонецЕсли;

		Запись.ДанныеКарточки = Новый ХранилищеЗначения(Расхождение,
			Новый СжатиеДанных(9));

	КонецЦикла;

	НаборЗаписей.Записать();

КонецПроцедуры

Процедура ОчиститьРасхождения(ИдРасчёта)

	Если Метаданные.РегистрыСведений.Найти("БотаРасхождения") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.БотаРасхождения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдРасчёта.Установить(ИдРасчёта);
	НаборЗаписей.Записать();

КонецПроцедуры

Функция ПрочитатьИзКэша(Организация, ДатаНачала, ДатаОкончания)

	Если Метаданные.РегистрыСведений.Найти("БотаКэшРасчёта") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Кэш.ДанныеРасчёта КАК ДанныеРасчёта,
		|	Кэш.ДатаРасчёта КАК ДатаРасчёта
		|ИЗ
		|	РегистрСведений.БотаКэшРасчёта КАК Кэш
		|ГДЕ
		|	Кэш.Организация = &Организация
		|	И Кэш.ДатаНачала = &ДатаНачала
		|	И Кэш.ДатаОкончания = &ДатаОкончания
		|УПОРЯДОЧИТЬ ПО
		|	Кэш.ДатаРасчёта УБЫВ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Кэш живёт сутки: за это время данные периода могли измениться в обход
	// подписки (загрузка ЭСФ, обмен), а неверная сводка хуже её отсутствия.
	Если ТекущаяДатаСеанса() - Выборка.ДатаРасчёта > 86400 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Выборка.ДанныеРасчёта.Получить();

КонецФункции

Процедура ЗаписатьВКэш(ИдРасчёта, Организация, ДатаНачала, ДатаОкончания, Сводка)

	Если Метаданные.РегистрыСведений.Найти("БотаКэшРасчёта") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.БотаКэшРасчёта.СоздатьМенеджерЗаписи();
	Запись.ИдРасчёта = Строка(ИдРасчёта);
	Запись.Организация = Организация;
	Запись.ДатаНачала = НачалоДня(ДатаНачала);
	Запись.ДатаОкончания = НачалоДня(ДатаОкончания);
	Запись.ДанныеРасчёта = Новый ХранилищеЗначения(Сводка, Новый СжатиеДанных(9));
	Запись.ДатаРасчёта = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

// Идентификатор базы для устойчивых идентификаторов расхождений.
//
// Хранится в константе и генерируется один раз. Строка соединения для этого
// не годится: она меняется при переносе базы на другой сервер, а вместе с ней
// изменились бы идентификаторы всех расхождений — и разом слетели бы пометки
// «рассмотрено», которые бухгалтер ставил месяцами.
//
Функция ИдентификаторБазы()

	Если Метаданные.Константы.Найти("БотаИдентификаторБазы") = Неопределено Тогда
		// Константы ещё нет — расширение донастроено не полностью.
		// Пустой идентификатор лучше случайного: он хотя бы одинаков
		// между вызовами в пределах одной установки.
		Возврат "";
	КонецЕсли;

	Значение = Константы.БотаИдентификаторБазы.Получить();
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Значение = Строка(Новый УникальныйИдентификатор());
	Константы.БотаИдентификаторБазы.Установить(Значение);

	Возврат Значение;

КонецФункции

Функция ПредставлениеПериода(ДатаНачала, ДатаОкончания)

	Возврат Формат(ДатаНачала, "ДФ=yyyyMMdd") + "-" + Формат(ДатаОкончания, "ДФ=yyyyMMdd");

КонецФункции

Функция Сумма(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0");

КонецФункции

