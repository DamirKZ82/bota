///////////////////////////////////////////////////////////////////////////////
// БотаПланы: двухфазная запись (ТЗ п. 5.2, Приложение А, A.9).
//
//   plan_<действие>  → план с plan_id, ничего не меняет, живёт 30 минут
//   apply_<действие> → применяет по plan_id, только из формы, по кнопке
//
// Главное правило продукта: **агент не меняет данные**. Он готовит план,
// показывает его бухгалтеру, а нажимает кнопку человек. Здесь это не
// соглашение, а проверка: `ПроверитьИнтерактивность` отвергает применение,
// пришедшее из HTTP-сервиса, фонового задания или внешнего соединения.
//
// Проверок три уровня, и они независимы:
//   1) в реестре инструментов оркестратора нет apply_* — модель о них не знает;
//   2) HTTP-сервис отвергает имена на apply_ (БотаОбменСОркестратором);
//   3) сама функция применения проверяет, что сеанс интерактивный.
// Отказ любого одного уровня не открывает дверь.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Фаза 1: план установки связи поступление ↔ ЭСФ (A.9.1).
//
// Связь физически устанавливается на счёте-фактуре: прямой связи между
// поступлением и ЭСФ в типовой нет (см. БотаМетаданныеТиповой).
//
Функция ПланУстановитьСвязь(ПоступлениеСсылка, ЭСФСсылка, РасхождениеId = "",
	СессияId = "") Экспорт

	Проверки = Новый Массив;
	МожноПрименить = Истина;
	ПричинаБлокировки = Неопределено;

	ДобавитьПроверку(Проверки, "period_open", ПериодОткрыт(ПоступлениеСсылка),
		"Период документа закрыт датой запрета изменения");

	СчетФактура = БотаМетаданныеТиповой.СчетФактураПоЭСФ(ЭСФСсылка);
	ЕстьСчетФактура = ЗначениеЗаполнено(СчетФактура);
	ДобавитьПроверку(Проверки, "invoice_exists", ЕстьСчетФактура,
		"У ЭСФ нет счёта-фактуры: связь устанавливать не на чем");

	СвязанноеРанее = ?(ЕстьСчетФактура,
		БотаМетаданныеТиповой.ПоступлениеПоСчетуФактуре(СчетФактура), Неопределено);
	СвободнаЛи = Не ЗначениеЗаполнено(СвязанноеРанее)
		Или СвязанноеРанее = ПоступлениеСсылка;
	ДобавитьПроверку(Проверки, "esf_not_linked_elsewhere", СвободнаЛи,
		"Счёт-фактура уже связан с другим поступлением");

	ТотЖеКонтрагент = Контрагент(ПоступлениеСсылка) = Контрагент(ЭСФСсылка);
	ДобавитьПроверку(Проверки, "same_counterparty", ТотЖеКонтрагент,
		"Контрагенты поступления и ЭСФ различаются");

	Для Каждого Проверка Из Проверки Цикл
		Если Не Проверка.ok Тогда
			МожноПрименить = Ложь;
			ПричинаБлокировки = Проверка.message;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Изменения = Новый Массив;
	Если ЕстьСчетФактура Тогда
		Изменения.Добавить(Изменение(СчетФактура, Неопределено, "ДокументОснование",
			?(ЗначениеЗаполнено(СвязанноеРанее), Строка(СвязанноеРанее), Неопределено),
			Строка(ПоступлениеСсылка)));
	КонецЕсли;

	Данные = НовыйПлан("set_link", РасхождениеId, СессияId, Проверки,
		МожноПрименить, ПричинаБлокировки);
	Данные.Вставить("Поступление", ПоступлениеСсылка);
	Данные.Вставить("ЭСФ", ЭСФСсылка);
	Данные.Вставить("СчетФактура", СчетФактура);
	Данные.Вставить("changes", Изменения);

	Возврат СохранитьПлан(Данные);

КонецФункции

// Фаза 1: план правки строк поступления по эталону ЭСФ (A.9.2).
Функция ПланПравкаСтрок(ПоступлениеСсылка, ЭСФСсылка, Стратегия = "esf_as_master",
	Переопределения = Неопределено, РасхождениеId = "", СессияId = "") Экспорт

	Проверки = Новый Массив;
	ДобавитьПроверку(Проверки, "period_open", ПериодОткрыт(ПоступлениеСсылка),
		"Период документа закрыт датой запрета изменения");
	ДобавитьПроверку(Проверки, "document_posted", Проведён(ПоступлениеСсылка),
		"Документ не проведён: сначала проведите его");

	СтрокиПоступления = БотаМетаданныеТиповой.СтрокиДокумента(ПоступлениеСсылка);
	СтрокиЭСФ = БотаМетаданныеТиповой.СтрокиДокумента(ЭСФСсылка);

	Сопоставления = БотаСопоставлениеСтрок.Сопоставить(
		СтрокиПоступления, СтрокиЭСФ, Новый Соответствие, БотаНастройки.Текущие());

	Изменения = Новый Массив;
	НовыеИтоги = Новый Структура("net, vat, total", 0, 0, 0);

	Для Каждого Сопоставление Из Сопоставления Цикл

		Если Сопоставление.СтрокаПоступления = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПоступления = Сопоставление.СтрокаПоступления;
		Эталон = ЭталоннаяСтрока(Сопоставление, Стратегия, Переопределения);

		Если Эталон = Неопределено Тогда
			// Строку не меняем — её суммы всё равно попадают в новый итог.
			НовыеИтоги.net = НовыеИтоги.net + СтрокаПоступления.Сумма;
			НовыеИтоги.vat = НовыеИтоги.vat + СтрокаПоступления.СуммаНДС;
			Продолжить;
		КонецЕсли;

		Если Эталон.Цена <> СтрокаПоступления.Цена Тогда
			Изменения.Добавить(Изменение(ПоступлениеСсылка, СтрокаПоступления.Номер,
				"Цена", Сумма(СтрокаПоступления.Цена), Сумма(Эталон.Цена)));
		КонецЕсли;

		Если Эталон.Сумма <> СтрокаПоступления.Сумма Тогда
			Изменения.Добавить(Изменение(ПоступлениеСсылка, СтрокаПоступления.Номер,
				"Сумма", Сумма(СтрокаПоступления.Сумма), Сумма(Эталон.Сумма)));
		КонецЕсли;

		Если Эталон.СуммаНДС <> СтрокаПоступления.СуммаНДС Тогда
			Изменения.Добавить(Изменение(ПоступлениеСсылка, СтрокаПоступления.Номер,
				"СуммаНДС", Сумма(СтрокаПоступления.СуммаНДС), Сумма(Эталон.СуммаНДС)));
		КонецЕсли;

		НовыеИтоги.net = НовыеИтоги.net + Эталон.Сумма;
		НовыеИтоги.vat = НовыеИтоги.vat + Эталон.СуммаНДС;

	КонецЦикла;

	НовыеИтоги.total = НовыеИтоги.net + НовыеИтоги.vat;
	МожноПрименить = ВсеПроверкиПройдены(Проверки) И Изменения.Количество() > 0;

	Данные = НовыйПлан("adjust_lines", РасхождениеId, СессияId, Проверки, МожноПрименить,
		?(Изменения.Количество() = 0, "Расхождений в строках не найдено: править нечего",
			ПерваяНеудача(Проверки)));
	Данные.Вставить("Поступление", ПоступлениеСсылка);
	Данные.Вставить("ЭСФ", ЭСФСсылка);
	Данные.Вставить("changes", Изменения);
	Данные.Вставить("totals_after", ИтогиСтрокой(НовыеИтоги));
	Данные.Вставить("postings_affected", Проводки(ПоступлениеСсылка, НовыеИтоги));
	Данные.Вставить("will_repost", Истина);

	Возврат СохранитьПлан(Данные);

КонецФункции

// Фаза 1: смена флага «Сумма включает НДС» — паттерн R2 (A.9.3).
Функция ПланСменаРежимаНДС(ПоступлениеСсылка, ВключаетНДС, РасхождениеId = "",
	СессияId = "") Экспорт

	Проверки = Новый Массив;
	ДобавитьПроверку(Проверки, "period_open", ПериодОткрыт(ПоступлениеСсылка),
		"Период документа закрыт датой запрета изменения");

	Имена = БотаМетаданныеТиповой.Имена();
	Текущий = БотаМетаданныеТиповой.ЗначениеРеквизита(
		ПоступлениеСсылка, Имена.РеквизитСуммаВключаетНДС) = Истина;

	ДобавитьПроверку(Проверки, "flag_differs", Текущий <> ВключаетНДС,
		"Флаг «Сумма включает НДС» уже в нужном состоянии");

	Изменения = Новый Массив;
	Изменения.Добавить(Изменение(ПоступлениеСсылка, Неопределено, "СуммаВключаетНДС",
		?(Текущий, "Да", "Нет"), ?(ВключаетНДС, "Да", "Нет")));

	// Пересчёт строк: типовая сделает это сама при записи, но показать
	// последствия нужно до применения, а не после.
	НовыеИтоги = ПересчитатьПоФлагу(ПоступлениеСсылка, ВключаетНДС, Изменения);

	Данные = НовыйПлан("set_vat_mode", РасхождениеId, СессияId, Проверки,
		ВсеПроверкиПройдены(Проверки), ПерваяНеудача(Проверки));
	Данные.Вставить("Поступление", ПоступлениеСсылка);
	Данные.Вставить("ВключаетНДС", ВключаетНДС);
	Данные.Вставить("changes", Изменения);
	Данные.Вставить("totals_after", ИтогиСтрокой(НовыеИтоги));
	Данные.Вставить("postings_affected", Проводки(ПоступлениеСсылка, НовыеИтоги));
	Данные.Вставить("will_repost", Истина);

	Возврат СохранитьПлан(Данные);

КонецФункции

// Фаза 2: применение плана. Только из интерактивного сеанса.
//
// Параметры:
//  ПланId - Строка - идентификатор плана из фазы 1.
//
// Возвращаемое значение:
//  Структура - applied, journal_id, objects.
//
Функция Применить(ПланId) Экспорт

	// Первая и главная проверка. Всё остальное — детали.
	ПроверитьИнтерактивность();

	Данные = ПрочитатьПлан(ПланId);
	Если Данные = Неопределено Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("NOT_FOUND",
			"План не найден или срок его действия истёк. Подготовьте план заново");
	КонецЕсли;

	Если Данные.Применён Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("LOCKED",
			"Этот план уже применён. Повторное применение изменило бы данные дважды");
	КонецЕсли;

	Если Не Данные.План.can_apply Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("BAD_ARGS",
			?(ЗначениеЗаполнено(Данные.План.block_reason), Данные.План.block_reason,
				"План отмечен как неприменимый"));
	КонецЕсли;

	// Проверки фазы 1 могли устареть: между планом и нажатием кнопки проходит
	// время, и период мог закрыться, а документ — измениться.
	ПерепроверитьПередПрименением(Данные.План);

	Попытка
		Документы = ПрименитьДействие(Данные.План);
	Исключение
		// Типовая проверяет дату запрета при записи. Её отказ нужно донести
		// понятным кодом, а не «внутренней ошибкой»: агент по PERIOD_CLOSED
		// предложит корректировку вместо правки документа.
		ВызватьИсключение ОшибкаПрименения(ИнформацияОбОшибке());
	КонецПопытки;

	ОтметитьПрименённым(ПланId);
	БотаЖурнал.ЗаписатьПрименение(ПланId, Данные.План.action,
		Данные.План.session_id, Документы, Неопределено, Данные.План.discrepancy_id);

	Результат = Новый Структура;
	Результат.Вставить("applied", Истина);
	Результат.Вставить("journal_id", ПланId);
	Результат.Вставить("objects", СсылкиДляОтвета(Документы));

	Возврат Результат;

КонецФункции

// План в формате Приложения А для передачи наружу.
Функция ПланДляОтвета(ПланId) Экспорт

	Данные = ПрочитатьПлан(ПланId);
	Если Данные = Неопределено Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("NOT_FOUND", "План не найден");
	КонецЕсли;

	Возврат Данные.План;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Применение возможно только из интерактивного сеанса пользователя.
//
// Это не перестраховка: без проверки достаточно было бы получить токен базы,
// чтобы менять учётные данные по HTTP от имени агента. ТЗ п. 5.2 требует, чтобы
// фазу 2 инициировал человек кнопкой.
//
Процедура ПроверитьИнтерактивность()

	ИмяПриложения = ТекущийСеансИнформационнойБазы().ПриложениеИмя;

	Интерактивные = Новый Массив;
	Интерактивные.Добавить("1CV8");            // толстый клиент
	Интерактивные.Добавить("1CV8C");           // тонкий клиент
	Интерактивные.Добавить("WebClient");       // веб-клиент

	Если Интерактивные.Найти(ИмяПриложения) = Неопределено Тогда
		ЗаписьЖурналаРегистрации("Бота.Безопасность", УровеньЖурналаРегистрации.Предупреждение,
			, , СтрШаблон("Попытка применить план из сеанса «%1» отклонена", ИмяПриложения));
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED",
			"Применение изменений выполняется только из формы 1С по кнопке пользователя");
	КонецЕсли;

	Если Метаданные.Роли.Найти("БотаПрименениеИзменений") <> Неопределено
		И Не РольДоступна(Метаданные.Роли.БотаПрименениеИзменений) Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED",
			"Нет права «Агент: применение изменений»");
	КонецЕсли;

КонецПроцедуры

// Повторная проверка условий непосредственно перед записью.
Процедура ПерепроверитьПередПрименением(План)

	Если Не План.Свойство("Поступление") Или Не ЗначениеЗаполнено(План.Поступление) Тогда
		Возврат;
	КонецЕсли;

	Если Не ПериодОткрыт(План.Поступление) Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("PERIOD_CLOSED",
			"Период документа закрыт датой запрета изменения."
			+ " Вместо правки нужна корректировка поступления");
	КонецЕсли;

КонецПроцедуры

Функция ПрименитьДействие(План)

	Документы = Новый Массив;

	Если План.action = "set_link" Тогда
		ПрименитьСвязь(План, Документы);
	ИначеЕсли План.action = "adjust_lines" Тогда
		ПрименитьПравкуСтрок(План, Документы);
	ИначеЕсли План.action = "set_vat_mode" Тогда
		ПрименитьСменуРежимаНДС(План, Документы);
	Иначе
		ВызватьИсключение БотаИнструменты.БотаОшибка("NOT_SUPPORTED_RELEASE",
			СтрШаблон("Применение действия «%1» пока не реализовано", План.action));
	КонецЕсли;

	Возврат Документы;

КонецФункции

Процедура ПрименитьСвязь(План, Документы)

	Если Не ЗначениеЗаполнено(План.СчетФактура) Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("NOT_FOUND",
			"У ЭСФ нет счёта-фактуры: связь устанавливать не на чем");
	КонецЕсли;

	Объект = План.СчетФактура.ПолучитьОбъект();
	Объект.Заблокировать();
	Объект[БотаМетаданныеТиповой.Имена().СФДокументОснование] = План.Поступление;
	Объект.Записать(?(Объект.Проведен, РежимЗаписиДокумента.Проведение,
		РежимЗаписиДокумента.Запись));

	Документы.Добавить(План.СчетФактура);

КонецПроцедуры

Процедура ПрименитьПравкуСтрок(План, Документы)

	Объект = План.Поступление.ПолучитьОбъект();
	Объект.Заблокировать();

	Имена = БотаМетаданныеТиповой.Имена();

	Для Каждого Изменение Из План.changes Цикл

		Если Изменение.line = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТЧ = НайтиСтрокуПоСквозномуНомеру(Объект, Изменение.line);
		Если СтрокаТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИмяПоля = ИмяПоляПоИзменению(Изменение.field, Имена);
		Если ЗначениеЗаполнено(ИмяПоля) Тогда
			СтрокаТЧ[ИмяПоля] = Число(Изменение["to"]);
		КонецЕсли;

	КонецЦикла;

	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Документы.Добавить(План.Поступление);

КонецПроцедуры

Процедура ПрименитьСменуРежимаНДС(План, Документы)

	Объект = План.Поступление.ПолучитьОбъект();
	Объект.Заблокировать();
	Объект[БотаМетаданныеТиповой.Имена().РеквизитСуммаВключаетНДС] = План.ВключаетНДС;

	// Пересчёт сумм выполняет типовая при записи: свою арифметику здесь
	// изобретать нельзя — она разойдётся с типовой на округлениях.
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Документы.Добавить(План.Поступление);

КонецПроцедуры

// Строка табличной части по сквозному номеру из плана.
//
// Нумерация в плане сквозная по всем табличным частям (так её строит
// БотаМетаданныеТиповой), поэтому искать надо с тем же обходом.
//
Функция НайтиСтрокуПоСквозномуНомеру(Объект, Номер)

	Имена = БотаМетаданныеТиповой.Имена();
	Счётчик = 0;

	Для Каждого ИмяЧасти Из Имена.ТабличныеЧастиПоступления Цикл

		ТабличнаяЧасть = Неопределено;
		Попытка
			ТабличнаяЧасть = Объект[ИмяЧасти];
		Исключение
			Продолжить;
		КонецПопытки;

		Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			Счётчик = Счётчик + 1;
			Если Счётчик = Номер Тогда
				Возврат СтрокаТЧ;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ИмяПоляПоИзменению(Поле, Имена)

	Если Поле = "Цена" Тогда
		Возврат Имена.СтрокаЦена;
	ИначеЕсли Поле = "Сумма" Тогда
		Возврат Имена.СтрокаСумма;
	ИначеЕсли Поле = "СуммаНДС" Тогда
		Возврат Имена.СтрокаСуммаНДС;
	КонецЕсли;

	Возврат "";

КонецФункции

// Эталонная строка для правки: из ЭСФ или из явных переопределений.
Функция ЭталоннаяСтрока(Сопоставление, Стратегия, Переопределения)

	Если Стратегия = "custom" Тогда

		Если Переопределения = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Для Каждого Переопределение Из Переопределения Цикл
			Если Переопределение.n = Сопоставление.СтрокаПоступления.Номер Тогда
				Возврат ЭталонИзПереопределения(Переопределение, Сопоставление.СтрокаПоступления);
			КонецЕсли;
		КонецЦикла;

		Возврат Неопределено;

	КонецЕсли;

	// receipt_as_master означает «ничего не менять в поступлении».
	Если Стратегия = "receipt_as_master" Тогда
		Возврат Неопределено;
	КонецЕсли;

	// esf_as_master: правим только то, что действительно расходится.
	Если Сопоставление.СтрокиЭСФ.Количество() <> 1
		Или Сопоставление.Вид = "matched" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сопоставление.СтрокиЭСФ[0];

КонецФункции

Функция ЭталонИзПереопределения(Переопределение, СтрокаПоступления)

	Эталон = Новый Структура;
	Эталон.Вставить("Цена", ?(Переопределение.Свойство("price")
		И ЗначениеЗаполнено(Переопределение.price),
		Число(Переопределение.price), СтрокаПоступления.Цена));
	Эталон.Вставить("Количество", ?(Переопределение.Свойство("qty")
		И ЗначениеЗаполнено(Переопределение.qty),
		Число(Переопределение.qty), СтрокаПоступления.Количество));
	Эталон.Вставить("СуммаНДС", ?(Переопределение.Свойство("vat")
		И ЗначениеЗаполнено(Переопределение.vat),
		Число(Переопределение.vat), СтрокаПоступления.СуммаНДС));
	Эталон.Вставить("Сумма", Эталон.Цена * Эталон.Количество);

	Возврат Эталон;

КонецФункции

// Пересчёт итогов при смене флага «Сумма включает НДС».
//
// Считается по тем же правилам, что и в типовой: цена остаётся, меняется её
// трактовка. Точные суммы после записи посчитает типовая — здесь показываем
// ожидаемый результат, чтобы бухгалтер видел последствия до применения.
//
Функция ПересчитатьПоФлагу(ПоступлениеСсылка, ВключаетНДС, Изменения)

	Итоги = Новый Структура("net, vat, total", 0, 0, 0);

	Для Каждого Строка Из БотаМетаданныеТиповой.СтрокиДокумента(ПоступлениеСсылка) Цикл

		Ставка = ЧисловаяСтавка(Строка.СтавкаНДС);
		Основание = Строка.Количество * Строка.Цена;

		Если ВключаетНДС Тогда
			// Цена трактуется как сумма с налогом.
			НоваяСумма = Окр(Основание / (1 + Ставка / 100), 2);
			НовыйНДС = Основание - НоваяСумма;
		Иначе
			НоваяСумма = Основание;
			НовыйНДС = Окр(Основание * Ставка / 100, 2);
		КонецЕсли;

		Если НоваяСумма <> Строка.Сумма Тогда
			Изменения.Добавить(Изменение(ПоступлениеСсылка, Строка.Номер, "Сумма",
				Сумма(Строка.Сумма), Сумма(НоваяСумма)));
		КонецЕсли;
		Если НовыйНДС <> Строка.СуммаНДС Тогда
			Изменения.Добавить(Изменение(ПоступлениеСсылка, Строка.Номер, "СуммаНДС",
				Сумма(Строка.СуммаНДС), Сумма(НовыйНДС)));
		КонецЕсли;

		Итоги.net = Итоги.net + НоваяСумма;
		Итоги.vat = Итоги.vat + НовыйНДС;

	КонецЦикла;

	Итоги.total = Итоги.net + Итоги.vat;

	Возврат Итоги;

КонецФункции

Функция ЧисловаяСтавка(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Представление = НРег(СокрЛП(Строка(Значение)));
	Если СтрНайти(Представление, "без") > 0 Тогда
		Возврат 0;
	КонецЕсли;

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Цифры), 0, Число(Цифры));

КонецФункции

// Затрагиваемые проводки: бухгалтер должен видеть последствия, а не только diff.
Функция Проводки(ПоступлениеСсылка, НовыеИтоги)

	Результат = Новый Массив;
	Данные = БотаДвижокСверки.ДанныеДокумента(ПоступлениеСсылка);
	Если Данные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Новый Структура("account_dt, account_kt, from, to",
		"1330", "3310", Сумма(Данные.СуммаБезНДС), Сумма(НовыеИтоги.net)));
	Результат.Добавить(Новый Структура("account_dt, account_kt, from, to",
		БотаМетаданныеТиповой.Имена().СчетНДСКВозмещению, "3310",
		Сумма(Данные.СуммаНДС), Сумма(НовыеИтоги.vat)));

	Возврат Результат;

КонецФункции

// -- хранение планов --------------------------------------------------------

Функция НовыйПлан(Действие, РасхождениеId, СессияId, Проверки, МожноПрименить, Причина)

	// Срок жизни плана — 30 минут (A.9). За это время документ может измениться,
	// поэтому применение всё равно перепроверяет условия.
	СрокДействия = ТекущаяДатаСеанса() + 1800;

	План = Новый Структура;
	План.Вставить("plan_id", Строка(Новый УникальныйИдентификатор()));
	План.Вставить("action", Действие);
	План.Вставить("expires_at", Формат(СрокДействия, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	План.Вставить("checks", Проверки);
	План.Вставить("can_apply", МожноПрименить);
	План.Вставить("block_reason", Причина);
	План.Вставить("discrepancy_id", РасхождениеId);
	План.Вставить("session_id", СессияId);
	План.Вставить("СрокДействия", СрокДействия);

	Возврат План;

КонецФункции

Функция СохранитьПлан(План)

	Если Метаданные.РегистрыСведений.Найти("БотаПланы") = Неопределено Тогда
		// Без регистра план некуда положить, а значит и применить его будет
		// нельзя. Честно говорим об этом сразу, а не при нажатии кнопки.
		ВызватьИсключение БотаИнструменты.БотаОшибка("INTERNAL",
			"Не создан регистр сведений «БотаПланы»: планы негде хранить");
	КонецЕсли;

	Запись = РегистрыСведений.БотаПланы.СоздатьМенеджерЗаписи();
	Запись.ПланId = План.plan_id;
	Запись.Действие = План.action;
	Запись.СрокДействия = План.СрокДействия;
	Запись.Применён = Ложь;
	Запись.Пользователь = ТекущийПользовательСсылка();
	Запись.ДанныеПлана = Новый ХранилищеЗначения(План, Новый СжатиеДанных(9));
	Запись.Записать();

	Возврат ОчиститьСлужебное(План);

КонецФункции

// Убирает из плана поля, которых нет в контракте Приложения А.
//
// Ссылки на объекты 1С и срок действия датой нужны только внутри базы: наружу
// уходит то, что описано в A.9, и ничего сверх.
//
Функция ОчиститьСлужебное(План)

	Служебные = Новый Массив;
	Служебные.Добавить("СрокДействия");
	Служебные.Добавить("Поступление");
	Служебные.Добавить("ЭСФ");
	Служебные.Добавить("СчетФактура");
	Служебные.Добавить("ВключаетНДС");

	Результат = Новый Структура;
	Для Каждого Элемент Из План Цикл
		Если Служебные.Найти(Элемент.Ключ) = Неопределено Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	// Ссылку на документ отдаём в формате Приложения А.
	Если План.Свойство("Поступление") И ЗначениеЗаполнено(План.Поступление) Тогда
		Результат.Вставить("document", БотаИнструменты.Ссылка(План.Поступление));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПрочитатьПлан(ПланId)

	Если Метаданные.РегистрыСведений.Найти("БотаПланы") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отбор = Новый Структура("ПланId", ПланId);
	Запись = РегистрыСведений.БотаПланы.Получить(Отбор);

	Если Не ЗначениеЗаполнено(Запись.Действие) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Запись.СрокДействия < ТекущаяДатаСеанса() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("План, Применён",
		Запись.ДанныеПлана.Получить(), Запись.Применён);

КонецФункции

Процедура ОтметитьПрименённым(ПланId)

	Запись = РегистрыСведений.БотаПланы.СоздатьМенеджерЗаписи();
	Запись.ПланId = ПланId;
	Запись.Прочитать();

	Если Не Запись.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Запись.Применён = Истина;
	Запись.Записать();

КонецПроцедуры

