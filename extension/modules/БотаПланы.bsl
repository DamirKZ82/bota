// Предварительная проверка даты запрета изменения.
//
// Окончательное слово — за типовой: она проверяет дату запрета при записи и
// сама выбрасывает исключение. Здесь проверка нужна, чтобы не показывать
// бухгалтеру план, который заведомо не применится.
//
// Имя и сигнатура метода БСП различаются между релизами, поэтому вызов
// защищённый: не нашли — считаем период открытым и полагаемся на типовую.
// Врать «период открыт» без оговорки нельзя, поэтому результат проверки
// сопровождается пояснением в плане.
//
Функция ПериодОткрыт(ДокументСсылка)

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Метаданные.ОбщиеМодули.Найти("ДатыЗапретаИзменения") = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль("ДатыЗапретаИзменения");
		Возврат Не Модуль.ДатаЗапретаИзмененияНарушена(ДокументСсылка);
	Исключение
		// Метода нет или сигнатура другая — проверит типовая при записи.
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Превращает исключение записи в код ошибки Приложения А.
Функция ОшибкаПрименения(Информация)

	Текст = КраткоеПредставлениеОшибки(Информация);
	Низкий = НРег(Текст);

	// Наши собственные ошибки уже с кодом — пропускаем как есть.
	Если СтрНайти(Текст, "BOTA|") > 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Если СтрНайти(Низкий, "дата запрета") > 0 Или СтрНайти(Низкий, "запрещено изменять") > 0 Тогда
		Возврат БотаИнструменты.БотаОшибка("PERIOD_CLOSED",
			"Период закрыт датой запрета изменения. Вместо правки документа"
			+ " подготовьте корректировку поступления");
	КонецЕсли;

	Если СтрНайти(Низкий, "заблокирован") > 0 Или СтрНайти(Низкий, "занят") > 0 Тогда
		Возврат БотаИнструменты.БотаОшибка("LOCKED",
			"Документ редактируется другим пользователем. Повторите позже");
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Бота.Изменения", УровеньЖурналаРегистрации.Ошибка,
		, , ПодробноеПредставлениеОшибки(Информация));

	Возврат БотаИнструменты.БотаОшибка("INTERNAL",
		СтрШаблон("Не удалось применить изменение: %1", Текст));

КонецФункции

