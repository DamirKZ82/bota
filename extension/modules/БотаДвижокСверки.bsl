///////////////////////////////////////////////////////////////////////////////
// БотаДвижокСверки: формирование пар «поступление ↔ ЭСФ» (ТЗ п. 4.1).
//
// Первый и самый ответственный шаг сверки: пока пары собраны неверно, всё
// остальное — построчное сравнение, допуски, классификация — считает не то.
//
// Связь трёхзвенная, и это выяснилось только на реальной базе:
//
//   ЭСФ.СчетФактура → СчетФактураПолученный.ДокументОснование → Поступление
//
// Прямой связи между ЭСФ и поступлением в типовой нет. По данным пилотной базы
// связь заполнена у 79 % входящих ЭСФ; остальные приходится искать подбором —
// для этого и нужна оценка кандидатов.
//
// Производительность. Норматив ТЗ п. 8: 5 000 поступлений за квартал должны
// считаться за 60 с. Поэтому итоги берутся запросом с группировкой по табличным
// частям, а связь — соединением, а не обходом документов по одному.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Формирует пары «поступление ↔ ЭСФ» за период.
//
// Параметры:
//  Организация   - СправочникСсылка.Организации
//  ДатаНачала    - Дата - начало периода, включительно
//  ДатаОкончания - Дата - конец периода, включительно
//  Контрагент    - СправочникСсылка.Контрагенты, Неопределено - отбор
//  Настройки     - Структура - см. БотаНастройки.Текущие()
//
// Возвращаемое значение:
//  Структура:
//   * Пары                     - Массив из Структура
//   * ПоступленияБезЭСФ        - Массив из Структура
//   * ЭСФБезПоступления        - Массив из Структура
//   * НепроведенныеПоступления - Массив из Структура - код D16
//
Функция СформироватьПары(Организация, ДатаНачала, ДатаОкончания, Контрагент, Настройки) Экспорт

	ГраницаПериода = КонецДня(ДатаОкончания);
	Поступления = ПоступленияЗаПериод(Организация, ДатаНачала, ГраницаПериода, Контрагент);

	// ЭСФ отбираются с «хвостом»: срок выписки — до 20 дней после оборота
	// (ТЗ п. 4.1), поэтому ЭСФ за июнь может быть выписана в июле.
	ХвостДней = ?(Настройки.Свойство("ХвостПериодаДней"), Настройки.ХвостПериодаДней, 20);
	ЭСФ = ЭСФЗаПериод(Организация, ДатаНачала,
		КонецДня(ДатаОкончания + ХвостДней * 86400), Контрагент);

	Результат = Новый Структура;
	Результат.Вставить("Пары", Новый Массив);
	Результат.Вставить("ПоступленияБезЭСФ", Новый Массив);
	Результат.Вставить("ЭСФБезПоступления", Новый Массив);
	Результат.Вставить("НепроведенныеПоступления", Новый Массив);

	// На одно поступление может ссылаться несколько ЭСФ: исправленная или
	// дополнительная указывают на тот же счёт-фактуру, что и основная.
	// Поэтому в индексе массив, а не одна ссылка, — иначе движок молча возьмёт
	// случайную и потеряет код D10.
	ЭСФПоПоступлению = Новый Соответствие;
	СвободныеЭСФ = Новый Соответствие;

	Для Каждого ДанныеЭСФ Из ЭСФ Цикл

		СвободныеЭСФ.Вставить(ДанныеЭСФ.Ссылка, ДанныеЭСФ);

		Если Не ЗначениеЗаполнено(ДанныеЭСФ.Поступление) Тогда
			Продолжить;
		КонецЕсли;

		СписокЭСФ = ЭСФПоПоступлению.Получить(ДанныеЭСФ.Поступление);
		Если СписокЭСФ = Неопределено Тогда
			СписокЭСФ = Новый Массив;
			ЭСФПоПоступлению.Вставить(ДанныеЭСФ.Поступление, СписокЭСФ);
		КонецЕсли;
		СписокЭСФ.Добавить(ДанныеЭСФ);

	КонецЦикла;

	// Шаг 1. Пары по явной связи через счёт-фактуру.
	СвободныеПоступления = Новый Массив;
	Для Каждого ДанныеПоступления Из Поступления Цикл

		Если Не ДанныеПоступления.Проведен Тогда
			// Непроведённые в сверке не участвуют, но и молчать о них нельзя:
			// это код D16.
			Результат.НепроведенныеПоступления.Добавить(ДанныеПоступления);
			Продолжить;
		КонецЕсли;

		СписокЭСФ = ЭСФПоПоступлению.Получить(ДанныеПоступления.Ссылка);
		Если СписокЭСФ <> Неопределено И СписокЭСФ.Количество() > 0 Тогда

			Актуальная = АктуальнаяЭСФ(СписокЭСФ);
			Пара = НоваяПара(ДанныеПоступления, Актуальная, "explicit", 1);

			Для Каждого ДанныеЭСФ Из СписокЭСФ Цикл
				СвободныеЭСФ.Удалить(ДанныеЭСФ.Ссылка);
				Если ДанныеЭСФ.Ссылка <> Актуальная.Ссылка Тогда
					Пара.ЗамещённыеЭСФ.Добавить(ДанныеЭСФ);
				КонецЕсли;
			КонецЦикла;

			Результат.Пары.Добавить(Пара);
			Продолжить;

		КонецЕсли;

		СвободныеПоступления.Добавить(ДанныеПоступления);

	КонецЦикла;

	// Шаг 2. Для поступлений без связи ищем кандидата среди свободных ЭСФ.
	// Найденное — предположение (код D04): связь не устанавливается, решение
	// принимает бухгалтер.
	ДнейДопуск = ?(Настройки.Свойство("ДнейДопускКандидата"), Настройки.ДнейДопускКандидата, 10);
	СуммаДопуск = ?(Настройки.Свойство("СуммаДопускаКандидата"), Настройки.СуммаДопускаКандидата, 5);

	Для Каждого ДанныеПоступления Из СвободныеПоступления Цикл

		Кандидат = ЛучшийКандидатЭСФ(ДанныеПоступления, СвободныеЭСФ, ДнейДопуск, СуммаДопуск);

		Если Кандидат = Неопределено Тогда
			Результат.ПоступленияБезЭСФ.Добавить(ДанныеПоступления);
		Иначе
			Результат.Пары.Добавить(
				НоваяПара(ДанныеПоступления, Кандидат.Данные, "suggested", Кандидат.Оценка));
			СвободныеЭСФ.Удалить(Кандидат.Данные.Ссылка);
		КонецЕсли;

	КонецЦикла;

	// Шаг 3. Остаток свободных ЭСФ — код D03.
	Для Каждого Элемент Из СвободныеЭСФ Цикл
		Результат.ЭСФБезПоступления.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кандидаты-ЭСФ для одного поступления (инструмент find_esf_candidates, A.6).
Функция НайтиКандидатовЭСФ(Поступление, ДнейДопуск, СуммаДопуска, Предел = 5) Экспорт

	ДанныеПоступления = ДанныеДокумента(Поступление);
	Если ДанныеПоступления = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	// Ищем шире периода сверки: подходящая ЭСФ могла быть выписана и раньше,
	// и заметно позже.
	ДатаОт = НачалоДня(ДанныеПоступления.Дата - ДнейДопуск * 86400);
	ДатаДо = КонецДня(ДанныеПоступления.Дата + ДнейДопуск * 86400);

	ВсеЭСФ = ЭСФЗаПериод(ДанныеПоступления.Организация, ДатаОт, ДатаДо,
		ДанныеПоступления.Контрагент);

	Кандидаты = Новый Массив;
	Для Каждого ДанныеЭСФ Из ВсеЭСФ Цикл

		Оценка = ОценитьСовпадение(ДанныеПоступления, ДанныеЭСФ, ДнейДопуск, СуммаДопуска);
		Если Оценка.Оценка <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Кандидат = Новый Структура;
		Кандидат.Вставить("Данные", ДанныеЭСФ);
		Кандидат.Вставить("Оценка", Оценка.Оценка);
		Кандидат.Вставить("Причины", Оценка.Причины);
		Кандидат.Вставить("УжеСвязанаС", ДанныеЭСФ.Поступление);
		Кандидаты.Добавить(Кандидат);

	КонецЦикла;

	Возврат ОтобратьЛучшие(Кандидаты, Предел);

КонецФункции

// Данные документа в том же виде, в каком их отдают запросы отбора.
Функция ДанныеДокумента(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имена = БотаМетаданныеТиповой.Имена();
	Организация = БотаМетаданныеТиповой.ЗначениеРеквизита(Ссылка, Имена.РеквизитОрганизация);
	Контрагент = БотаМетаданныеТиповой.ЗначениеРеквизита(Ссылка, Имена.РеквизитКонтрагент);

	Если БотаМетаданныеТиповой.ЭтоЭСФ(Ссылка) Тогда
		Документы = ЭСФЗаПериод(Организация, '00010101', '39991231', Контрагент, Ссылка);
	Иначе
		Документы = ПоступленияЗаПериод(Организация, '00010101', '39991231', Контрагент, Ссылка);
	КонецЕсли;

	Возврат ?(Документы.Количество() > 0, Документы[0], Неопределено);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поступления за период с посчитанными итогами.
Функция ПоступленияЗаПериод(Организация, ДатаНачала, ДатаОкончания, Контрагент,
	ОдинДокумент = Неопределено)

	Имена = БотаМетаданныеТиповой.Имена();
	ИмяДокумента = Имена.ДокументПоступление;
	МетаданныеДокумента = ПроверенныеМетаданные(ИмяДокумента);

	СекцииИтогов = СекцииИтоговПоЧастям(МетаданныеДокумента, ИмяДокумента,
		Имена.ТабличныеЧастиПоступления, Имена.СтрокаСумма, Имена.СтрокаСуммаНДС);

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Шапка.Ссылка КАК Ссылка,
		|	Шапка.Дата КАК Дата,
		|	Шапка.Номер КАК Номер,
		|	Шапка.Проведен КАК Проведен,
		|	Шапка.%2 КАК Организация,
		|	Шапка.%3 КАК Контрагент,
		|	Шапка.%4 КАК СуммаВключаетНДС,
		|	ЕСТЬNULL(СУММА(Итоги.СуммаБезНДС), 0) КАК СуммаБезНДС,
		|	ЕСТЬNULL(СУММА(Итоги.СуммаНДС), 0) КАК СуммаНДС,
		|	ЕСТЬNULL(СУММА(Итоги.ЧислоСтрок), 0) КАК ЧислоСтрок
		|ИЗ
		|	Документ.%1 КАК Шапка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (%5) КАК Итоги
		|		ПО Итоги.Ссылка = Шапка.Ссылка
		|ГДЕ
		|	Шапка.%2 = &Организация
		|	И Шапка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (НЕ &ОтборПоКонтрагенту ИЛИ Шапка.%3 = &Контрагент)
		|	И (НЕ &ОтборПоДокументу ИЛИ Шапка.Ссылка = &Документ)
		|	И НЕ Шапка.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	Шапка.Ссылка, Шапка.Дата, Шапка.Номер, Шапка.Проведен,
		|	Шапка.%2, Шапка.%3, Шапка.%4
		|УПОРЯДОЧИТЬ ПО
		|	Дата",
		ИмяДокумента, Имена.РеквизитОрганизация, Имена.РеквизитКонтрагент,
		Имена.РеквизитСуммаВключаетНДС, СекцииИтогов);

	УстановитьОбщиеПараметры(Запрос, Организация, ДатаНачала, ДатаОкончания,
		Контрагент, ОдинДокумент);

	Возврат ПрочитатьПоступления(Запрос);

КонецФункции

// Входящие ЭСФ за период с итогами и связью с поступлением.
//
// Связь тянется через счёт-фактуру: ЭСФ.СчетФактура → СФ.ДокументОснование.
// Оба реквизита составного типа, поэтому нужны ВЫРАЗИТЬ.
//
Функция ЭСФЗаПериод(Организация, ДатаНачала, ДатаОкончания, Контрагент,
	ОдинДокумент = Неопределено)

	Имена = БотаМетаданныеТиповой.Имена();
	ИмяЭСФ = Имена.ДокументЭСФ;
	МетаданныеЭСФ = ПроверенныеМетаданные(ИмяЭСФ);

	СекцииИтогов = СекцииИтоговПоЧастям(МетаданныеЭСФ, ИмяЭСФ,
		Имена.ТабличныеЧастиЭСФ, Имена.ЭСФСтрокаСуммаБезНДС, Имена.ЭСФСтрокаСуммаНДС);

	// Подстановки именованные, а не %1…%10: СтрШаблон ограничен десятью
	// значениями, а имён здесь тринадцать. Заодно текст читается: видно, какое
	// поле куда подставляется, и при правке нельзя перепутать порядок.
	Подстановки = Новый Структура;
	Подстановки.Вставить("ДокументЭСФ", ИмяЭСФ);
	Подстановки.Вставить("ДокументСчетФактура", Имена.ДокументСчетФактура);
	Подстановки.Вставить("ДокументПоступление", Имена.ДокументПоступление);
	Подстановки.Вставить("Организация", Имена.РеквизитОрганизация);
	Подстановки.Вставить("Контрагент", Имена.РеквизитКонтрагент);
	Подстановки.Вставить("ДатаОборота", Имена.ЭСФДатаОборота);
	Подстановки.Вставить("РегНомер", Имена.ЭСФРегНомер);
	Подстановки.Вставить("Статус", Имена.ЭСФСтатус);
	Подстановки.Вставить("Вид", Имена.ЭСФВид);
	Подстановки.Вставить("Направление", Имена.ЭСФНаправление);
	Подстановки.Вставить("СчетФактураЭСФ", Имена.ЭСФСчетФактура);
	Подстановки.Вставить("ОснованиеСФ", Имена.СФДокументОснование);
	Подстановки.Вставить("СекцииИтогов", СекцииИтогов);

	Шаблон =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Шапка.Ссылка КАК Ссылка,
		|	Шапка.Дата КАК Дата,
		|	Шапка.Номер КАК Номер,
		|	Шапка.Проведен КАК Проведен,
		|	Шапка.%Организация% КАК Организация,
		|	Шапка.%Контрагент% КАК Контрагент,
		|	Шапка.%ДатаОборота% КАК ДатаОборота,
		|	Шапка.%РегНомер% КАК РегНомер,
		|	Шапка.%Статус% КАК Статус,
		|	Шапка.%Вид% КАК Вид,
		|	ВЫРАЗИТЬ(СчетФактура.%ОснованиеСФ% КАК Документ.%ДокументПоступление%) КАК Поступление,
		|	ЕСТЬNULL(СУММА(Итоги.СуммаБезНДС), 0) КАК СуммаБезНДС,
		|	ЕСТЬNULL(СУММА(Итоги.СуммаНДС), 0) КАК СуммаНДС,
		|	ЕСТЬNULL(СУММА(Итоги.ЧислоСтрок), 0) КАК ЧислоСтрок
		|ИЗ
		|	Документ.%ДокументЭСФ% КАК Шапка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.%ДокументСчетФактура% КАК СчетФактура
		|		ПО ВЫРАЗИТЬ(Шапка.%СчетФактураЭСФ% КАК Документ.%ДокументСчетФактура%)
		|			= СчетФактура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (%СекцииИтогов%) КАК Итоги
		|		ПО Итоги.Ссылка = Шапка.Ссылка
		|ГДЕ
		|	Шапка.%Организация% = &Организация
		|	И Шапка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Шапка.%Направление% = &НаправлениеВходящий
		|	И (НЕ &ОтборПоКонтрагенту ИЛИ Шапка.%Контрагент% = &Контрагент)
		|	И (НЕ &ОтборПоДокументу ИЛИ Шапка.Ссылка = &Документ)
		|	И НЕ Шапка.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	Шапка.Ссылка, Шапка.Дата, Шапка.Номер, Шапка.Проведен,
		|	Шапка.%Организация%, Шапка.%Контрагент%, Шапка.%ДатаОборота%,
		|	Шапка.%РегНомер%, Шапка.%Статус%, Шапка.%Вид%,
		|	ВЫРАЗИТЬ(СчетФактура.%ОснованиеСФ% КАК Документ.%ДокументПоступление%)
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	Запрос = Новый Запрос;
	Запрос.Текст = БотаМетаданныеТиповой.ПодставитьИмена(Шаблон, Подстановки);

	УстановитьОбщиеПараметры(Запрос, Организация, ДатаНачала, ДатаОкончания,
		Контрагент, ОдинДокумент);
	Запрос.УстановитьПараметр("НаправлениеВходящий", ЗначениеНаправленияВходящий());

	Возврат ПрочитатьЭСФ(Запрос);

КонецФункции

// Секции итогов по табличным частям: по одной на каждую существующую.
Функция СекцииИтоговПоЧастям(МетаданныеДокумента, ИмяДокумента, ИменаЧастей,
	ИмяСуммы, ИмяСуммыНДС)

	Секции = Новый Массив;

	Для Каждого ИмяЧасти Из ИменаЧастей Цикл

		ЧастьМетаданных = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяЧасти);
		Если ЧастьМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Имена полей сумм различаются между документами: в ЭСФ это
		// «СуммаБезНалогов», в поступлении — «Сумма».
		Если ЧастьМетаданных.Реквизиты.Найти(ИмяСуммы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Секции.Добавить(СтрШаблон(
			"ВЫБРАТЬ
			|	СтрокиТЧ.Ссылка КАК Ссылка,
			|	СУММА(СтрокиТЧ.%2) КАК СуммаБезНДС,
			|	СУММА(СтрокиТЧ.%3) КАК СуммаНДС,
			|	КОЛИЧЕСТВО(*) КАК ЧислоСтрок
			|ИЗ
			|	Документ.%1.%4 КАК СтрокиТЧ
			|СГРУППИРОВАТЬ ПО
			|	СтрокиТЧ.Ссылка",
			ИмяДокумента, ИмяСуммы, ИмяСуммыНДС, ИмяЧасти));

	КонецЦикла;

	Если Секции.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Расширение «Агент»: у документа «%1» не найдено ни одной табличной"
			+ " части с полем «%2». Проверьте БотаМетаданныеТиповой.Имена()",
			ИмяДокумента, ИмяСуммы);
	КонецЕсли;

	Возврат СтрСоединить(Секции, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);

КонецФункции

Функция ПроверенныеМетаданные(ИмяДокумента)

	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Расширение «Агент»: в конфигурации не найден документ «%1»."
			+ " Проверьте БотаМетаданныеТиповой.Имена()", ИмяДокумента);
	КонецЕсли;

	Возврат МетаданныеДокумента;

КонецФункции

Процедура УстановитьОбщиеПараметры(Запрос, Организация, ДатаНачала, ДатаОкончания,
	Контрагент, ОдинДокумент)

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ОтборПоКонтрагенту", ЗначениеЗаполнено(Контрагент));
	Запрос.УстановитьПараметр("Документ", ОдинДокумент);
	Запрос.УстановитьПараметр("ОтборПоДокументу", ЗначениеЗаполнено(ОдинДокумент));

КонецПроцедуры

// Значение «Входящий» реквизита «Направление» документа ЭСФ.
//
// Ищется по имени значения перечисления, а не задаётся строкой: имя типа
// перечисления в разных релизах отличается, а само значение «Входящий»
// устойчиво (проверено на данных пилотной базы).
//
Функция ЗначениеНаправленияВходящий()

	Имена = БотаМетаданныеТиповой.Имена();
	МетаданныеЭСФ = Метаданные.Документы.Найти(Имена.ДокументЭСФ);
	Если МетаданныеЭСФ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Реквизит = МетаданныеЭСФ.Реквизиты.Найти(Имена.ЭСФНаправление);
	Если Реквизит = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ТипРеквизита Из Реквизит.Тип.Типы() Цикл

		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
		Если МетаданныеТипа = Неопределено
			Или Не Метаданные.Перечисления.Содержит(МетаданныеТипа) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЗначениеПеречисления Из МетаданныеТипа.ЗначенияПеречисления Цикл
			Если НРег(ЗначениеПеречисления.Имя) = "входящий" Тогда
				Возврат Перечисления[МетаданныеТипа.Имя][ЗначениеПеречисления.Имя];
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПрочитатьПоступления(Запрос)

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Данные = ОбщиеДанные(Выборка, Ложь);
		Данные.Вставить("СуммаВключаетНДС", Выборка.СуммаВключаетНДС);
		Данные.Вставить("ДатаОборота", Выборка.Дата);
		Данные.Вставить("РегНомер", "");
		Данные.Вставить("Статус", Неопределено);
		Данные.Вставить("Вид", Неопределено);
		Данные.Вставить("Поступление", Неопределено);

		Результат.Добавить(Данные);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьЭСФ(Запрос)

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Данные = ОбщиеДанные(Выборка, Истина);
		Данные.Вставить("СуммаВключаетНДС", Ложь);
		Данные.Вставить("ДатаОборота", Выборка.ДатаОборота);
		Данные.Вставить("РегНомер", Выборка.РегНомер);
		Данные.Вставить("Статус", Выборка.Статус);
		Данные.Вставить("Вид", Выборка.Вид);
		Данные.Вставить("Поступление", Выборка.Поступление);

		Результат.Добавить(Данные);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОбщиеДанные(Выборка, ЭтоЭСФ)

	Данные = Новый Структура;
	Данные.Вставить("Ссылка", Выборка.Ссылка);
	Данные.Вставить("Дата", Выборка.Дата);
	Данные.Вставить("Номер", Выборка.Номер);
	Данные.Вставить("Проведен", Выборка.Проведен);
	Данные.Вставить("Организация", Выборка.Организация);
	Данные.Вставить("Контрагент", Выборка.Контрагент);
	Данные.Вставить("БИН", БотаМетаданныеТиповой.БИН(Выборка.Контрагент));
	Данные.Вставить("СуммаБезНДС", Выборка.СуммаБезНДС);
	Данные.Вставить("СуммаНДС", Выборка.СуммаНДС);
	Данные.Вставить("СуммаСНДС", Выборка.СуммаБезНДС + Выборка.СуммаНДС);
	Данные.Вставить("ЧислоСтрок", Выборка.ЧислоСтрок);
	Данные.Вставить("ЭтоЭСФ", ЭтоЭСФ);

	Возврат Данные;

КонецФункции

Функция НоваяПара(Поступление, ЭСФ, ВидСвязи, Оценка)

	Пара = Новый Структура;
	Пара.Вставить("Поступление", Поступление);
	Пара.Вставить("ЭСФ", ЭСФ);
	Пара.Вставить("ВидСвязи", ВидСвязи);
	Пара.Вставить("Оценка", Оценка);
	Пара.Вставить("ЗамещённыеЭСФ", Новый Массив);

	Возврат Пара;

КонецФункции

// Какая из нескольких ЭСФ на одно поступление считается действующей.
//
// Правило: аннулированная и отозванная не в счёт; из оставшихся берётся
// выписанная последней — исправленная ЭСФ заменяет собой основную.
//
Функция АктуальнаяЭСФ(СписокЭСФ)

	Актуальная = Неопределено;

	Для Каждого ДанныеЭСФ Из СписокЭСФ Цикл

		Если ЭСФНедействительна(ДанныеЭСФ) Тогда
			Продолжить;
		КонецЕсли;

		Если Актуальная = Неопределено Или ДанныеЭСФ.Дата > Актуальная.Дата Тогда
			Актуальная = ДанныеЭСФ;
		КонецЕсли;

	КонецЦикла;

	// Все ЭСФ пары аннулированы — это само по себе расхождение (код D09),
	// поэтому пара всё равно должна попасть в сверку.
	Возврат ?(Актуальная = Неопределено, СписокЭСФ[0], Актуальная);

КонецФункции

// Аннулирована или отозвана ли ЭСФ.
//
// Сравнение по представлению: в пилотной базе встречаются статусы
// «Аннулированный» и «Отозванный», но тип реквизита в разных релизах
// отличается, а подстрока — нет.
//
Функция ЭСФНедействительна(ДанныеЭСФ)

	Если Не ЗначениеЗаполнено(ДанныеЭСФ.Статус) Тогда
		Возврат Ложь;
	КонецЕсли;

	Представление = НРег(СокрЛП(Строка(ДанныеЭСФ.Статус)));

	Возврат СтрНайти(Представление, "аннулир") > 0
		Или СтрНайти(Представление, "отозв") > 0;

КонецФункции

// Лучший кандидат среди свободных ЭСФ или Неопределено.
Функция ЛучшийКандидатЭСФ(ДанныеПоступления, СвободныеЭСФ, ДнейДопуск, СуммаДопуска)

	Лучший = Неопределено;

	Для Каждого Элемент Из СвободныеЭСФ Цикл

		ДанныеЭСФ = Элемент.Значение;

		Если РазныеКонтрагенты(ДанныеПоступления, ДанныеЭСФ) Тогда
			Продолжить;
		КонецЕсли;

		Оценка = ОценитьСовпадение(ДанныеПоступления, ДанныеЭСФ, ДнейДопуск, СуммаДопуска);
		Если Оценка.Оценка <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Лучший = Неопределено Или Оценка.Оценка > Лучший.Оценка Тогда
			Лучший = Новый Структура("Данные, Оценка, Причины",
				ДанныеЭСФ, Оценка.Оценка, Оценка.Причины);
		КонецЕсли;

	КонецЦикла;

	// Слабое совпадение хуже честного «пары нет»: предположение, которое
	// бухгалтер отвергнет, стоит дороже пустого места.
	Если Лучший <> Неопределено И Лучший.Оценка < 0.5 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Лучший;

КонецФункции

// Оценка совпадения поступления и ЭСФ, 0..1 (A.6).
//
// Веса детерминированы: БИН 0.4, сумма 0.3, дата 0.15, состав строк 0.15.
// Модель на оценку не влияет.
//
Функция ОценитьСовпадение(ДанныеПоступления, ДанныеЭСФ, ДнейДопуск, СуммаДопуска)

	Оценка = 0;
	Причины = Новый Массив;

	// БИН — сильнейший признак: без совпадения контрагента пара бессмысленна.
	Если ЗначениеЗаполнено(ДанныеПоступления.БИН)
		И ДанныеПоступления.БИН = ДанныеЭСФ.БИН Тогда
		Оценка = Оценка + 0.4;
		Причины.Добавить("same_bin");
	ИначеЕсли ДанныеПоступления.Контрагент = ДанныеЭСФ.Контрагент Тогда
		Оценка = Оценка + 0.3;
		Причины.Добавить("same_counterparty");
	Иначе
		Возврат Новый Структура("Оценка, Причины", 0, Причины);
	КонецЕсли;

	РазницаСуммы = ДанныеПоступления.СуммаСНДС - ДанныеЭСФ.СуммаСНДС;
	Если РазницаСуммы = 0 Тогда
		Оценка = Оценка + 0.3;
		Причины.Добавить("total_equal");
	ИначеЕсли АбсЗначение(РазницаСуммы) <= СуммаДопуска Тогда
		Оценка = Оценка + 0.25;
		Причины.Добавить("total_close");
	КонецЕсли;

	ДатаЭСФ = ?(ЗначениеЗаполнено(ДанныеЭСФ.ДатаОборота), ДанныеЭСФ.ДатаОборота, ДанныеЭСФ.Дата);
	РазницаДней = АбсЗначение(Цел((НачалоДня(ДанныеПоступления.Дата) - НачалоДня(ДатаЭСФ)) / 86400));

	Если РазницаДней = 0 Тогда
		Оценка = Оценка + 0.15;
		Причины.Добавить("date_equal");
	ИначеЕсли РазницаДней <= ДнейДопуск Тогда
		Оценка = Оценка + 0.1;
		Причины.Добавить(СтрШаблон("date_diff_%1", РазницаДней));
	КонецЕсли;

	// Число строк — дешёвый признак похожести состава. Полное построчное
	// сравнение здесь не делается: оно тяжёлое, а кандидатов много.
	Если ДанныеПоступления.ЧислоСтрок = ДанныеЭСФ.ЧислоСтрок
		И ДанныеПоступления.ЧислоСтрок > 0 Тогда
		Оценка = Оценка + 0.15;
		Причины.Добавить("lines_count_equal");
	КонецЕсли;

	Возврат Новый Структура("Оценка, Причины", Оценка, Причины);

КонецФункции

Функция РазныеКонтрагенты(ДанныеПоступления, ДанныеЭСФ)

	Если ЗначениеЗаполнено(ДанныеПоступления.БИН) И ЗначениеЗаполнено(ДанныеЭСФ.БИН) Тогда
		Возврат ДанныеПоступления.БИН <> ДанныеЭСФ.БИН;
	КонецЕсли;

	Возврат ДанныеПоступления.Контрагент <> ДанныеЭСФ.Контрагент;

КонецФункции

// Сортировка кандидатов по убыванию оценки и отсечение хвоста.
Функция ОтобратьЛучшие(Кандидаты, Предел)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Оценка", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Кандидат");

	Для Каждого Кандидат Из Кандидаты Цикл
		Строка = Таблица.Добавить();
		Строка.Оценка = Кандидат.Оценка;
		Строка.Кандидат = Кандидат;
	КонецЦикла;

	Таблица.Сортировать("Оценка Убыв");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Результат.Количество() >= Предел Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Строка.Кандидат);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АбсЗначение(Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

#КонецОбласти
