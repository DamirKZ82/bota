///////////////////////////////////////////////////////////////////////////////
// БотаОбменСОркестратором: HTTP-сервис и обратный поллинг (A.0.1, A.0.2).
//
// Два транспорта, один формат. В прямом режиме оркестратор вызывает сервис
// расширения; в обратном фоновое задание само забирает задачи из очереди
// оркестратора. Тело задачи и тело HTTP-запроса — один и тот же конверт, поэтому
// обработчик инструментов у них общий.
//
// Проверки запроса идут в строгом порядке: токен, метка времени, подпись, имя
// инструмента, права. Метка времени проверяется до подписи не случайно — иначе
// перехваченный вчерашний запрос с валидной подписью прошёл бы снова.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработка POST /hs/bota/v1/tools/{tool} — точка входа HTTP-сервиса.
//
// Вызывается из модуля HTTP-сервиса «Бота»:
//
//   Функция toolsPOST(Запрос)
//       Возврат БотаОбменСОркестратором.ОбработатьЗапросИнструмента(Запрос);
//   КонецФункции
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет - конверт ToolResponse (A.0.2).
//
Функция ОбработатьЗапросИнструмента(Запрос) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдентификаторЗапроса = ЗаголовокЗапроса(Запрос, "X-Bota-Request-Id");

	Попытка

		Тело = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ИмяИнструмента = Запрос.ПараметрыURL.Получить("tool");

		ПроверитьЗапрос(Запрос, Тело, ИмяИнструмента);

		Конверт = РазобратьКонверт(Тело, ИмяИнструмента);
		Результат = БотаИнструменты.Выполнить(
			Конверт.Инструмент, Конверт.Аргументы, Конверт.Контекст);

		// Маскирование — последним шагом, уже над готовым результатом: так
		// ни один инструмент не может случайно отдать наружу настоящее
		// наименование, забыв его подменить (A.0.5).
		Если Конверт.Контекст.masking Тогда
			Результат = БотаМаскирование.Замаскировать(Результат, Конверт.Контекст.session_id);
		КонецЕсли;

		Возврат УспешныйОтвет(Конверт.Инструмент, Результат, ИдентификаторЗапроса,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);

	Исключение

		Ошибка = РазобратьОшибку(ИнформацияОбОшибке());
		ЗаписатьОшибкуВЖурнал(Ошибка, ИдентификаторЗапроса);

		Возврат ОтветСОшибкой(ИмяИнструментаБезопасно(Запрос), Ошибка,
			ИдентификаторЗапроса, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);

	КонецПопытки;

КонецФункции

// Один цикл обратного поллинга: забрать задачу, выполнить, отдать результат.
//
// Вызывается регламентным заданием. Одна задача за вызов: так фоновое задание
// не зависает надолго и его легко остановить.
//
// Возвращаемое значение:
//  Булево - была ли обработана задача.
//
Функция ВыполнитьОдинЦиклПоллинга() Экспорт

	АдресОркестратора = ЗначениеКонстанты("БотаАдресОркестратора");
	Токен = ЗначениеКонстанты("БотаТокенБазы");
	ИдБазы = ЗначениеКонстанты("БотаИдентификаторБазы");

	Если ПустаяСтрока(АдресОркестратора) Или ПустаяСтрока(Токен) Тогда
		// Обмен не настроен — это не ошибка, просто расширение ещё не подключено.
		Возврат Ложь;
	КонецЕсли;

	Задача = ПолучитьЗадачу(АдресОркестратора, Токен, ИдБазы);
	Если Задача = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Ответ = ВыполнитьЗадачу(Задача);
	ОтправитьРезультат(АдресОркестратора, Токен, ИдБазы, Задача.task_id, Ответ);

	Возврат Истина;

КонецФункции

// Подпись запроса по схеме A.0.1: HMAC-SHA256 от method + path + timestamp + body.
Функция Подпись(КлючПодписи, Метод, Путь, МеткаВремени, Тело) Экспорт

	Данные = Метод + Путь + МеткаВремени + Тело;

	Хеширование = Новый ХешированиеДанных(ХешФункция.HMAC_SHA256);
	Хеширование.Ключ = ПолучитьДвоичныеДанныеИзСтроки(КлючПодписи, "UTF-8", Ложь);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Данные, "UTF-8", Ложь));

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверки запроса в порядке возрастания стоимости.
Процедура ПроверитьЗапрос(Запрос, Тело, ИмяИнструмента)

	Токен = ЗначениеКонстанты("БотаТокенБазы");
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("INTERNAL",
			"Обмен не настроен: не задан токен базы");
	КонецЕсли;

	Авторизация = ЗаголовокЗапроса(Запрос, "Authorization");
	Если СокрЛП(Авторизация) <> "Bearer " + Токен Тогда
		// Без подробностей: подсказывать, что именно не сошлось, нельзя.
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED", "Доступ запрещён");
	КонецЕсли;

	// Метка времени проверяется до подписи: иначе перехваченный вчерашний
	// запрос с валидной подписью прошёл бы повторно.
	ПроверитьМеткуВремени(ЗаголовокЗапроса(Запрос, "X-Bota-Timestamp"));

	КлючПодписи = ЗначениеКонстанты("БотаКлючПодписи");
	Если Не ПустаяСтрока(КлючПодписи) Тогда

		Ожидаемая = Подпись(КлючПодписи, "POST",
			"/hs/bota/v1/tools/" + ИмяИнструмента,
			ЗаголовокЗапроса(Запрос, "X-Bota-Timestamp"), Тело);

		Если НРег(СокрЛП(ЗаголовокЗапроса(Запрос, "X-Bota-Signature"))) <> Ожидаемая Тогда
			ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED", "Доступ запрещён");
		КонецЕсли;

	КонецЕсли;

	// apply_* по HTTP не выполняется никогда: применение изменений инициирует
	// пользователь из формы (A.9). Это второй рубеж поверх отсутствия таких
	// инструментов в реестре оркестратора.
	Если СтрНачинаетсяС(НРег(ИмяИнструмента), "apply_") Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED",
			"Применение изменений выполняется только из формы 1С по кнопке пользователя");
	КонецЕсли;

КонецПроцедуры

// Допуск на расхождение часов — пять минут (A.0.1).
Процедура ПроверитьМеткуВремени(МеткаВремени)

	Если ПустаяСтрока(МеткаВремени) Тогда
		// Подпись без метки времени бессмысленна, но если ключ не задан,
		// обмен работает в отладочном режиме — тогда и метка не обязательна.
		Если ПустаяСтрока(ЗначениеКонстанты("БотаКлючПодписи")) Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED", "Доступ запрещён");
	КонецЕсли;

	Попытка
		Миллисекунды = Число(МеткаВремени);
	Исключение
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED", "Доступ запрещён");
	КонецПопытки;

	// Универсальная дата: часовые пояса базы и оркестратора могут различаться.
	СейчасМиллисекунд = (ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1)) * 1000;
	Расхождение = СейчасМиллисекунд - Миллисекунды;

	Если ?(Расхождение < 0, -Расхождение, Расхождение) > 300000 Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("ACCESS_DENIED",
			"Запрос отклонён: расхождение часов больше допустимого");
	КонецЕсли;

КонецПроцедуры

// Разбор конверта ToolRequest (A.0.2).
Функция РазобратьКонверт(Тело, ИмяИзURL)

	Если ПустаяСтрока(Тело) Тогда
		ВызватьИсключение БотаИнструменты.БотаОшибка("BAD_ARGS", "Пустое тело запроса");
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение БотаИнструменты.БотаОшибка("BAD_ARGS",
			"Тело запроса не является корректным JSON");
	КонецПопытки;

	Инструмент = ИмяИзURL;
	Если Данные.Свойство("tool") И ЗначениеЗаполнено(Данные.tool) Тогда
		// Имя в теле и в адресе должны совпадать: расхождение означает, что
		// запрос собран неверно, и молча доверять одному из них нельзя.
		Если ЗначениеЗаполнено(ИмяИзURL) И Данные.tool <> ИмяИзURL Тогда
			ВызватьИсключение БотаИнструменты.БотаОшибка("BAD_ARGS",
				СтрШаблон("Имя инструмента в адресе (%1) не совпадает с телом запроса (%2)",
					ИмяИзURL, Данные.tool));
		КонецЕсли;
		Инструмент = Данные.tool;
	КонецЕсли;

	Аргументы = Новый Структура;
	Если Данные.Свойство("args") И ТипЗнч(Данные.args) = Тип("Структура") Тогда
		Аргументы = Данные.args;
	КонецЕсли;

	Возврат Новый Структура("Инструмент, Аргументы, Контекст",
		Инструмент, Аргументы, РазобратьКонтекст(Данные));

КонецФункции

Функция РазобратьКонтекст(Данные)

	Контекст = Новый Структура;
	Контекст.Вставить("user_id", "");
	Контекст.Вставить("session_id", "");
	Контекст.Вставить("locale", "ru");
	Контекст.Вставить("masking", Истина);

	Если Не Данные.Свойство("context") Или ТипЗнч(Данные.context) <> Тип("Структура") Тогда
		Возврат Контекст;
	КонецЕсли;

	Для Каждого Элемент Из Данные.context Цикл
		Контекст.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	// Маскирование без идентификатора сессии невозможно: псевдонимы обязаны
	// быть стабильны в пределах диалога, а привязать их не к чему.
	Если Контекст.masking И ПустаяСтрока(Контекст.session_id) Тогда
		Контекст.masking = Ложь;
	КонецЕсли;

	Возврат Контекст;

КонецФункции

Функция УспешныйОтвет(Инструмент, Результат, ИдентификаторЗапроса, Длительность)

	Конверт = Новый Структура;
	Конверт.Вставить("ok", Истина);
	Конверт.Вставить("tool", Инструмент);
	Конверт.Вставить("request_id", ИдентификаторЗапроса);
	Конверт.Вставить("duration_ms", Длительность);
	Конверт.Вставить("result", Результат);
	Конверт.Вставить("warnings", Новый Массив);

	Возврат HTTPОтвет(200, Конверт);

КонецФункции

Функция ОтветСОшибкой(Инструмент, Ошибка, ИдентификаторЗапроса, Длительность)

	Конверт = Новый Структура;
	Конверт.Вставить("ok", Ложь);
	Конверт.Вставить("tool", Инструмент);
	Конверт.Вставить("request_id", ИдентификаторЗапроса);
	Конверт.Вставить("duration_ms", Длительность);
	Конверт.Вставить("error", Новый Структура("code, message, details, retryable",
		Ошибка.Код, Ошибка.Сообщение, Новый Структура, Ошибка.Повторяемая));

	// HTTP-код отражает суть: агент читает код из тела, а инфраструктура —
	// статус ответа, и они не должны противоречить друг другу.
	Возврат HTTPОтвет(HTTPКодОшибки(Ошибка.Код), Конверт);

КонецФункции

Функция HTTPКодОшибки(КодОшибки)

	Если КодОшибки = "ACCESS_DENIED" Тогда
		Возврат 403;
	ИначеЕсли КодОшибки = "NOT_FOUND" Тогда
		Возврат 404;
	ИначеЕсли КодОшибки = "BAD_ARGS" Или КодОшибки = "PERIOD_CLOSED" Тогда
		Возврат 400;
	ИначеЕсли КодОшибки = "LOCKED" Тогда
		Возврат 409;
	ИначеЕсли КодОшибки = "TIMEOUT" Тогда
		Возврат 504;
	КонецЕсли;

	Возврат 500;

КонецФункции

Функция HTTPОтвет(КодСостояния, Тело)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ВJSON(Тело), "UTF-8");

	Возврат Ответ;

КонецФункции

Функция ВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Разбор исключения в код и сообщение.
//
// Свои ошибки помечены префиксом «BOTA|КОД|», всё остальное — непредвиденный
// сбой: наружу уходит нейтральный текст, подробности остаются в журнале.
//
Функция РазобратьОшибку(Информация)

	Текст = КраткоеПредставлениеОшибки(Информация);
	Позиция = СтрНайти(Текст, "BOTA|");

	Если Позиция > 0 Тогда

		Части = СтрРазделить(Сред(Текст, Позиция + 5), "|", Истина);
		Если Части.Количество() >= 2 Тогда
			Код = СокрЛП(Части[0]);
			Части.Удалить(0);
			Возврат Новый Структура("Код, Сообщение, Повторяемая, Подробности",
				Код, СокрЛП(СтрСоединить(Части, "|")), ПовторяемаяОшибка(Код),
				ПодробноеПредставлениеОшибки(Информация));
		КонецЕсли;

	КонецЕсли;

	Возврат Новый Структура("Код, Сообщение, Повторяемая, Подробности",
		"INTERNAL",
		"Внутренняя ошибка расширения. Подробности записаны в журнал регистрации.",
		Истина, ПодробноеПредставлениеОшибки(Информация));

КонецФункции

Функция ПовторяемаяОшибка(Код)

	Возврат Код = "TIMEOUT" Или Код = "LOCKED" Или Код = "INTERNAL";

КонецФункции

Процедура ЗаписатьОшибкуВЖурнал(Ошибка, ИдентификаторЗапроса)

	ЗаписьЖурналаРегистрации("Бота.Инструменты",
		?(Ошибка.Код = "INTERNAL", УровеньЖурналаРегистрации.Ошибка,
			УровеньЖурналаРегистрации.Предупреждение),
		, ,
		СтрШаблон("Запрос %1, код %2: %3%4%5", ИдентификаторЗапроса, Ошибка.Код,
			Ошибка.Сообщение, Символы.ПС, Ошибка.Подробности));

КонецПроцедуры

Функция ИмяИнструментаБезопасно(Запрос)

	Попытка
		Имя = Запрос.ПараметрыURL.Получить("tool");
	Исключение
		Имя = "";
	КонецПопытки;

	Возврат ?(Имя = Неопределено, "", Имя);

КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя)

	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = НРег(Имя) Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// -- обратный поллинг -------------------------------------------------------

Функция ПолучитьЗадачу(АдресОркестратора, Токен, ИдБазы)

	Соединение = НовоеСоединение(АдресОркестратора);
	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(
		СтрШаблон("/api/v1/bases/%1/tasks?wait=25", ИдБазы), ЗаголовкиОбмена(Токен));

	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		// Оркестратор недоступен — молчим: следующий цикл попробует снова.
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.КодСостояния = 204 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("Бота.Поллинг", УровеньЖурналаРегистрации.Предупреждение,
			, , СтрШаблон("Оркестратор вернул %1", Ответ.КодСостояния));
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Возврат ?(ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("task_id"),
		Данные, Неопределено);

КонецФункции

Функция ВыполнитьЗадачу(Задача)

	Попытка

		Конверт = Задача.request;
		Контекст = РазобратьКонтекст(Конверт);
		Аргументы = ?(Конверт.Свойство("args"), Конверт.args, Новый Структура);

		Результат = БотаИнструменты.Выполнить(Конверт.tool, Аргументы, Контекст);
		Если Контекст.masking Тогда
			Результат = БотаМаскирование.Замаскировать(Результат, Контекст.session_id);
		КонецЕсли;

		Ответ = Новый Структура;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("tool", Конверт.tool);
		Ответ.Вставить("result", Результат);
		Ответ.Вставить("warnings", Новый Массив);

		Возврат Ответ;

	Исключение

		Ошибка = РазобратьОшибку(ИнформацияОбОшибке());
		ЗаписатьОшибкуВЖурнал(Ошибка, Задача.task_id);

		Ответ = Новый Структура;
		Ответ.Вставить("ok", Ложь);
		Ответ.Вставить("tool", ?(Задача.request.Свойство("tool"), Задача.request.tool, ""));
		Ответ.Вставить("error", Новый Структура("code, message, details, retryable",
			Ошибка.Код, Ошибка.Сообщение, Новый Структура, Ошибка.Повторяемая));

		Возврат Ответ;

	КонецПопытки;

КонецФункции

Процедура ОтправитьРезультат(АдресОркестратора, Токен, ИдБазы, ИдЗадачи, Ответ)

	Соединение = НовоеСоединение(АдресОркестратора);
	Если Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(
		СтрШаблон("/api/v1/bases/%1/tasks/%2/result", ИдБазы, ИдЗадачи),
		ЗаголовкиОбмена(Токен));
	Запрос.УстановитьТелоИзСтроки(ВJSON(Новый Структура("response", Ответ)), "UTF-8");

	Попытка
		Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		// Результат не доставлен: оркестратор вернёт задачу в очередь по
		// истечении аренды, и она выполнится повторно.
		ЗаписьЖурналаРегистрации("Бота.Поллинг", УровеньЖурналаРегистрации.Предупреждение,
			, , СтрШаблон("Не удалось отправить результат задачи %1", ИдЗадачи));
	КонецПопытки;

КонецПроцедуры

Функция НовоеСоединение(АдресОркестратора)

	Попытка

		URI = СтруктураURI(АдресОркестратора);
		Защищённое = НРег(URI.Схема) = "https";

		Возврат Новый HTTPСоединение(URI.Хост, URI.Порт, , , ,
			60, ?(Защищённое, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));

	Исключение
		ЗаписьЖурналаРегистрации("Бота.Поллинг", УровеньЖурналаРегистрации.Ошибка,
			, , СтрШаблон("Неверный адрес оркестратора: %1", АдресОркестратора));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ЗаголовкиОбмена(Токен)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Возврат Заголовки;

КонецФункции

Функция ЗначениеКонстанты(ИмяКонстанты)

	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Константы[ИмяКонстанты].Получить();

	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), "");

КонецФункции

#КонецОбласти
