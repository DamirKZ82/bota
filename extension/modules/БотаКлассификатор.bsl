///////////////////////////////////////////////////////////////////////////////
// БотаКлассификатор: коды расхождений D01–D16 (ТЗ п. 4.5).
//
// Сводит воедино работу остальных модулей: берёт пару, сопоставляет строки,
// определяет паттерн округления и выдаёт готовые карточки расхождений.
//
// Одна пара может дать несколько расхождений: например, аннулированная ЭСФ
// (D09) с расхождением НДС (D06). Поэтому функции возвращают массив, а не
// одно значение.
//
// Критичность берётся из таблицы кодов, но может быть понижена: расхождение
// сумм в пределах допуска — это D14 «инфо», а не D06 «высокая», хотя поле
// расходится в обоих случаях. Различает их только допуск.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Классифицирует расхождения одной пары «поступление ↔ ЭСФ».
//
// Параметры:
//  Пара              - Структура - см. БотаДвижокСверки.СформироватьПары
//  СтрокиПоступления - Массив из Структура
//  СтрокиЭСФ         - Массив из Структура
//  Соответствия      - Соответствие - справочник соответствий номенклатуры
//  Настройки         - Структура - допуски и параметры периода
//  ПлательщикНДС     - Булево, Неопределено - статус контрагента на дату оборота;
//                      Неопределено — проверка D15 не выполняется
//
// Возвращаемое значение:
//  Структура:
//   * Расхождения   - Массив из Структура - карточки
//   * Сопоставления - Массив из Структура - построчное сравнение
//   * Диагноз       - Структура - паттерн, объяснение, уверенность
//
Функция КлассифицироватьПару(Пара, СтрокиПоступления, СтрокиЭСФ, Соответствия,
	Настройки, ПлательщикНДС = Неопределено) Экспорт

	Поступление = Пара.Поступление;
	ЭСФ = Пара.ЭСФ;

	Сопоставления = БотаСопоставлениеСтрок.Сопоставить(
		СтрокиПоступления, СтрокиЭСФ, Соответствия, Настройки);

	Диагноз = БотаПаттерныОкругления.Определить(
		Поступление, ЭСФ, Сопоставления, СтрокиПоступления, СтрокиЭСФ, Настройки);

	Расхождения = Новый Массив;

	// Порядок проверок — от состояния документов к суммам и строкам.
	// Аннулированная ЭСФ важнее расхождения копеек: пока она не заменена,
	// зачёт не подтверждён вовсе.
	ПроверитьСостояниеЭСФ(Расхождения, Пара);
	ПроверитьПериодНДС(Расхождения, Пара, Настройки);
	ПроверитьСтатусПлательщика(Расхождения, Пара, ПлательщикНДС);
	ПроверитьВидСвязи(Расхождения, Пара);
	ПроверитьСтавки(Расхождения, Пара, СтрокиПоступления, СтрокиЭСФ);
	ПроверитьСуммы(Расхождения, Пара, Диагноз, Настройки);
	ПроверитьСтроки(Расхождения, Пара, Сопоставления, Диагноз);

	Возврат Новый Структура("Расхождения, Сопоставления, Диагноз",
		Расхождения, Сопоставления, Диагноз);

КонецФункции

// Расхождение для поступления, у которого нет ЭСФ (коды D01, D02).
//
// Различает их срок выписки: пока он не истёк, отсутствие ЭСФ — это норма
// и повод подождать, а не искать ошибку.
//
Функция ПоступлениеБезЭСФ(ДанныеПоступления, Настройки) Экспорт

	ХвостДней = ?(Настройки.Свойство("ХвостПериодаДней"), Настройки.ХвостПериодаДней, 20);
	СрокВыписки = НачалоДня(ДанныеПоступления.Дата) + ХвостДней * 86400;
	СрокИстёк = ТекущаяДатаСеанса() > СрокВыписки;

	Если СрокИстёк Тогда
		Объяснение = СтрШаблон(
			"Поступление от %1 на %2 ₸, ЭСФ не найдена."
			+ " Срок выписки (%3 дней, до %4) истёк — запросите счёт-фактуру"
			+ " у поставщика: без неё нет права на зачёт НДС %5 ₸.",
			Формат(ДанныеПоступления.Дата, "ДЛФ=D"),
			Сумма(ДанныеПоступления.СуммаСНДС), ХвостДней,
			Формат(СрокВыписки, "ДЛФ=D"), Сумма(ДанныеПоступления.СуммаНДС));
	Иначе
		Объяснение = СтрШаблон(
			"Поступление от %1 на %2 ₸, ЭСФ пока не найдена."
			+ " Срок выписки истекает %3 — это ещё не нарушение.",
			Формат(ДанныеПоступления.Дата, "ДЛФ=D"),
			Сумма(ДанныеПоступления.СуммаСНДС), Формат(СрокВыписки, "ДЛФ=D"));
	КонецЕсли;

	Возврат НовоеРасхождение(
		?(СрокИстёк, "D02", "D01"),
		ДанныеПоступления, Неопределено, Неопределено, Объяснение,
		ДанныеПоступления.СуммаНДС);

КонецФункции

// Расхождение для ЭСФ без поступления (код D03).
Функция ЭСФБезПоступления(ДанныеЭСФ) Экспорт

	ДатаОборота = ?(ЗначениеЗаполнено(ДанныеЭСФ.ДатаОборота),
		ДанныеЭСФ.ДатаОборота, ДанныеЭСФ.Дата);

	Объяснение = СтрШаблон(
		"ЭСФ %1 от %2 на %3 ₸ (НДС %4 ₸), дата оборота %5."
		+ " Поступление в базе не найдено ни по явной связи, ни по контрагенту,"
		+ " сумме и дате. Товар получен, а документ не заведён — либо ЭСФ"
		+ " выписана ошибочно.",
		ДанныеЭСФ.Номер, Формат(ДанныеЭСФ.Дата, "ДЛФ=D"),
		Сумма(ДанныеЭСФ.СуммаСНДС), Сумма(ДанныеЭСФ.СуммаНДС),
		Формат(ДатаОборота, "ДЛФ=D"));

	Возврат НовоеРасхождение("D03", Неопределено, ДанныеЭСФ, Неопределено,
		Объяснение, ДанныеЭСФ.СуммаНДС);

КонецФункции

// Расхождение для непроведённого поступления (код D16).
Функция ПоступлениеНеПроведено(ДанныеПоступления) Экспорт

	Объяснение = СтрШаблон(
		"Поступление от %1 на %2 ₸ не проведено, поэтому в сверке и в оборотах"
		+ " по НДС оно не участвует. Проверьте документ и проведите его.",
		Формат(ДанныеПоступления.Дата, "ДЛФ=D"), Сумма(ДанныеПоступления.СуммаСНДС));

	Возврат НовоеРасхождение("D16", ДанныеПоступления, Неопределено, Неопределено,
		Объяснение, 0);

КонецФункции

// Устойчивый идентификатор расхождения (Приложение А, A.0.4).
//
// Считается от содержимого, а не от порядка обработки: повторный расчёт того
// же периода без изменений обязан дать те же идентификаторы, иначе пометки
// «рассмотрено» слетят после каждого пересчёта.
//
Функция ИдентификаторРасхождения(ИдБазы, Период, Поступление, ЭСФ, Код, КлючСтроки = "") Экспорт

	Составляющие = Новый Массив;
	Составляющие.Добавить(ИдБазы);
	Составляющие.Добавить(Период);
	Составляющие.Добавить(?(Поступление = Неопределено, "", Строка(Поступление)));
	Составляющие.Добавить(?(ЭСФ = Неопределено, "", Строка(ЭСФ)));
	Составляющие.Добавить(Код);
	Составляющие.Добавить(КлючСтроки);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(СтрСоединить(Составляющие, "|"));

	Возврат НРег(Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма), 16));

КонецФункции

// Критичность кода по умолчанию (ТЗ п. 4.5).
Функция КритичностьКода(Код) Экспорт

	Если Код = "D02" Или Код = "D03" Или Код = "D05" Или Код = "D06"
		Или Код = "D07" Или Код = "D08" Или Код = "D09" Или Код = "D15" Тогда
		Возврат "high";
	ИначеЕсли Код = "D04" Или Код = "D10" Или Код = "D11" Или Код = "D12"
		Или Код = "D16" Тогда
		Возврат "medium";
	ИначеЕсли Код = "D13" Тогда
		Возврат "low";
	КонецЕсли;

	Возврат "info";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// D09, D10: аннулированная, отозванная или исправленная ЭСФ.
Процедура ПроверитьСостояниеЭСФ(Расхождения, Пара)

	ЭСФ = Пара.ЭСФ;
	Представление = НРег(СокрЛП(Строка(ЭСФ.Статус)));

	Если СтрНайти(Представление, "аннулир") > 0 Или СтрНайти(Представление, "отозв") > 0 Тогда

		Объяснение = СтрШаблон(
			"ЭСФ %1 от %2 имеет статус «%3», а поступление проведено и НДС %4 ₸"
			+ " принят к зачёту. Пока поставщик не выпишет новую ЭСФ,"
			+ " зачёт по этой поставке не подтверждён.",
			ЭСФ.Номер, Формат(ЭСФ.Дата, "ДЛФ=D"), Строка(ЭСФ.Статус),
			Сумма(Пара.Поступление.СуммаНДС));

		Расхождения.Добавить(НовоеРасхождение("D09", Пара.Поступление, ЭСФ,
			Неопределено, Объяснение, Пара.Поступление.СуммаНДС));

	КонецЕсли;

	// Замещённые ЭСФ собирает движок пар: если их несколько, поступление могло
	// быть проведено по старой версии счёта-фактуры.
	Если Пара.ЗамещённыеЭСФ.Количество() > 0 Тогда

		Объяснение = СтрШаблон(
			"По поступлению от %1 выписано несколько ЭСФ: действующей считается"
			+ " %2 от %3, замещено документов — %4. Проверьте, что суммы"
			+ " поступления соответствуют действующей ЭСФ, а не первоначальной.",
			Формат(Пара.Поступление.Дата, "ДЛФ=D"), ЭСФ.Номер,
			Формат(ЭСФ.Дата, "ДЛФ=D"), Пара.ЗамещённыеЭСФ.Количество());

		Расхождения.Добавить(НовоеРасхождение("D10", Пара.Поступление, ЭСФ,
			Неопределено, Объяснение, 0));

	КонецЕсли;

КонецПроцедуры

// D08: дата оборота ЭСФ попадает в другой период НДС.
//
// Самый дорогой по последствиям код: НДС уедет в другой квартал декларации,
// и расхождение вскроется уже при сдаче ФНО 300.00.
//
Процедура ПроверитьПериодНДС(Расхождения, Пара, Настройки)

	ДатаОборота = ?(ЗначениеЗаполнено(Пара.ЭСФ.ДатаОборота),
		Пара.ЭСФ.ДатаОборота, Пара.ЭСФ.Дата);
	ДатаПоступления = Пара.Поступление.Дата;

	Если КварталДаты(ДатаОборота) = КварталДаты(ДатаПоступления) Тогда
		Возврат;
	КонецЕсли;

	Объяснение = СтрШаблон(
		"Поступление оформлено %1, а дата оборота ЭСФ — %2: это разные кварталы"
		+ " НДС (%3 и %4). НДС %5 ₸ попадёт в декларацию не того периода."
		+ " Проверьте, какая дата верна.",
		Формат(ДатаПоступления, "ДЛФ=D"), Формат(ДатаОборота, "ДЛФ=D"),
		КварталДаты(ДатаПоступления), КварталДаты(ДатаОборота),
		Сумма(Пара.ЭСФ.СуммаНДС));

	Расхождения.Добавить(НовоеРасхождение("D08", Пара.Поступление, Пара.ЭСФ,
		Неопределено, Объяснение, Пара.ЭСФ.СуммаНДС));

КонецПроцедуры

// D15: контрагент не плательщик НДС на дату оборота.
Процедура ПроверитьСтатусПлательщика(Расхождения, Пара, ПлательщикНДС)

	Если ПлательщикНДС = Неопределено Или ПлательщикНДС Тогда
		Возврат;
	КонецЕсли;

	ДатаОборота = ?(ЗначениеЗаполнено(Пара.ЭСФ.ДатаОборота),
		Пара.ЭСФ.ДатаОборота, Пара.ЭСФ.Дата);

	Объяснение = СтрШаблон(
		"На дату оборота %1 контрагент «%2» не числится плательщиком НДС."
		+ " Зачёт %3 ₸ по этой поставке под вопросом: проверьте свидетельство"
		+ " и дату снятия с учёта.",
		Формат(ДатаОборота, "ДЛФ=D"), Строка(Пара.Поступление.Контрагент),
		Сумма(Пара.Поступление.СуммаНДС));

	Расхождения.Добавить(НовоеРасхождение("D15", Пара.Поступление, Пара.ЭСФ,
		Неопределено, Объяснение, Пара.Поступление.СуммаНДС));

КонецПроцедуры

// D04: связь предполагается, но не установлена.
Процедура ПроверитьВидСвязи(Расхождения, Пара)

	Если Пара.ВидСвязи <> "suggested" Тогда
		Возврат;
	КонецЕсли;

	Объяснение = СтрШаблон(
		"Поступление от %1 и ЭСФ %2 от %3 не связаны в базе, но совпадают"
		+ " по контрагенту, сумме и дате (оценка совпадения %4)."
		+ " Похоже на одну и ту же поставку — подтвердите связь.",
		Формат(Пара.Поступление.Дата, "ДЛФ=D"), Пара.ЭСФ.Номер,
		Формат(Пара.ЭСФ.Дата, "ДЛФ=D"), Формат(Пара.Оценка, "ЧДЦ=2"));

	Расхождения.Добавить(НовоеРасхождение("D04", Пара.Поступление, Пара.ЭСФ,
		Неопределено, Объяснение, 0));

КонецПроцедуры

// D05: разные ставки НДС.
Процедура ПроверитьСтавки(Расхождения, Пара, СтрокиПоступления, СтрокиЭСФ)

	СтавкиПоступления = НаборСтавок(СтрокиПоступления);
	СтавкиЭСФ = НаборСтавок(СтрокиЭСФ);

	Если СтавкиПоступления = СтавкиЭСФ Тогда
		Возврат;
	КонецЕсли;

	Объяснение = СтрШаблон(
		"Ставки НДС различаются: в поступлении %1, в ЭСФ %2."
		+ " Это меняет сумму налога к зачёту, а не только оформление.",
		СтавкиПоступления, СтавкиЭСФ);

	Расхождения.Добавить(НовоеРасхождение("D05", Пара.Поступление, Пара.ЭСФ,
		Неопределено, Объяснение, АбсЗначение(Пара.Поступление.СуммаНДС - Пара.ЭСФ.СуммаНДС)));

КонецПроцедуры

// D06, D07, D14: расхождение сумм и его величина относительно допуска.
Процедура ПроверитьСуммы(Расхождения, Пара, Диагноз, Настройки)

	РазницаБезНДС = Пара.Поступление.СуммаБезНДС - Пара.ЭСФ.СуммаБезНДС;
	РазницаНДС = Пара.Поступление.СуммаНДС - Пара.ЭСФ.СуммаНДС;

	Если РазницаБезНДС = 0 И РазницаНДС = 0 Тогда
		Возврат;
	КонецЕсли;

	Допуск = ДопускДокумента(Пара.Поступление, Настройки);

	// В допуске — это D14: не ошибка, а объяснение хвоста в декларации.
	// Величина разницы решает, а не сам факт несовпадения.
	Если АбсЗначение(РазницаБезНДС) <= Допуск И АбсЗначение(РазницаНДС) <= Допуск Тогда
		Расхождения.Добавить(НовоеРасхождение("D14", Пара.Поступление, Пара.ЭСФ,
			Диагноз.Паттерн, Диагноз.Объяснение, АбсЗначение(РазницаНДС)));
		Возврат;
	КонецЕсли;

	Если АбсЗначение(РазницаНДС) > Допуск Тогда
		Расхождения.Добавить(НовоеРасхождение("D06", Пара.Поступление, Пара.ЭСФ,
			Диагноз.Паттерн, Диагноз.Объяснение, АбсЗначение(РазницаНДС)));
	КонецЕсли;

	Если АбсЗначение(РазницаБезНДС) > Допуск Тогда
		Расхождения.Добавить(НовоеРасхождение("D07", Пара.Поступление, Пара.ЭСФ,
			Диагноз.Паттерн, Диагноз.Объяснение, 0));
	КонецЕсли;

КонецПроцедуры

// D11, D12, D13: расхождения на уровне строк.
Процедура ПроверитьСтроки(Расхождения, Пара, Сопоставления, Диагноз)

	ИтогиСовпадают = Пара.Поступление.СуммаБезНДС = Пара.ЭСФ.СуммаБезНДС
		И Пара.Поступление.СуммаНДС = Пара.ЭСФ.СуммаНДС;

	ЕстьОдносторонние = Ложь;
	ЕстьРасхождениеСтрок = Ложь;
	РазныеЕдиницы = Новый Массив;

	Для Каждого Сопоставление Из Сопоставления Цикл

		Если Сопоставление.Вид = "only_in_receipt" Или Сопоставление.Вид = "only_in_esf" Тогда
			ЕстьОдносторонние = Истина;
			Продолжить;
		КонецЕсли;

		Если Сопоставление.Вид = "matched_with_diff" Тогда
			ЕстьРасхождениеСтрок = Истина;
		КонецЕсли;

		Если Сопоставление.СтрокаПоступления <> Неопределено
			И Сопоставление.СтрокиЭСФ.Количество() = 1 Тогда
			ЕдиницаПоступления = СокрЛП(Строка(Сопоставление.СтрокаПоступления.Единица));
			ЕдиницаЭСФ = СокрЛП(Строка(Сопоставление.СтрокиЭСФ[0].Единица));
			Если ЗначениеЗаполнено(ЕдиницаПоступления) И ЗначениеЗаполнено(ЕдиницаЭСФ)
				И НРег(ЕдиницаПоступления) <> НРег(ЕдиницаЭСФ) Тогда
				РазныеЕдиницы.Добавить(Сопоставление);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если ЕстьОдносторонние Тогда
		Расхождения.Добавить(НовоеРасхождение("D12", Пара.Поступление, Пара.ЭСФ,
			Неопределено,
			"Часть строк есть только в одном из документов: состав поставки"
			+ " в поступлении и в ЭСФ различается.", 0));
	КонецЕсли;

	// D11 — именно про случай, когда итоги сошлись, а строки нет: сумма верна,
	// но детализация расходится, и в декларации это не видно.
	Если ЕстьРасхождениеСтрок И ИтогиСовпадают Тогда
		Расхождения.Добавить(НовоеРасхождение("D11", Пара.Поступление, Пара.ЭСФ,
			Диагноз.Паттерн,
			"Итоговые суммы документов совпадают, но отдельные строки"
			+ " расходятся по количеству, цене или сумме.", 0));
	КонецЕсли;

	Если РазныеЕдиницы.Количество() > 0 Тогда
		Первое = РазныеЕдиницы[0];
		Расхождения.Добавить(НовоеРасхождение("D13", Пара.Поступление, Пара.ЭСФ,
			Неопределено,
			СтрШаблон(
				"Единицы измерения различаются, например в строке %1 «%2»:"
				+ " в поступлении «%3», в ЭСФ «%4». Всего таких строк: %5.",
				Первое.СтрокаПоступления.Номер, Первое.СтрокаПоступления.Наименование,
				Строка(Первое.СтрокаПоступления.Единица),
				Строка(Первое.СтрокиЭСФ[0].Единица), РазныеЕдиницы.Количество()),
			0));
	КонецЕсли;

КонецПроцедуры

Функция НовоеРасхождение(Код, Поступление, ЭСФ, Паттерн, Объяснение, ВлияниеНДС)

	Расхождение = Новый Структура;
	Расхождение.Вставить("Код", Код);
	Расхождение.Вставить("Критичность", КритичностьКода(Код));
	Расхождение.Вставить("Паттерн", Паттерн);
	Расхождение.Вставить("Поступление", Поступление);
	Расхождение.Вставить("ЭСФ", ЭСФ);
	Расхождение.Вставить("Объяснение", Объяснение);
	Расхождение.Вставить("ВлияниеНДС", ВлияниеНДС);

	Возврат Расхождение;

КонецФункции

// Набор ставок документа строкой: «16», «16, 0», «без НДС».
Функция НаборСтавок(Строки)

	Ставки = Новый Массив;

	Для Каждого Строка Из Строки Цикл
		Представление = СокрЛП(Строка(Строка.СтавкаНДС));
		Если ПустаяСтрока(Представление) Тогда
			Продолжить;
		КонецЕсли;
		Если Ставки.Найти(Представление) = Неопределено Тогда
			Ставки.Добавить(Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Ставки.Количество() = 0, "не указана", СтрСоединить(Ставки, ", "));

КонецФункции

Функция КварталДаты(Дата)

	Возврат СтрШаблон("%1 кв. %2", Цел((Месяц(Дата) - 1) / 3) + 1, Год(Дата));

КонецФункции

Функция ДопускДокумента(Поступление, Настройки)

	НаСтроку = ?(Настройки.Свойство("ДопускНаСтроку"), Настройки.ДопускНаСтроку, 0.01);
	Потолок = ?(Настройки.Свойство("ПотолокДокумента"), Настройки.ПотолокДокумента, 5);

	Возврат Мин(НаСтроку * Макс(Поступление.ЧислоСтрок, 1), Потолок);

КонецФункции

Функция Сумма(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРГ=' '");

КонецФункции

Функция АбсЗначение(Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

#КонецОбласти
