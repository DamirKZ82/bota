///////////////////////////////////////////////////////////////////////////////
// БотаМаскирование: псевдонимы вместо наименований (Приложение А, A.0.5).
//
// Граница ответственности проходит здесь. Оркестратор псевдонимов не знает
// вовсе: в его базе нет ни одного наименования клиента, ни в открытом виде,
// ни в зашифрованном. Таблица соответствий живёт в 1С и используется формой
// для обратной подстановки.
//
// Псевдонимы стабильны в пределах сессии диалога. Это не удобство, а условие
// правильности: получи один контрагент разные псевдонимы в двух вызовах,
// модель решит, что это разные контрагенты, и ответ будет неверным.
//
// Не маскируются суммы, даты, ставки, коды и навигационные ссылки: на суммах
// держится вся сверка, а ссылки в модель не уходят.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заменяет наименования псевдонимами во всём ответе инструмента.
//
// Обход рекурсивный: структура ответа у каждого инструмента своя, и
// перечислять поля по одному — верный способ однажды забыть новое.
//
// Параметры:
//  Значение  - Произвольный - результат инструмента
//  СессияId  - Строка - идентификатор диалога, ключ таблицы псевдонимов
//
// Возвращаемое значение:
//  Произвольный - значение с подменёнными наименованиями.
//
Функция Замаскировать(Значение, СессияId) Экспорт

	Если ПустаяСтрока(СессияId) Тогда
		// Без сессии стабильность псевдонимов не обеспечить, а нестабильные
		// хуже их отсутствия: модель примет один объект за несколько.
		Возврат Значение;
	КонецЕсли;

	Кэш = ПрочитатьПсевдонимы(СессияId);

	Возврат ОбойтиИЗаменить(Значение, СессияId, Кэш, "");

КонецФункции

// Возвращает реальное значение по псевдониму.
//
// Используется формой «Агент» при показе ответа пользователю: бухгалтер должен
// видеть настоящие наименования, а не «Контрагент-A1».
//
Функция Раскрыть(Текст, СессияId) Экспорт

	Если ПустаяСтрока(Текст) Или ПустаяСтрока(СессияId) Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = Текст;

	// Сначала длинные псевдонимы: иначе «Контрагент-A1» подменится частью
	// «Контрагент-A12», разорвав его пополам.
	Для Каждого Элемент Из ПсевдонимыПоУбываниюДлины(СессияId) Цикл
		Результат = СтрЗаменить(Результат, Элемент.Псевдоним, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Удаляет псевдонимы сессии.
//
// Вызывается при закрытии диалога: чем меньше живёт расшифровка, тем лучше.
//
Процедура ОчиститьСессию(СессияId) Экспорт

	Если Метаданные.РегистрыСведений.Найти("БотаПсевдонимы") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.БотаПсевдонимы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СессияId.Установить(СессияId);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поля, значение которых подменяется, и префикс псевдонима.
//
// Ключ — имя поля в ответе инструмента (Приложение А), значение — вид
// псевдонима. Поля с суммами, датами и кодами сюда не входят намеренно.
//
Функция ПравилаЗамены()

	Правила = Новый Соответствие;

	Правила.Вставить("presentation", "Контрагент");
	Правила.Вставить("name", "Контрагент");
	Правила.Вставить("bin", "БИН");
	Правила.Вставить("counterparty_bin", "БИН");
	Правила.Вставить("reg_number", "ЭСФ");
	Правила.Вставить("number", "Номер");
	Правила.Вставить("esf_name", "Номенклатура");

	Возврат Правила;

КонецФункции

// Поля, которые не маскируются, даже если попали под правило по имени.
Функция ИсключенияЗамены()

	Исключения = Новый Соответствие;

	Исключения.Вставить("nav", Истина);
	Исключения.Вставить("uuid", Истина);
	Исключения.Вставить("type", Истина);
	Исключения.Вставить("code", Истина);
	Исключения.Вставить("severity", Истина);
	Исключения.Вставить("status", Истина);
	Исключения.Вставить("pattern", Истина);
	Исключения.Вставить("confidence", Истина);

	Возврат Исключения;

КонецФункции

Функция ОбойтиИЗаменить(Значение, СессияId, Кэш, ИмяПоля)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Структура") Тогда

		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ,
				ОбойтиИЗаменить(Элемент.Значение, СессияId, Кэш, Элемент.Ключ));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли ТипЗначения = Тип("Массив") Тогда

		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ОбойтиИЗаменить(Элемент, СессияId, Кэш, ИмяПоля));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли ТипЗначения = Тип("Строка") Тогда

		Возврат ЗаменитьСтроку(Значение, СессияId, Кэш, ИмяПоля);

	КонецЕсли;

	// Числа, даты, булево — не трогаем: на них держится смысл сверки.
	Возврат Значение;

КонецФункции

Функция ЗаменитьСтроку(Значение, СессияId, Кэш, ИмяПоля)

	Если ПустаяСтрока(Значение) Или ИсключенияЗамены().Получить(ИмяПоля) = Истина Тогда
		Возврат Значение;
	КонецЕсли;

	Вид = ПравилаЗамены().Получить(ИмяПоля);
	Если Вид = Неопределено Тогда
		// Поле не под правилом — но в свободном тексте (объяснение причины,
		// краткое описание) наименования тоже встречаются, и оставлять их
		// нельзя: маскирование обошли бы через explanation.
		Возврат ЗаменитьВСвободномТексте(Значение, Кэш);
	КонецЕсли;

	Возврат ПолучитьПсевдоним(Значение, Вид, СессияId, Кэш);

КонецФункции

// Подменяет в свободном тексте те значения, для которых псевдоним уже выдан.
Функция ЗаменитьВСвободномТексте(Текст, Кэш)

	Результат = Текст;

	Для Каждого Элемент Из Кэш.ПоЗначению Цикл
		Если СтрНайти(Результат, Элемент.Ключ) > 0 Тогда
			Результат = СтрЗаменить(Результат, Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Псевдоним для значения: из кэша или новый.
Функция ПолучитьПсевдоним(Значение, Вид, СессияId, Кэш)

	Существующий = Кэш.ПоЗначению.Получить(Значение);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;

	Счётчик = Кэш.Счётчики.Получить(Вид);
	Счётчик = ?(Счётчик = Неопределено, 1, Счётчик + 1);
	Кэш.Счётчики.Вставить(Вид, Счётчик);

	Псевдоним = СтрШаблон("%1-%2%3", Вид, ПрефиксВида(Вид), Счётчик);

	Кэш.ПоЗначению.Вставить(Значение, Псевдоним);
	ЗаписатьПсевдоним(СессияId, Псевдоним, Вид, Значение);

	Возврат Псевдоним;

КонецФункции

// Буква в псевдониме: «Контрагент-A1», «Номенклатура-N17» (A.0.5).
Функция ПрефиксВида(Вид)

	Если Вид = "Контрагент" Тогда
		Возврат "A";
	ИначеЕсли Вид = "Номенклатура" Тогда
		Возврат "N";
	ИначеЕсли Вид = "ЭСФ" Тогда
		Возврат "E";
	ИначеЕсли Вид = "БИН" Тогда
		Возврат "B";
	КонецЕсли;

	Возврат "X";

КонецФункции

Функция ПрочитатьПсевдонимы(СессияId)

	Кэш = Новый Структура;
	Кэш.Вставить("ПоЗначению", Новый Соответствие);
	Кэш.Вставить("Счётчики", Новый Соответствие);

	Если Метаданные.РегистрыСведений.Найти("БотаПсевдонимы") = Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Псевдонимы.Псевдоним КАК Псевдоним,
		|	Псевдонимы.Вид КАК Вид,
		|	Псевдонимы.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.БотаПсевдонимы КАК Псевдонимы
		|ГДЕ
		|	Псевдонимы.СессияId = &СессияId";
	Запрос.УстановитьПараметр("СессияId", СессияId);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Кэш.ПоЗначению.Вставить(Выборка.Значение, Выборка.Псевдоним);

		// Счётчик восстанавливается по номеру в псевдониме: нумерация должна
		// продолжиться, а не начаться заново после перезапуска сеанса.
		Номер = НомерПсевдонима(Выборка.Псевдоним);
		Текущий = Кэш.Счётчики.Получить(Выборка.Вид);
		Если Текущий = Неопределено Или Номер > Текущий Тогда
			Кэш.Счётчики.Вставить(Выборка.Вид, Номер);
		КонецЕсли;

	КонецЦикла;

	Возврат Кэш;

КонецФункции

Функция НомерПсевдонима(Псевдоним)

	Цифры = "";
	Для Индекс = 1 По СтрДлина(Псевдоним) Цикл
		Символ = Сред(Псевдоним, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Цифры), 0, Число(Цифры));

КонецФункции

Процедура ЗаписатьПсевдоним(СессияId, Псевдоним, Вид, Значение)

	Если Метаданные.РегистрыСведений.Найти("БотаПсевдонимы") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.БотаПсевдонимы.СоздатьМенеджерЗаписи();
	Запись.СессияId = СессияId;
	Запись.Псевдоним = Псевдоним;
	Запись.Вид = Вид;
	Запись.Значение = Лев(Значение, 500);
	Запись.Записать();

КонецПроцедуры

Функция ПсевдонимыПоУбываниюДлины(СессияId)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Псевдоним", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Длина", Новый ОписаниеТипов("Число"));

	Если Метаданные.РегистрыСведений.Найти("БотаПсевдонимы") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Псевдонимы.Псевдоним КАК Псевдоним,
		|	Псевдонимы.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.БотаПсевдонимы КАК Псевдонимы
		|ГДЕ
		|	Псевдонимы.СессияId = &СессияId";
	Запрос.УстановитьПараметр("СессияId", СессияId);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		Строка.Псевдоним = Выборка.Псевдоним;
		Строка.Значение = Выборка.Значение;
		Строка.Длина = СтрДлина(Выборка.Псевдоним);
	КонецЦикла;

	Таблица.Сортировать("Длина Убыв");

	Возврат Таблица;

КонецФункции

#КонецОбласти
