# --- LLM ---
# Провайдер: anthropic | local (см. orchestrator/llm/)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
LLM_MAX_TOKENS=16000

# --- Транспорт до 1С ---
# mock    — разработка: без базы 1С и без Postgres, диалоги в памяти
# polling — рабочий режим для файловых баз и баз за NAT (очередь в Postgres)
# direct  — рабочий режим для серверных баз с доступным адресом
TRANSPORT=mock

# --- База данных (нужна для transport=polling|direct) ---
DATABASE_URL=postgresql://bota:bota@localhost:5432/bota

# Ключ шифрования словаря псевдонимов и ключей подписи баз.
# Сгенерировать: openssl rand -base64 32
# При смене ключа ранее сохранённые псевдонимы становятся нечитаемыми.
ENCRYPTION_KEY=

# Отдельная база для тестов: они пересоздают схему целиком, поэтому на рабочую
# базу их направлять нельзя. Без этой переменной тесты БД пропускаются.
BOTA_TEST_DSN=postgresql://bota:bota@localhost:5432/bota_test

# --- Оркестратор ---
# Максимум вызовов инструментов на один запрос пользователя (ТЗ п.6.1)
MAX_TOOL_CALLS=30
# Режим маскирования по умолчанию для новых баз
MASKING_ENABLED=true
# Таймаут ожидания ответа инструмента от 1С, секунды
TOOL_TIMEOUT_SECONDS=120
# Сроки хранения (ТЗ п.8)
JOURNAL_RETENTION_MONTHS=12
DIALOG_RETENTION_DAYS=30

LOG_LEVEL=INFO
